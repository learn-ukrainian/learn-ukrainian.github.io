<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Sol PR-L example launchd job: DRY-RUN retention plan only.

  Gate 5: do NOT schedule the apply mode until the operator has
  confirmed seven days of stable dry-run plans, archive root, and restore
  drills. This example only runs `retention_engine.py plan`.

  Install (optional, operator):
    cp scripts/config/retention-plan.plist.example ~/Library/LaunchAgents/com.learn-ukrainian.retention-plan.plist
    # replace REPO_ROOT with the checkout path before load; the engine path is
    # relative to WorkingDirectory
    launchctl load ~/Library/LaunchAgents/com.learn-ukrainian.retention-plan.plist
-->
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.learn-ukrainian.retention-plan</string>
    <key>WorkingDirectory</key>
    <string>REPO_ROOT</string>
    <key>ProgramArguments</key>
    <array>
      <string>/bin/sh</string>
      <string>-c</string>
      <string>exec REPO_ROOT/.venv/bin/python scripts/hygiene/retention_engine.py plan</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
      <key>Hour</key>
      <integer>4</integer>
      <key>Minute</key>
      <integer>15</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>REPO_ROOT/logs/retention-plan.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>REPO_ROOT/logs/retention-plan.stderr.log</string>
    <key>RunAtLoad</key>
    <false/>
  </dict>
</plist>
