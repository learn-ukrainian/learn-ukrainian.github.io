#!/usr/bin/env bash
set -euo pipefail

_deny() {
  cat >&2 <<'EOF'
error: agent invoked with AGENT_NO_MERGE=1 cannot push directly to main.
       User reviews and merges. See INCIDENT #1403.
EOF
  exit 1
}

_real_git() {
  local shim_dir
  shim_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

  if [[ -n "${AGENT_REAL_GIT:-}" && "${AGENT_REAL_GIT:-}" != "$shim_dir/git" && "${AGENT_REAL_GIT:-}" != */scripts/agent_runtime/shims/git ]]; then
    printf '%s\n' "$AGENT_REAL_GIT"
    return 0
  fi

  local path_entry
  IFS=':' read -r -a _path_entries <<< "${AGENT_ORIGINAL_PATH:-${PATH:-}}"
  for path_entry in "${_path_entries[@]}"; do
    [[ -z "$path_entry" || "$path_entry" == "$shim_dir" || "$path_entry" == */scripts/agent_runtime/shims ]] && continue
    if [[ -x "$path_entry/git" ]]; then
      printf '%s\n' "$path_entry/git"
      return 0
    fi
  done

  return 1
}

_is_main_refspec() {
  local token="${1#+}"

  [[ "$token" == "main" || "$token" == "refs/heads/main" ]] && return 0
  [[ "$token" == *":main" || "$token" == *":refs/heads/main" ]] && return 0
  [[ "$token" == "main:"* || "$token" == "refs/heads/main:"* ]] && return 0

  return 1
}

_blocks_git_push() {
  [[ "${1:-}" == "push" ]] || return 1
  shift

  local arg
  for arg in "$@"; do
    [[ "$arg" == "--" ]] && continue
    [[ "$arg" == -* ]] && continue
    _is_main_refspec "$arg" && return 0
  done

  return 1
}

if [[ "${AGENT_NO_MERGE:-}" == "1" ]] && _blocks_git_push "$@"; then
  _deny
fi

_blocks_branch_switch() {
  local shim_dir
  shim_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  local shim_repo
  shim_repo="$(cd "$shim_dir/../../.." && pwd)"

  local real_git_bin
  real_git_bin="$(_real_git 2>/dev/null || true)"

  # The shim itself might reside in a linked worktree (e.g. .worktrees/dispatch/...)
  # Resolve the main checkout that owns the virtual environment and scripts.
  local shim_main_root="$shim_repo"
  if [[ -n "$real_git_bin" && -x "$real_git_bin" ]]; then
    local shim_common_dir
    shim_common_dir="$("$real_git_bin" -C "$shim_repo" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
    if [[ -n "$shim_common_dir" ]]; then
      shim_main_root="$(dirname "$shim_common_dir")"
    fi
  fi

  local guard_python="${AGENT_GIT_SHIM_PYTHON:-}"
  if [[ -z "$guard_python" ]]; then
    if [[ -x "$shim_main_root/.venv/bin/python" ]]; then
      guard_python="$shim_main_root/.venv/bin/python"
    elif [[ -x "$shim_repo/.venv/bin/python" ]]; then
      guard_python="$shim_repo/.venv/bin/python"
    fi
  fi

  if [[ -z "$guard_python" || ! -x "$guard_python" ]]; then
    cat >&2 <<EOF
error: git shim guard interpreter unavailable (${guard_python:-$shim_main_root/.venv/bin/python}).
       Cannot verify branch containment; failing closed.
EOF
    return 125
  fi

  local guard_status=0
  local guard_out
  guard_out="$("$guard_python" -c '
import sys
import subprocess
from pathlib import Path

# Exit codes:
#   0 with stdout "GUARD_ALLOW" = ALLOW (safe to run)
#   2 = BLOCKED (illegal branch switch in primary checkout)
# Any unhandled exception or non-zero exit code fails closed.

try:
    shim_main_root = sys.argv[1]
    git_args = sys.argv[2:]

    if shim_main_root and shim_main_root not in sys.path:
        sys.path.insert(0, shim_main_root)

    from scripts.guardrails.worktree_containment import is_primary_checkout, is_protected_branch, PROTECTED_BRANCHES

    if not (is_primary_checkout() and is_protected_branch()):
        print("GUARD_ALLOW")
        sys.exit(0)

    if not git_args:
        print("GUARD_ALLOW")
        sys.exit(0)

    cmd = git_args[0]
    if cmd not in ("checkout", "switch"):
        print("GUARD_ALLOW")
        sys.exit(0)

    creates_branch = any(arg in ("-b", "-B", "-c", "-C") for arg in git_args[1:])
    if creates_branch:
        sys.exit(2)

    target = None
    for arg in git_args[1:]:
        if arg == "--":
            break
        if not arg.startswith("-"):
            target = arg
            break

    if not target:
        print("GUARD_ALLOW")
        sys.exit(0)

    if target in PROTECTED_BRANCHES:
        print("GUARD_ALLOW")
        sys.exit(0)

    if cmd == "switch":
        if "--detach" not in git_args and "-d" not in git_args:
            sys.exit(2)
        print("GUARD_ALLOW")
        sys.exit(0)

    is_local = (subprocess.run(["git", "show-ref", "--verify", "--quiet", f"refs/heads/{target}"]).returncode == 0)
    is_remote = (subprocess.run(["git", "show-ref", "--verify", "--quiet", f"refs/remotes/origin/{target}"]).returncode == 0)

    if is_local or is_remote:
        target_idx = git_args.index(target)
        remaining_args = git_args[target_idx+1:]
        if "--" in remaining_args:
            print("GUARD_ALLOW")
            sys.exit(0)
        has_file_args = False
        for arg in remaining_args:
            if not arg.startswith("-"):
                has_file_args = True
                break
        if has_file_args:
            print("GUARD_ALLOW")
            sys.exit(0)
        sys.exit(2)

    print("GUARD_ALLOW")
    sys.exit(0)
except SystemExit:
    raise
except Exception as exc:
    print(f"error: branch containment check failed: {exc}", file=sys.stderr)
    sys.exit(3)
' "$shim_main_root" "$@")" || guard_status=$?

  if [[ "$guard_status" -ne 0 ]]; then
    return "$guard_status"
  fi

  if [[ "$guard_out" == "GUARD_ALLOW" ]]; then
    return 0
  fi

  cat >&2 <<EOF
error: git shim guard did not verify containment; failing closed.
EOF
  return 124
}

# INCIDENT 2026-07-05 (fork bomb): _blocks_branch_switch spawns a python guard whose
# worktree_containment._run_git calls bare "git" -> PATH resolves back to THIS shim ->
# guard again -> infinite bash+python chains until the per-user process limit (observed:
# ~2,200 stuck processes, machine-wide fork failures). Two independent breakers:
#   1. Bash-side pre-filter: the guard only concerns checkout/switch — never spawn the
#      python (which itself runs git) for any other subcommand.
#   2. AGENT_GIT_SHIM_GUARD_ACTIVE sentinel, FAIL-CLOSED (codex review msg 2014): the
#      guard's subtree only ever runs read-only plumbing (rev-parse/show-ref/ls-files),
#      which the pre-filter passes through. A checkout/switch arriving WITH the sentinel
#      set is therefore either recursion or spoofing — both are DENIED outright, without
#      spawning the guard python. Spoofing the sentinel strengthens the block; it cannot
#      bypass it. The push-deny above stays active regardless.
if [[ "${AGENT_NO_MERGE:-}" == "1" ]] && [[ "${1:-}" == "checkout" || "${1:-}" == "switch" ]]; then
  if [[ "${AGENT_GIT_SHIM_GUARD_ACTIVE:-}" == "1" ]]; then
    cat >&2 <<EOF
error: branch switch denied inside the containment guard's own subtree (fail-closed sentinel).
EOF
    exit 1
  fi

  guard_rc=0
  AGENT_GIT_SHIM_GUARD_ACTIVE=1 _blocks_branch_switch "$@" || guard_rc=$?

  if [[ "$guard_rc" -eq 2 ]]; then
    cat >&2 <<EOF
error: agent cannot switch branches in the primary checkout.
       Create and cd into a dispatch worktree (.worktrees/dispatch/<agent>/<task>/) before switching branches.
EOF
    exit 1
  elif [[ "$guard_rc" -ne 0 ]]; then
    if [[ "$guard_rc" -ne 125 && "$guard_rc" -ne 124 && "$guard_rc" -ne 3 ]]; then
      cat >&2 <<EOF
error: git shim guard interpreter failed to run ($guard_rc).
       Cannot verify branch containment; failing closed.
EOF
    fi
    exit 1
  fi
fi

real_git="$(_real_git)" || {
  echo "error: could not locate the real git binary behind the agent shim." >&2
  exit 127
}

# Pushes publish commit messages and ref and tag names (#9339). Git runs the
# pre-push hook on the exact ref updates it is about to send, so every push
# runs with core.hooksPath pinned to the scanner's hooks directory. As the last
# command-line assignment the pin outranks every other configuration source, and
# Git hands it to recursive submodule pushes. A push that would skip the hook, or
# whose scanner is unusable, is refused. The pin is not added to other commands:
# it would hide the caller's other hooks (pre-commit, ...).
#
# The shim forwards only Git's own commands, and only when Git has no alias of
# that name. Aliases are refused, not parsed: a reading of an alias that differs
# from Git's could reach push without the pin.

_opsec_refuse() {
  echo "OPSEC: $1; push refused." >&2
  exit 2
}

# git push accepts --no-verify and its unique abbreviations; shorter prefixes are
# ambiguous today and refused too, wherever they appear.
_opsec_skips_hook() {
  local arg name
  for arg in "$@"; do
    name="${arg%%=*}"
    if [[ ${#name} -ge 3 && "--no-verify" == "$name"* ]]; then
      return 0
    fi
  done
  return 1
}

# Global options as git.c reads them; those listed take the next argument.
_opsec_index=0
_opsec_shallow=0
_opsec_informational=0
while [[ $_opsec_index -lt $# ]]; do
  _opsec_arg="${@:_opsec_index+1:1}"
  case "$_opsec_arg" in
    -C | -c | --git-dir | --work-tree | --namespace | --config-env | --attr-source) _opsec_index=$((_opsec_index + 2)) ;;
    --shallow-file) _opsec_shallow=1 && _opsec_index=$((_opsec_index + 2)) ;;
    -h | --help | -v | --version | --exec-path | --html-path | --man-path | --info-path)
      _opsec_informational=1 && _opsec_index=$((_opsec_index + 1)) ;;
    -*) _opsec_index=$((_opsec_index + 1)) ;;
    *) break ;;
  esac
done
_opsec_globals=("${@:1:_opsec_index}")
_opsec_command="${@:_opsec_index+1:1}"
_opsec_push=0

if [[ "$_opsec_command" == "push" ]]; then
  _opsec_push=1
elif [[ -n "$_opsec_command" && "$_opsec_informational" == 0 ]]; then
  # Git's own commands are its builtins and the git-<name> programs in its exec
  # path; Git tries both before any alias. The Git that runs the command lists
  # them under the caller's global options (--exec-path, -C) and environment
  # (GIT_EXEC_PATH). Anything else (an alias, a git-<name> program elsewhere on
  # PATH, a typo Git could autocorrect) is refused before Git runs.
  _opsec_commands="$("$real_git" "${_opsec_globals[@]}" --list-cmds=builtins,main)" || {
    echo "OPSEC: could not list Git's commands, so '$_opsec_command' was not run." >&2
    exit 2
  }
  if [[ "$_opsec_command" == *$'\n'* || $'\n'"$_opsec_commands"$'\n' != *$'\n'"$_opsec_command"$'\n'* ]]; then
    cat >&2 <<EOF
OPSEC: '$_opsec_command' is not one of Git's own commands, so it was not run.
       The agent git shim refuses every alias, git-<name> programs outside Git's
       exec path and mistyped commands, because it cannot tell whether they push.
       Run the Git command directly (for example 'git push ...', not an alias for it).
EOF
    exit 2
  fi
fi

# A listed name can still run as an alias: Git looks an alias up before a
# deprecated builtin (whatchanged) and after a git-<name> program fails to
# start. So the shim asks Git whether an alias of that name is defined, under
# the caller's global options and environment, and refuses if one is, whatever
# it expands to. Git matches alias names without regard to case. The probe key
# proves Git read the configuration: a lookup that does not return it, fails
# or times out refuses. GIT_CONFIG is unset because it narrows `git config` to
# one file while Git's alias lookup ignores it. The time limit is bash's own
# read timeout (some timeout(1) builds poll and add 0.1 s to every call).
_opsec_probe="lu-opsec.alias-probe"
_opsec_aliased() {
  local fd pid names="" name rest word="${_opsec_command,,}" read_status=0 git_status=0
  exec {fd}< <(exec env -u GIT_CONFIG "$real_git" "${_opsec_globals[@]}" -c "$_opsec_probe=1" \
    config --name-only --get-regexp "^(alias\\..*|${_opsec_probe//./\\.})\$")
  pid=$!
  IFS= read -r -d '' -t 10 -u "$fd" names || read_status=$?
  exec {fd}<&-
  if [[ "$read_status" != 1 ]]; then
    # Over time (above 128), or a NUL where Git writes none (0).
    kill "$pid" 2>/dev/null || true
    return 2
  fi
  wait "$pid" || git_status=$?
  [[ "$git_status" == 0 && $'\n'"$names" == *$'\n'"$_opsec_probe"$'\n'* ]] || return 2
  while IFS= read -r name; do
    [[ "$name" == alias.* ]] || continue
    rest="${name#alias.}"
    rest="${rest,,}"
    [[ "$rest" == "$word" || "$rest" == "$word".* ]] && return 0
  done <<< "$names"
  return 1
}

if [[ -n "$_opsec_command" && "$_opsec_informational" == 0 ]]; then
  _opsec_alias_status=0
  _opsec_aliased || _opsec_alias_status=$?
  if [[ "$_opsec_alias_status" == 2 ]]; then
    echo "OPSEC: could not check Git's aliases for '$_opsec_command', so it was not run." >&2
    exit 2
  elif [[ "$_opsec_alias_status" == 0 ]]; then
    cat >&2 <<EOF
OPSEC: an alias named '$_opsec_command' is defined, so '$_opsec_command' was not run.
       Git can run such an alias in place of its own command, so the agent git
       shim refuses the command while the alias exists. Remove the alias or run
       Git without the configuration that defines it.
EOF
    exit 2
  fi
fi

if [[ "$_opsec_push" == 1 ]]; then
  if _opsec_skips_hook "${@:_opsec_index+2}"; then
    _opsec_refuse "--no-verify would skip the push scan"
  fi
  if [[ "$_opsec_shallow" == 1 ]]; then
    _opsec_refuse "--shallow-file is not supported for a scanned push"
  fi
  _opsec_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd -P)"
  _opsec_hooks="$_opsec_root/scripts/opsec/push_hooks"
  _opsec_python="$_opsec_root/.venv/bin/python"
  if [[ ! -x "$_opsec_python" ]]; then
    # A linked worktree has no interpreter of its own: use the main checkout's.
    _opsec_common="$(env -u GIT_DIR -u GIT_COMMON_DIR -u GIT_WORK_TREE "$real_git" -C "$_opsec_root" \
      rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
    _opsec_python="${_opsec_common:+$(dirname "$_opsec_common")/.venv/bin/python}"
  fi
  for _opsec_hook in pre-push reference-transaction chain; do
    [[ -f "$_opsec_hooks/$_opsec_hook" && -x "$_opsec_hooks/$_opsec_hook" ]] || _opsec_refuse "push scanner hooks unavailable"
  done
  [[ -f "$_opsec_root/scripts/opsec/git_push.py" ]] || _opsec_refuse "push scanner unavailable"
  [[ -n "$_opsec_python" && -x "$_opsec_python" ]] || _opsec_refuse "project interpreter unavailable"
  export LU_OPSEC_PUSH_PYTHON="$_opsec_python" LU_OPSEC_REAL_GIT="$real_git"
  exec "$real_git" "${_opsec_globals[@]}" -c "core.hooksPath=$_opsec_hooks" "${@:_opsec_index+1}"
fi

exec "$real_git" "$@"
