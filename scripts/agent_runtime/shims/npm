#!/usr/bin/env bash
# scripts/agent_runtime/shims/npm — product entry for the guarded npm shim (#9460, #13032).
#
# Dispatch worktrees get `node_modules` and `site/node_modules` as symlinks into
# the primary checkout, so an unguarded `npm ci` there empties the primary's
# folder. The shim and its guard (npm_guard.py) live only in the installed
# lu-machinery release, at lu_machinery/agent_runtime/shims. This file finds that
# release with the project interpreter and execs its npm shim, which keeps the
# arguments, stdin, stdout, stderr and exit code. When the interpreter or the
# release cannot be found, npm does not run.

set -euo pipefail

shim_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/lib/project_interpreter.sh
source "$shim_dir/../../lib/project_interpreter.sh"
if ! python_bin="$(project_interpreter_resolve "$(cd "$shim_dir/../../.." && pwd)")"; then
  echo "error: agent npm shim cannot find the project interpreter; refusing to run npm unguarded." >&2
  exit 127
fi
# find_spec locates the installed package without importing it.
release_shims="$("$python_bin" -I -c 'import importlib.util, os, sys
spec = importlib.util.find_spec("lu_machinery")
if spec is None or not spec.origin:
    sys.exit(1)
print(os.path.join(os.path.dirname(spec.origin), "agent_runtime", "shims"))' < /dev/null)" || release_shims=""
if [[ -z "$release_shims" || ! -f "$release_shims/npm" || ! -x "$release_shims/npm" ]]; then
  echo "error: agent npm shim cannot find the installed lu-machinery release's npm shim; refusing to run npm unguarded." >&2
  exit 127
fi
# The release shim runs its guard with the interpreter named here.
export LEARN_UKRAINIAN_PYTHON="$python_bin"
exec "$release_shims/npm" "$@"
