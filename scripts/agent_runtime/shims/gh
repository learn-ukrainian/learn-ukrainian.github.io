#!/usr/bin/env bash
# scripts/agent_runtime/shims/gh — agent shim for GitHub CLI (gh).
#
# Intercepts gh commands to:
# 1. Block prohibited PR merge/approval operations when AGENT_NO_MERGE=1 (#1403).
#    Merge stays blocked. Native `gh pr review --approve` stays blocked too:
#    with one shared GitHub identity a seat cannot approve its own authored
#    PR anyway (#7472 / critical-rules §8.6.4). Review of record is a PR
#    *comment* with VERDICT + exact head SHA + concrete resolved_model.
#    The cf-attest Gate job is retired. Merge-gate mutations
#    (enqueuePullRequest, mergePullRequest, enablePullRequestAutoMerge,
#    mergeBranch, approving reviews; matched case-folded) are refused in every
#    `gh api` input form: inline fields, `-f/-F/--raw-field/--field` values,
#    `@file`/`@-` values and `--input file|-` (#10501). A file or stdin body
#    is read whole and scanned; one the shim cannot read is refused.
#    dequeuePullRequest stays allowed: removing a queued PR never lands code.
#    The command is classified after gh's root flags (`-R/--repo`, `--help`,
#    `--version`) and `pr`'s own flags, so a leading repository selector does
#    not hide `pr merge`. Under AGENT_NO_MERGE=1 only builtin commands the
#    publishing admission can admit are classified at all: gh expands an
#    alias or an extension inside its own process, after this shim has seen
#    argv, so `alias`, `extension`, `config` and any unknown command word
#    (a user alias or extension name) are refused, as is a flag the shim
#    cannot place.
#    This guards the supported path only: a same-user process that clears
#    AGENT_NO_MERGE, calls gh directly or rewrites a scanned file afterwards
#    is not isolated by this shim.
# 2. Automatically retry operations throttled by GitHub secondary rate limits
#    (HTTP 403 / 429) using bounded exponential backoff.
#
# Raw commands use strict read/private-write admission. Public writes use
# scripts.publish.github; its frozen payloads survive the retry helper.
# Reads do not load the private matcher.

set -euo pipefail

_deny() {
  cat >&2 <<'EOF'
error: agent invoked with AGENT_NO_MERGE=1 cannot merge or approve PRs.
       User reviews and merges. See INCIDENT #1403.
       Review of record under a shared GitHub identity (#7472): post via
       `python -m scripts.publish pr-comment` a VERDICT + exact head SHA + resolved_model —
       not `gh pr review --approve`. The cf-attest Gate job is retired.
EOF
  exit 1
}

# Set when an `api` check buffered stdin; the backend then reads this copy.
_agent_gh_stdin_buffer=""

# Inline argv plus every file and stdin body an `api` call names, for scanning.
_agent_gh_scan=""

# Builtin commands the publishing admission can admit (scripts/opsec/gh_snapshot.py).
_is_classified_command() {
  case "$1" in
    api|auth|gist|help|issue|label|pr|release|repo|run|search|version|workflow) return 0 ;;
  esac
  return 1
}

_names_merge_operation() {
  # GraphQL names cannot be escaped or split, so a case-folded token match is
  # complete for raw query text (over-matching only refuses more).
  local lowered name
  lowered="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"
  for name in enqueuepullrequest mergepullrequest enablepullrequestautomerge mergebranch; do
    [[ "$lowered" == *"$name"* ]] && return 0
  done
  [[ "$lowered" == *pullrequestreview* && "$lowered" == *approve* ]]
}

_endpoint_merges() {
  local lowered
  lowered="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"
  # Percent-encoding could spell any path segment; no worker call needs it.
  [[ "$lowered" == *%* ]] && return 0
  [[ "$lowered" =~ /pulls/[^/]+/merge($|[/?#]) ]] && return 0
  [[ "$lowered" =~ (^|/)repos/[^/]+/[^/]+/merges($|[/?#]) ]] && return 0
  [[ "$lowered" =~ /pulls/[^/]+/reviews($|[/?#]) \
    && "$(printf '%s' "$_agent_gh_scan" | tr '[:upper:]' '[:lower:]')" == *approve* ]]
}

_scan_input() {
  # Append one file or stdin body to the scan; non-zero refuses the command.
  local source="$1" kind="$2" content
  if [[ "$source" == "-" ]]; then
    if [[ -z "$_agent_gh_stdin_buffer" ]]; then
      _agent_gh_stdin_buffer="$(mktemp "${TMPDIR:-/tmp}/agent-gh.stdin.XXXXXX")" || return 1
      cat >"$_agent_gh_stdin_buffer" || return 1
    fi
    source="$_agent_gh_stdin_buffer"
  fi
  # An input the shim cannot read whole is refused rather than passed unchecked.
  [[ -n "$source" && -f "$source" && -r "$source" ]] || return 1
  content="$(cat -- "$source")" || return 1
  # A JSON body (--input) may spell any character as \uXXXX; refuse escapes.
  [[ "$kind" == "json" && "$content" == *'\u'* ]] && return 1
  _agent_gh_scan+=$'\n'"$content"
}

_scan_field() {
  # `key=@path` and `key=@-` read a value from a file or stdin, for -f and -F alike.
  local value="$1"
  [[ "$value" == *=* ]] || return 0
  value="${value#*=}"
  [[ "$value" == @* ]] || return 0
  _scan_input "${value#@}" raw
}

_api_blocks() {
  # Place every `gh api` token; a flag the shim cannot place is refused.
  local token flag value letters i
  local -a endpoints=()
  _agent_gh_scan="$*"
  while (( $# )); do
    token="$1"
    shift
    case "$token" in
      --input|--raw-field|--field|--cache|--header|--hostname|--jq|--method|--preview|--template)
        (( $# )) || return 0
        flag="$token"
        value="$1"
        shift
        ;;
      --input=*|--raw-field=*|--field=*|--cache=*|--header=*|--hostname=*|--jq=*|--method=*|--preview=*|--template=*)
        flag="${token%%=*}"
        value="${token#*=}"
        ;;
      --allow-escape-sequences|--include|--paginate|--silent|--slurp|--verbose|--help)
        continue
        ;;
      --*|-)
        return 0
        ;;
      -?*)
        # A short-flag bundle: booleans, then at most one flag taking a value.
        letters="${token#-}"
        flag=""
        for (( i = 0; i < ${#letters}; i++ )); do
          case "${letters:i:1}" in
            i) ;;
            f|F|H|p|q|t|X)
              flag="-${letters:i:1}"
              value="${letters:i+1}"
              break
              ;;
            *) return 0 ;;
          esac
        done
        [[ -n "$flag" ]] || continue
        if [[ -z "$value" ]]; then
          (( $# )) || return 0
          value="$1"
          shift
        fi
        ;;
      *)
        endpoints+=("$token")
        continue
        ;;
    esac
    case "$flag" in
      --input) _scan_input "$value" json || return 0 ;;
      -f|-F|--raw-field|--field) _scan_field "$value" || return 0 ;;
    esac
  done
  _names_merge_operation "$_agent_gh_scan" && return 0
  for token in "${endpoints[@]}"; do
    _endpoint_merges "$token" && return 0
  done
  return 1
}

_review_flag_approves() {
  local token="$1" letters i
  case "$token" in
    --approve|--approve=*) return 0 ;;
    --*) return 1 ;;
    -?*)
      letters="${token#-}"
      for (( i = 0; i < ${#letters}; i++ )); do
        case "${letters:i:1}" in
          a) return 0 ;;
          # The rest of the token is that flag's value.
          b|F|R) return 1 ;;
        esac
      done
      ;;
  esac
  return 1
}

_pr_blocks() {
  # `pr` takes -R/--repo before its subcommand too.
  local token
  while (( $# )); do
    case "$1" in
      -R|--repo)
        shift
        (( $# )) || return 1
        shift
        ;;
      -R?*|--repo=*|--help) shift ;;
      -*) return 0 ;;
      *) break ;;
    esac
  done
  (( $# )) || return 1
  case "$1" in
    merge) return 0 ;;
    review)
      shift
      for token in "$@"; do
        _review_flag_approves "$token" && return 0
      done
      ;;
  esac
  return 1
}

_blocks_gh_command() {
  # Classify the command gh will run, after its root flags.
  while (( $# )); do
    case "$1" in
      -R|--repo)
        shift
        (( $# )) || return 1
        shift
        ;;
      -R?*|--repo=*|--help|--version) shift ;;
      -*) return 0 ;;
      *) break ;;
    esac
  done
  (( $# )) || return 1
  _is_classified_command "$1" || return 0
  case "$1" in
    pr) shift; _pr_blocks "$@" ;;
    api) shift; _api_blocks "$@" ;;
    *) return 1 ;;
  esac
}

_real_gh() {
  local shim_dir
  shim_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

  if [[ -n "${AGENT_REAL_GH:-}" && "${AGENT_REAL_GH:-}" != "$shim_dir/gh" && "${AGENT_REAL_GH:-}" != */scripts/agent_runtime/shims/gh ]]; then
    printf '%s\n' "$AGENT_REAL_GH"
    return 0
  fi

  local path_entry
  IFS=':' read -r -a _path_entries <<< "${AGENT_ORIGINAL_PATH:-${PATH:-}}"
  for path_entry in "${_path_entries[@]}"; do
    [[ -z "$path_entry" || "$path_entry" == "$shim_dir" || "$path_entry" == */scripts/agent_runtime/shims ]] && continue
    if [[ -x "$path_entry/gh" ]]; then
      printf '%s\n' "$path_entry/gh"
      return 0
    fi
  done

  return 1
}

_is_secondary_rate_limited() {
  local output="$1"

  # Only retry GitHub's explicit secondary-limit response.  A broad match on
  # "rate limit" would incorrectly retry provider quotas, malformed commands,
  # and ordinary GitHub failures. GitHub documents this as a 403/429 together
  # with a secondary-rate-limit message.
  printf '%s' "$output" | grep -Eiq '(HTTP|status)[[:space:]:]*(403|429)' \
    && printf '%s' "$output" | grep -Eiq 'secondary[[:space:]-]+rate[[:space:]-]+limit'
}

_secondary_rate_limit_http_status() {
  local output="$1"
  if printf '%s' "$output" | grep -Eiq '(HTTP[[:space:]]*429|status[[:space:]]*429)'; then
    printf '429\n'
  else
    printf '403\n'
  fi
}

_positive_integer_or_default() {
  local value="$1"
  local fallback="$2"
  if [[ "$value" =~ ^[0-9]+$ ]] && (( value > 0 )); then
    printf '%s\n' "$value"
  else
    printf '%s\n' "$fallback"
  fi
}

_nonnegative_integer_or_default() {
  local value="$1"
  local fallback="$2"
  if [[ "$value" =~ ^[0-9]+$ ]]; then
    printf '%s\n' "$value"
  else
    printf '%s\n' "$fallback"
  fi
}

_run_with_secondary_rate_limit_retry() {
  local real_gh="$1"
  shift

  # GitHub recommends waiting at least one minute when a secondary-limit
  # response omits Retry-After, then using exponential backoff and a bounded
  # number of retries. The env overrides make the shim deterministically
  # testable without weakening production defaults.
  local max_retries
  max_retries="$(_positive_integer_or_default "${AGENT_GH_SECONDARY_RATE_LIMIT_RETRIES:-}" 3)"
  local base_delay_s
  base_delay_s="$(_nonnegative_integer_or_default "${AGENT_GH_SECONDARY_RATE_LIMIT_BACKOFF_SECONDS:-}" 60)"

  _agent_gh_retry_sleep_pid=""
  _agent_gh_retry_stdout_file="$(mktemp "${TMPDIR:-/tmp}/agent-gh.stdout.XXXXXX")" || return 1
  _agent_gh_retry_stderr_file="$(mktemp "${TMPDIR:-/tmp}/agent-gh.stderr.XXXXXX")" || {
    rm -f "$_agent_gh_retry_stdout_file"
    return 1
  }

  _cleanup_secondary_retry_tempfiles() {
    rm -f "$_agent_gh_retry_stdout_file" "$_agent_gh_retry_stderr_file"
  }

  _abort_secondary_retry() {
    local status="$1"
    trap - EXIT HUP INT TERM
    if [[ -n "$_agent_gh_retry_sleep_pid" ]]; then
      kill "$_agent_gh_retry_sleep_pid" 2>/dev/null || true
      wait "$_agent_gh_retry_sleep_pid" 2>/dev/null || true
      _agent_gh_retry_sleep_pid=""
    fi
    _cleanup_secondary_retry_tempfiles
    exit "$status"
  }

  trap '_cleanup_secondary_retry_tempfiles' EXIT
  trap '_abort_secondary_retry 129' HUP
  trap '_abort_secondary_retry 130' INT
  trap '_abort_secondary_retry 143' TERM

  local attempt=0
  local exit_status=0
  local output=""
  local http_status=""
  local retries_exhausted=false
  while :; do
    if "$real_gh" "$@" >"$_agent_gh_retry_stdout_file" 2>"$_agent_gh_retry_stderr_file"; then
      exit_status=0
    else
      exit_status=$?
    fi

    if (( exit_status == 0 )); then
      break
    fi

    output="$(cat "$_agent_gh_retry_stdout_file" "$_agent_gh_retry_stderr_file")"
    if ! _is_secondary_rate_limited "$output"; then
      break
    fi

    attempt=$((attempt + 1))
    http_status="$(_secondary_rate_limit_http_status "$output")"
    if (( attempt > max_retries )); then
      retries_exhausted=true
      break
    fi

    local delay_s=$((base_delay_s * (2 ** (attempt - 1))))
    printf 'agent-gh-shim: GitHub HTTP %s throttled; retrying gh in %ss (attempt %s/%s).\n' \
      "$http_status" "$delay_s" "$attempt" "$max_retries" >&2
    if [[ ! -t 0 && "${LU_OPSEC_FILE_PAYLOAD:-}" != "1" ]]; then
      printf 'agent-gh-shim: warning: piped stdin was consumed on attempt 1 and cannot be replayed for retried command: gh %s\n' \
        "[arguments masked]" >&2
    fi
    # Bash's wait builtin returns when TERM interrupts it, letting the abort
    # trap kill the tracked backoff child immediately.
    # shellcheck disable=SC2217
    sleep "$delay_s" </dev/null >/dev/null 2>&1 &
    _agent_gh_retry_sleep_pid=$!
    wait "$_agent_gh_retry_sleep_pid" 2>/dev/null || true
    _agent_gh_retry_sleep_pid=""
  done

  # Retry attempts stay private: only the final gh invocation's output reaches
  # the caller. The durable marker is likewise reserved for a truly exhausted
  # secondary-rate-limit retry budget.
  cat "$_agent_gh_retry_stdout_file"
  cat "$_agent_gh_retry_stderr_file" >&2
  if [[ "$retries_exhausted" == true ]]; then
    printf 'agent-gh-shim: github_secondary_rate_limited HTTP %s; retries exhausted after %s attempts.\n' \
      "$http_status" "$max_retries" >&2
  fi
  return "$exit_status"
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  if [[ "${AGENT_NO_MERGE:-}" == "1" ]] && _blocks_gh_command "$@"; then
    [[ -n "$_agent_gh_stdin_buffer" ]] && rm -f "$_agent_gh_stdin_buffer"
    _deny
  fi
  if [[ -n "$_agent_gh_stdin_buffer" ]]; then
    # The check consumed stdin; hand the backend the same bytes.
    exec 0<"$_agent_gh_stdin_buffer"
    rm -f "$_agent_gh_stdin_buffer"
  fi
  real_gh="$(_real_gh)" || {
    echo "error: could not locate the real gh binary behind the agent shim." >&2
    exit 127
  }
  shim_file="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/gh"
  repo_root="$(cd "$(dirname "$shim_file")/../../.." && pwd)"
  common_dir="$(git -C "$repo_root" rev-parse --path-format=absolute --git-common-dir)"
  exec "$(dirname "$common_dir")/.venv/bin/python" "$repo_root/scripts/opsec/gh_entry.py" "$real_gh" "$shim_file" "$@"
fi
