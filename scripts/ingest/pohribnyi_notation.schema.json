{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provisional",
    "normalization",
    "combining_mark_order",
    "precomposed_letters",
    "inventory_source_pages",
    "freeze_reviewers",
    "letters",
    "symbols",
    "pending_classes",
    "underlining",
    "status",
    "minimum_unicode_version",
    "driver_reconciliation"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "provisional": {
      "type": "boolean"
    },
    "normalization": {
      "const": "NFC"
    },
    "combining_mark_order": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^U\\+[0-9A-F]{4,6}$"
      }
    },
    "precomposed_letters": {
      "type": "string"
    },
    "inventory_source_pages": {
      "const": [
        4,
        5
      ]
    },
    "freeze_reviewers": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "letters": {
      "type": "string",
      "minLength": 1
    },
    "symbols": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "codepoint",
          "provisional",
          "glyph",
          "unicode_name",
          "combining_class",
          "definition_uk",
          "source_page",
          "source_kind"
        ],
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1
          },
          "codepoint": {
            "type": "string",
            "pattern": "^U\\+[0-9A-F]{4,6}$"
          },
          "provisional": {
            "type": "boolean"
          },
          "glyph": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1
          },
          "unicode_name": {
            "type": "string",
            "minLength": 1
          },
          "combining_class": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "definition_uk": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "source_page": {
            "type": "integer",
            "minimum": 4,
            "maximum": 28
          },
          "source_kind": {
            "enum": [
              "key",
              "body",
              "separator",
              "encoding"
            ]
          },
          "letter": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1
          },
          "additional_source_pages": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 4,
              "maximum": 28
            }
          },
          "encoding_note": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "source_kind": {
                  "enum": [
                    "key",
                    "body"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "definition_uk": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        ]
      }
    },
    "pending_classes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "underlining": {
      "const": {
        "field": "underlining",
        "unit": "Unicode codepoints",
        "interval": "half-open",
        "scope": "paragraph text"
      }
    },
    "status": {
      "enum": [
        "provisional",
        "frozen"
      ]
    },
    "minimum_unicode_version": {
      "const": "15.0.0"
    },
    "driver_reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "driver",
        "issue",
        "comment_heading",
        "date"
      ],
      "properties": {
        "driver": {
          "type": "string",
          "minLength": 1
        },
        "issue": {
          "const": 9604
        },
        "comment_heading": {
          "const": "E3c step 2: notation inventory reconciled"
        },
        "date": {
          "const": "2026-10-03"
        }
      }
    }
  }
}
