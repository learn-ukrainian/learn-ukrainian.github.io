{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "provisional", "normalization", "inventory_source_pages", "freeze_reviewers", "letters", "symbols", "pending_classes", "underlining"],
  "properties": {
    "schema_version": {"const": 1},
    "provisional": {"type": "boolean"},
    "normalization": {"const": "NFC"},
    "inventory_source_pages": {"const": [4, 5]},
    "freeze_reviewers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "letters": {"type": "string", "minLength": 1},
    "symbols": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["role", "codepoint", "provisional"],
        "properties": {
          "role": {"type": "string", "minLength": 1},
          "codepoint": {"type": "string", "pattern": "^U\\+[0-9A-F]{4,6}$"},
          "provisional": {"type": "boolean"}
        }
      }
    },
    "pending_classes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "underlining": {"const": {"field": "underlining", "unit": "Unicode codepoints", "interval": "half-open", "scope": "paragraph text"}}
  }
}
