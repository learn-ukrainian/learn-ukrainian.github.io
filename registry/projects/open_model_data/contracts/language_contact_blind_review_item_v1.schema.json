{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learn-ukrainian.github.io/schemas/open-model-data/language_contact_blind_review_item_v1.schema.json",
  "title": "Language-contact blind-review item v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "packet_id", "item_id", "candidate_id", "order", "candidate_sha256", "source", "blind_context", "evidence_references", "review_form_seed", "hidden_authority"],
  "properties": {
    "schema_version": {"const": "language_contact_blind_review_item_v1"}, "packet_id": {"$ref": "#/$defs/id"}, "item_id": {"$ref": "#/$defs/id"}, "candidate_id": {"type": "string", "pattern": "^lcc\\.[a-f0-9]{64}$"}, "order": {"type": "integer", "minimum": 0}, "candidate_sha256": {"$ref": "#/$defs/sha256"},
    "source": {"type": "object", "additionalProperties": false, "required": ["family", "locator_token_or_sha256", "period", "genre", "register", "author", "work", "year", "source_record_id_sha256"], "properties": {"family": {"type": "string", "minLength": 1}, "locator_token_or_sha256": {"type": "string", "pattern": "^(?:[a-f0-9]{64}|[A-Za-z0-9._:-]{3,128})$"}, "period": {"type": "string", "minLength": 1}, "genre": {"type": "string", "minLength": 1}, "register": {"type": "string", "minLength": 1}, "author": {"type": ["string", "null"], "minLength": 1}, "work": {"type": ["string", "null"], "minLength": 1}, "year": {"type": ["integer", "null"], "minimum": 0, "maximum": 9999}, "source_record_id_sha256": {"$ref": "#/$defs/sha256"}}},
    "blind_context": {"type": "object", "additionalProperties": false, "required": ["text", "context_sha256", "absolute_start_offset", "absolute_end_offset", "relative_core_start_offset", "relative_core_end_offset", "core_sha256"], "properties": {"text": {"type": "string", "minLength": 1, "maxLength": 240}, "context_sha256": {"$ref": "#/$defs/sha256"}, "absolute_start_offset": {"type": "integer", "minimum": 0}, "absolute_end_offset": {"type": "integer", "minimum": 1}, "relative_core_start_offset": {"type": "integer", "minimum": 0}, "relative_core_end_offset": {"type": "integer", "minimum": 1}, "core_sha256": {"$ref": "#/$defs/sha256"}}},
    "evidence_references": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["source_identity", "query", "status", "response_sha256"], "properties": {"source_identity": {"type": "string", "minLength": 1}, "query": {"type": "string", "minLength": 1}, "status": {"enum": ["available", "not_found", "pending", "unavailable"]}, "response_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}}}},
    "review_form_seed": {"type": "object", "additionalProperties": false, "required": ["decision_options", "language_identity_options", "discourse_role_options", "requires_rationale", "requires_evidence"], "properties": {"decision_options": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["correction", "acceptable_as_is", "protected_variation", "quoted_or_multilingual", "exclude", "unresolved"]}}, "language_identity_options": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "discourse_role_options": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "requires_rationale": {"const": true}, "requires_evidence": {"const": true}}},
    "hidden_authority": {"type": "object", "additionalProperties": false, "required": ["detector_output_included", "model_vote_included", "prior_reviewer_output_included", "prior_label_included"], "properties": {"detector_output_included": {"const": false}, "model_vote_included": {"const": false}, "prior_reviewer_output_included": {"const": false}, "prior_label_included": {"const": false}}}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{3,128}$"}}
}
