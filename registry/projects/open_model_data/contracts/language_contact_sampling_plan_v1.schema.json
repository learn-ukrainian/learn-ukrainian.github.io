{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learn-ukrainian.github.io/schemas/open-model-data/language_contact_sampling_plan_v1.schema.json",
  "title": "Language-contact blind-review sampling plan v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "plan_id", "frame_sha256", "approval", "reviewer_capacity", "statistical_stop", "strata", "packet_controls"],
  "properties": {
    "schema_version": {"const": "language_contact_sampling_plan_v1"}, "plan_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{2,127}$"}, "frame_sha256": {"$ref": "#/$defs/sha256"},
    "approval": {"type": "object", "additionalProperties": false, "required": ["status", "operator_id", "approved_at", "issue_url", "rationale"], "properties": {"status": {"enum": ["pending", "approved"]}, "operator_id": {"type": ["string", "null"], "minLength": 1}, "approved_at": {"type": ["string", "null"], "format": "date-time"}, "issue_url": {"type": "string", "format": "uri"}, "rationale": {"type": "string", "minLength": 1}}},
    "reviewer_capacity": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/capacity"}]}, "statistical_stop": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/stop"}]},
    "strata": {"type": "array", "minItems": 10, "uniqueItems": true, "items": {"$ref": "#/$defs/stratumPlan"}},
    "packet_controls": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/packetControls"}]}
  },
  "allOf": [
    {"if": {"properties": {"approval": {"properties": {"status": {"const": "approved"}}}}}, "then": {"properties": {"approval": {"properties": {"operator_id": {"type": "string", "minLength": 1}, "approved_at": {"type": "string", "format": "date-time"}}}, "reviewer_capacity": {"$ref": "#/$defs/capacity"}, "statistical_stop": {"$ref": "#/$defs/stop"}, "packet_controls": {"$ref": "#/$defs/packetControls"}, "strata": {"items": {"$ref": "#/$defs/approvedStratumPlan"}}}}},
    {"if": {"properties": {"approval": {"properties": {"status": {"const": "pending"}}}}}, "then": {"properties": {"approval": {"properties": {"operator_id": {"type": "null"}, "approved_at": {"type": "null"}}}, "reviewer_capacity": {"type": "null"}, "statistical_stop": {"type": "null"}, "packet_controls": {"type": "null"}, "strata": {"items": {"$ref": "#/$defs/pendingStratumPlan"}}}}}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "count": {"type": "integer", "minimum": 0}, "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{2,127}$"},
    "capacity": {"type": "object", "additionalProperties": false, "required": ["first_pass_reviewer_ids", "third_resolver_id", "items_per_hour", "hours_per_person_per_wave", "source", "evidence"], "properties": {"first_pass_reviewer_ids": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "third_resolver_id": {"$ref": "#/$defs/id"}, "items_per_hour": {"type": "number", "exclusiveMinimum": 0}, "hours_per_person_per_wave": {"type": "number", "exclusiveMinimum": 0}, "source": {"type": "string", "minLength": 1}, "evidence": {"type": "string", "minLength": 1}}},
    "stop": {"type": "object", "additionalProperties": false, "required": ["confidence_level", "interval_method", "stability_metric", "maximum_interval_width", "maximum_consecutive_wave_change", "consecutive_stable_waves", "category_coverage_rule", "learning_curve_rule"], "properties": {"confidence_level": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}, "interval_method": {"const": "wilson"}, "stability_metric": {"const": "per_stratum_adjudicative_core_agreement_rate"}, "maximum_interval_width": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}, "maximum_consecutive_wave_change": {"type": "number", "minimum": 0, "maximum": 1}, "consecutive_stable_waves": {"type": "integer", "minimum": 2}, "category_coverage_rule": {"type": "object", "additionalProperties": false, "required": ["minimum_reviewed_per_stratum"], "properties": {"minimum_reviewed_per_stratum": {"type": "integer", "minimum": 1}}}, "learning_curve_rule": {"type": "object", "additionalProperties": false, "required": ["metric", "maximum_consecutive_wave_change"], "properties": {"metric": {"const": "correction_yield_rate"}, "maximum_consecutive_wave_change": {"type": "number", "minimum": 0, "maximum": 1}}}}},
    "stratumId": {"enum": ["modern_interference", "valid_word_contact", "false_positive_rescue", "historical", "regional_or_dialectal_candidate", "conversational_or_marked", "quoted_or_multilingual", "uncertain", "technical_or_ocr", "proper_name"]},
    "stratumPlan": {"type": "object", "additionalProperties": false, "required": ["stratum_id", "observed_frame_count", "calibration_target", "production_target", "rationale"], "properties": {"stratum_id": {"$ref": "#/$defs/stratumId"}, "observed_frame_count": {"$ref": "#/$defs/count"}, "calibration_target": {"type": ["integer", "null"], "minimum": 0}, "production_target": {"type": ["integer", "null"], "minimum": 0}, "rationale": {"type": "string", "minLength": 1}}},
    "approvedStratumPlan": {"allOf": [{"$ref": "#/$defs/stratumPlan"}, {"properties": {"calibration_target": {"type": "integer", "minimum": 1}, "production_target": {"type": "integer", "minimum": 1}}}]}, "pendingStratumPlan": {"allOf": [{"$ref": "#/$defs/stratumPlan"}, {"properties": {"calibration_target": {"type": "null"}, "production_target": {"type": "null"}}}]},
    "packetControls": {"type": "object", "additionalProperties": false, "required": ["first_pass_packet_salt_sha256"], "properties": {"first_pass_packet_salt_sha256": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}}}}
  }
}
