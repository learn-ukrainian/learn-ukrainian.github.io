{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learn-ukrainian.github.io/schemas/open-model-data/v4_native_extraction_receipt_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "config_sha256",
    "index_sha256",
    "quarantine_report_sha256",
    "summary",
    "safety_assertions",
    "verdict"
  ],
  "properties": {
    "schema_version": {
      "const": "v4_native_extraction_receipt_v1"
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^receipt\\.extraction\\.[a-f0-9]{24}$"
    },
    "config_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "index_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "quarantine_report_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_sources_evaluated",
        "total_spans_evaluated",
        "accepted_spans_count",
        "quarantined_spans_count",
        "rejected_spans_count",
        "training_eligible_spans_count"
      ],
      "properties": {
        "total_sources_evaluated": {
          "type": "integer",
          "minimum": 0
        },
        "total_spans_evaluated": {
          "type": "integer",
          "minimum": 0
        },
        "accepted_spans_count": {
          "type": "integer",
          "minimum": 0
        },
        "quarantined_spans_count": {
          "type": "integer",
          "minimum": 0
        },
        "rejected_spans_count": {
          "type": "integer",
          "minimum": 0
        },
        "training_eligible_spans_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "safety_assertions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "no_corpus_text",
        "no_private_host_paths",
        "immutable_original_preserved",
        "zero_silent_omissions"
      ],
      "properties": {
        "no_corpus_text": {
          "type": "boolean"
        },
        "no_private_host_paths": {
          "type": "boolean"
        },
        "immutable_original_preserved": {
          "type": "boolean"
        },
        "zero_silent_omissions": {
          "type": "boolean"
        }
      }
    },
    "verdict": {
      "enum": [
        "EXTRACTION_FIDELITY_CONFIRMED",
        "EXTRACTION_FIDELITY_FAILED"
      ]
    }
  }
}
