{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learn-ukrainian.github.io/schemas/open-model-data/dataset_v4_pilot_slot_manifest_v1.schema.json",
  "title": "Dataset V4 pilot slot manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "text_free", "controlling_outcome_sha256", "product_scope", "non_goals", "release_train", "custody_policy", "rights_policy", "role_ownership", "required_role_ids", "required_gate_ids", "completion_vocabulary", "completion_policy", "sealed_heldout_commitment", "slot_series"],
  "properties": {
    "schema_version": {"const": "dataset_v4_pilot_slot_manifest_v1"},
    "status": {"const": "FROZEN_PREBUILD_SLOT_CONTRACT"},
    "text_free": {"const": true},
    "controlling_outcome_sha256": {"const": "78a1edad36f7bab31f77470fcbf95e1542adbcd9ff5701a6c539a2cfdc49ff20"},
    "product_scope": {"type": "array", "minItems": 7, "maxItems": 7, "uniqueItems": true, "items": {"enum": ["standard_control", "literary", "dialect_regional", "archaic_historical", "mixing", "quotation_interference", "abstention"]}},
    "non_goals": {"type": "array", "minItems": 9, "maxItems": 9, "uniqueItems": true, "items": {"enum": ["no_model_training_or_preference_optimization", "no_general_vernacular_or_knowledge_corpus", "no_dedicated_non_ukrainian_slavic_lanes", "no_modern_rusyn_remapping", "no_automatic_modernization_of_protected_material", "no_model_output_or_agreement_as_silver_or_gold", "no_source_text_publication_or_redistribution_without_operation_rights", "no_mac_corpus_or_data_producing_work", "no_dataset_or_model_performance_claims_without_release_gates"]}},
    "release_train": {"type": "object", "additionalProperties": false, "required": ["initial", "later_overlay", "model_agreement_admits_silver", "model_agreement_creates_gold"], "properties": {"initial": {"const": "silver"}, "later_overlay": {"const": "gold"}, "model_agreement_admits_silver": {"const": false}, "model_agreement_creates_gold": {"const": false}}},
    "custody_policy": {"type": "object", "additionalProperties": false, "required": ["execution", "mac_corpus_copy_allowed", "capacity_gate_required"], "properties": {"execution": {"const": "VPS_FIRST"}, "mac_corpus_copy_allowed": {"const": false}, "capacity_gate_required": {"const": true}}},
    "rights_policy": {"type": "object", "additionalProperties": false, "required": ["operation_specific", "unresolved_operation_is_global_blocker"], "properties": {"operation_specific": {"const": true}, "unresolved_operation_is_global_blocker": {"const": false}}},
    "role_ownership": {"type": "object", "additionalProperties": false, "required": ["A0", "A1", "A2", "A3", "A4", "A5", "A6", "A7", "A8", "A9", "A10", "A11", "A12", "A13"], "properties": {"A0": {"const": "scope_lead"}, "A1": {"const": "custody"}, "A2": {"const": "source_inventory_admission"}, "A3": {"const": "heldout"}, "A4": {"const": "deterministic_extraction"}, "A5": {"const": "evidence_enrichment"}, "A6": {"const": "safe_arena"}, "A7": {"const": "original_row_factory"}, "A8": {"const": "admission_assembly"}, "A9": {"const": "evaluation_package"}, "A10": {"const": "pilot_review"}, "A11": {"const": "training_ready_release"}, "A12": {"const": "later_gold_overlay"}, "A13": {"const": "cleanup_recovery"}}},
    "required_role_ids": {"type": "array", "minItems": 14, "maxItems": 14, "uniqueItems": true, "items": {"pattern": "^A(?:[0-9]|1[0-3])$"}},
    "required_gate_ids": {"type": "array", "minItems": 7, "maxItems": 7, "uniqueItems": true, "items": {"enum": ["VPS_CUSTODY_CAPACITY", "SOURCE_OPERATION_ADMISSION", "SEALED_HELDOUT_SOURCE_FAMILY_SPLIT", "NON_SELF_ARENA_VOTING", "MODEL_AGREEMENT_NOT_SILVER_OR_GOLD", "SILVER_FIRST_STABLE_IDS", "INDEPENDENT_CROSS_FAMILY_EXACT_HEAD_REVIEW"]}},
    "completion_vocabulary": {"type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true, "items": {"enum": ["ARENA_SLICE_READY", "EVAL_ARTIFACT_READY", "TRAINING_READY_SILVER", "TRAINING_READY_GOLD_SUBSET", "GOLD_UPGRADE_READY", "BLOCKED_WITH_RESIDUALS"]}},
    "completion_policy": {"type": "object", "additionalProperties": false, "required": ["blocked_with_residuals_is_success", "unresolved_required_slots_satisfy_eval", "unresolved_required_slots_satisfy_training_silver"], "properties": {"blocked_with_residuals_is_success": {"const": false}, "unresolved_required_slots_satisfy_eval": {"const": false}, "unresolved_required_slots_satisfy_training_silver": {"const": false}}},
    "sealed_heldout_commitment": {"type": "object", "additionalProperties": false, "required": ["required_before_builders_start", "source_family_split_required", "heldout_membership_included", "assignment_owner"], "properties": {"required_before_builders_start": {"const": true}, "source_family_split_required": {"const": true}, "heldout_membership_included": {"const": false}, "assignment_owner": {"const": "A2_A3_PRIVATE_ARTIFACT"}}},
    "slot_series": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"oneOf": [{"$ref": "#/$defs/standard_correct"}, {"$ref": "#/$defs/correction"}, {"$ref": "#/$defs/literary"}, {"$ref": "#/$defs/dialect_regional"}, {"$ref": "#/$defs/archaic_historical"}, {"$ref": "#/$defs/mixing"}, {"$ref": "#/$defs/quotation_interference"}, {"$ref": "#/$defs/abstention"}]}, "allOf": [{"contains": {"$ref": "#/$defs/standard_correct"}, "minContains": 1, "maxContains": 1}, {"contains": {"$ref": "#/$defs/correction"}, "minContains": 1, "maxContains": 1}, {"contains": {"$ref": "#/$defs/literary"}, "minContains": 1, "maxContains": 1}, {"contains": {"$ref": "#/$defs/dialect_regional"}, "minContains": 1, "maxContains": 1}, {"contains": {"$ref": "#/$defs/archaic_historical"}, "minContains": 1, "maxContains": 1}, {"contains": {"$ref": "#/$defs/mixing"}, "minContains": 1, "maxContains": 1}, {"contains": {"$ref": "#/$defs/quotation_interference"}, "minContains": 1, "maxContains": 1}, {"contains": {"$ref": "#/$defs/abstention"}, "minContains": 1, "maxContains": 1}]}
  },
  "$defs": {
    "series_base": {"type": "object", "additionalProperties": false, "required": ["stratum", "id_prefix", "start", "count", "assignment_state"], "properties": {"stratum": {"type": "string"}, "id_prefix": {"type": "string"}, "start": {"const": 1}, "count": {"type": "integer"}, "assignment_state": {"const": "UNASSIGNED_PENDING_A2_A3"}}},
    "standard_correct": {"allOf": [{"$ref": "#/$defs/series_base"}, {"properties": {"stratum": {"const": "standard_correct"}, "id_prefix": {"const": "v4p-standard-correct"}, "count": {"const": 15}}}]},
    "correction": {"allOf": [{"$ref": "#/$defs/series_base"}, {"properties": {"stratum": {"const": "correction"}, "id_prefix": {"const": "v4p-correction"}, "count": {"const": 15}}}]},
    "literary": {"allOf": [{"$ref": "#/$defs/series_base"}, {"properties": {"stratum": {"const": "literary"}, "id_prefix": {"const": "v4p-literary"}, "count": {"const": 15}}}]},
    "dialect_regional": {"allOf": [{"$ref": "#/$defs/series_base"}, {"properties": {"stratum": {"const": "dialect_regional"}, "id_prefix": {"const": "v4p-dialect-regional"}, "count": {"const": 15}}}]},
    "archaic_historical": {"allOf": [{"$ref": "#/$defs/series_base"}, {"properties": {"stratum": {"const": "archaic_historical"}, "id_prefix": {"const": "v4p-archaic-historical"}, "count": {"const": 15}}}]},
    "mixing": {"allOf": [{"$ref": "#/$defs/series_base"}, {"properties": {"stratum": {"const": "mixing"}, "id_prefix": {"const": "v4p-mixing"}, "count": {"const": 10}}}]},
    "quotation_interference": {"allOf": [{"$ref": "#/$defs/series_base"}, {"properties": {"stratum": {"const": "quotation_interference"}, "id_prefix": {"const": "v4p-quotation-interference"}, "count": {"const": 10}}}]},
    "abstention": {"allOf": [{"$ref": "#/$defs/series_base"}, {"properties": {"stratum": {"const": "abstention"}, "id_prefix": {"const": "v4p-abstention"}, "count": {"const": 5}}}]}
  }
}
