{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learn-ukrainian.github.io/schemas/open-model-data/treatment_authorization_v1.schema.json",
  "title": "Ukrainian Data Foundry treatment operator authorization v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "experiment_id", "preregistration_sha256", "operator_decision", "model", "authorized_stages", "ceilings", "boundaries"],
  "properties": {
    "schema_version": {"const": "treatment_authorization_v1"},
    "experiment_id": {"type": "string", "minLength": 3},
    "preregistration_sha256": {"$ref": "#/$defs/sha256"},
    "operator_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approved", "source", "approved_at"],
      "properties": {
        "approved": {"const": true},
        "source": {"type": "string", "minLength": 10},
        "approved_at": {"type": "string", "format": "date-time"}
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identifier", "revision", "download_authorized"],
      "properties": {
        "identifier": {"const": "google/gemma-4-31B-it"},
        "revision": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
        "download_authorized": {"const": true}
      }
    },
    "authorized_stages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"enum": ["smoke", "bounded_causal"]}
    },
    "ceilings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage_1_usd", "all_inclusive_usd"],
      "properties": {
        "stage_1_usd": {"type": "number", "exclusiveMinimum": 0, "maximum": 10},
        "all_inclusive_usd": {"type": "number", "exclusiveMinimum": 0, "maximum": 100}
      }
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["training_authorized", "upload_authorized", "publication_authorized", "full_weight_tuning_authorized", "unbounded_retry_authorized"],
      "properties": {
        "training_authorized": {"const": true},
        "upload_authorized": {"const": false},
        "publication_authorized": {"const": false},
        "full_weight_tuning_authorized": {"const": false},
        "unbounded_retry_authorized": {"const": false}
      }
    }
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
