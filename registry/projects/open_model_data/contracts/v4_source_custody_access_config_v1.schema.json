{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learn-ukrainian.github.io/schemas/open-model-data/v4_source_custody_access_config_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operator_decision",
    "inputs",
    "outputs",
    "cohorts",
    "ownership"
  ],
  "properties": {
    "schema_version": {
      "const": "v4_source_custody_access_config_v1"
    },
    "operator_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "issue",
        "parent_epic",
        "summary"
      ],
      "properties": {
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "issue": {
          "type": "integer"
        },
        "parent_epic": {
          "type": "integer"
        },
        "summary": {
          "type": "string",
          "minLength": 10
        }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provenance_index",
        "provenance_receipt",
        "database",
        "textbook_chunks_dir",
        "retained_archive_locator"
      ],
      "properties": {
        "provenance_index": {
          "type": "string"
        },
        "provenance_receipt": {
          "type": "string"
        },
        "database": {
          "type": "string"
        },
        "textbook_chunks_dir": {
          "type": "string"
        },
        "retained_archive_locator": {
          "type": "string"
        }
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "missing_report",
        "receipt"
      ],
      "properties": {
        "index": {
          "type": "string"
        },
        "missing_report": {
          "type": "string"
        },
        "receipt": {
          "type": "string"
        }
      }
    },
    "cohorts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cohort_id",
          "source_family",
          "resolver_kind",
          "primary_store",
          "lineage_rule"
        ],
        "properties": {
          "cohort_id": {
            "type": "string"
          },
          "source_family": {
            "enum": [
              "literary",
              "public_textbooks"
            ]
          },
          "resolver_kind": {
            "enum": [
              "sqlite_database",
              "hybrid_sqlite_chunks_archive"
            ]
          },
          "primary_store": {
            "type": "string"
          },
          "chunks_dir": {
            "type": "string"
          },
          "archive_locator": {
            "type": "string"
          },
          "lineage_rule": {
            "enum": [
              "native_digital_source",
              "native_pdf_text"
            ]
          },
          "excluded_modes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "apple_vision_ocr",
                "ocr",
                "scanned_image"
              ]
            }
          }
        }
      }
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unmounted_archive_owner",
        "blocks_scope"
      ],
      "properties": {
        "unmounted_archive_owner": {
          "type": "string"
        },
        "blocks_scope": {
          "type": "string"
        }
      }
    }
  }
}
