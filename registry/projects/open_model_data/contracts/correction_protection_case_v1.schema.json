{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learn-ukrainian.github.io/schemas/open-model-data/correction_protection_case_v1.schema.json",
  "title": "Evidence-graded correction/protection case v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "case_id", "assurance_tier", "authoritative", "phenomenon", "benchmark_role", "evidence_grade", "source", "original", "evidence_refs", "category_gate", "disposition", "claim_boundary"],
  "properties": {
    "schema_version": {"const": "correction_protection_case_v1"}, "case_id": {"type": "string", "pattern": "^cp_case:[a-f0-9]{64}$"}, "assurance_tier": {"const": "evidence_graded_non_gold"}, "authoritative": {"const": false},
    "phenomenon": {"type": "string", "minLength": 1},
    "benchmark_role": {"enum": ["full_corpus_candidate", "positive", "acceptable_control", "protected_example"]},
    "evidence_grade": {"enum": ["source_metadata_only", "multi_channel", "model_supported_non_gold"]},
    "source": {"$ref": "#/$defs/source"}, "original": {"$ref": "#/$defs/original"}, "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/evidenceRef"}},
    "category_gate": {"type": "object", "additionalProperties": false, "required": ["category_id", "state", "correction_release_allowed", "threshold_config_sha256", "evidence_refs"], "properties": {"category_id": {"type": "string", "minLength": 1}, "state": {"enum": ["passed", "research_only"]}, "correction_release_allowed": {"type": "boolean"}, "threshold_config_sha256": {"$ref": "#/$defs/sha256"}, "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}, "allOf": [{"if": {"properties": {"state": {"const": "research_only"}}}, "then": {"properties": {"correction_release_allowed": {"const": false}}}}]},
    "disposition": {"enum": ["correct", "correction", "protected", "excluded", "unresolved"]}, "proposal": {"$ref": "#/$defs/proposal"}, "disagreement_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "claim_boundary": {"type": "object", "additionalProperties": false, "required": ["human_gold", "human_reviewed", "model_vote_authoritative", "vesum_absence_only_authoritative", "training_eligible", "upload_eligible", "accelerator_eligible"], "properties": {"human_gold": {"const": false}, "human_reviewed": {"const": false}, "model_vote_authoritative": {"const": false}, "vesum_absence_only_authoritative": {"const": false}, "training_eligible": {"const": false}, "upload_eligible": {"const": false}, "accelerator_eligible": {"const": false}}}
  },
  "allOf": [{"if": {"properties": {"disposition": {"const": "correction"}}}, "then": {"required": ["proposal"], "properties": {"category_gate": {"properties": {"state": {"const": "passed"}, "correction_release_allowed": {"const": true}}}, "evidence_refs": {"contains": {"properties": {"channel": {"not": {"enum": ["model_proposal", "vesum"]}}}, "required": ["channel"]}}}}, "else": {"not": {"required": ["proposal"]}}}],
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "source": {"type": "object", "additionalProperties": false, "required": ["source_locator_id", "source_locator_sha256"], "properties": {"source_locator_id": {"type": "string", "pattern": "^cp_source:[a-f0-9]{64}$"}, "source_locator_sha256": {"$ref": "#/$defs/sha256"}}}, "original": {"type": "object", "additionalProperties": false, "required": ["start_offset", "end_offset", "surface_sha256", "immutable"], "properties": {"start_offset": {"type": "integer", "minimum": 0}, "end_offset": {"type": "integer", "minimum": 0}, "surface_sha256": {"$ref": "#/$defs/sha256"}, "immutable": {"const": true}}}, "evidenceRef": {"type": "object", "additionalProperties": false, "required": ["evidence_id", "channel", "evidence_sha256"], "properties": {"evidence_id": {"type": "string", "pattern": "^cp_evidence:[a-f0-9]{64}$"}, "channel": {"enum": ["vesum", "r2u", "russian_morphology", "ulif_dictua", "slovnyk_me", "heritage_dictionary", "ukrainian_corpus", "language_tool", "nlp_uk", "model_proposal", "source_metadata"]}, "evidence_sha256": {"$ref": "#/$defs/sha256"}}}, "proposal": {"type": "object", "additionalProperties": false, "required": ["replacement", "replacement_sha256", "original_surface_sha256", "reversible", "proposal_sha256"], "properties": {"replacement": {"type": "string", "minLength": 1}, "replacement_sha256": {"$ref": "#/$defs/sha256"}, "original_surface_sha256": {"$ref": "#/$defs/sha256"}, "reversible": {"const": true}, "proposal_sha256": {"$ref": "#/$defs/sha256"}}}}
}
