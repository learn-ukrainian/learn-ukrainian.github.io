{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learn-ukrainian.github.io/schemas/open-model-data/corpus_admission_evidence_v1.schema.json",
  "title": "Ukrainian Data Foundry corpus admission evidence packet v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_packet_id", "retrieved_on", "sources"],
  "properties": {
    "schema_version": {"const": "corpus_admission_evidence_v1"},
    "evidence_packet_id": {"$ref": "#/$defs/id"},
    "retrieved_on": {"$ref": "#/$defs/date"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_record_evidence_id", "source_family", "snapshot", "acquisition", "bibliographic", "description", "rights", "evidence", "review"],
        "properties": {
          "source_record_evidence_id": {"$ref": "#/$defs/id"},
          "source_family": {"$ref": "#/$defs/id"},
          "snapshot": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "rows", "lexical_words", "capture_timestamps", "first_retrieved_at", "last_retrieved_at", "content_hash_scope", "revision_id_required_by_contract"],
            "properties": {
              "kind": {"const": "article_level_captured_snapshot"},
              "rows": {"type": "integer", "minimum": 1},
              "lexical_words": {"type": "integer", "minimum": 1},
              "capture_timestamps": {"type": "integer", "minimum": 1},
              "first_retrieved_at": {"type": "string", "minLength": 1},
              "last_retrieved_at": {"type": "string", "minLength": 1},
              "content_hash_scope": {"type": "string", "minLength": 1},
              "revision_id_required_by_contract": {"const": false}
            }
          },
          "acquisition": {
            "type": "object",
            "additionalProperties": false,
            "required": ["method", "api_endpoint", "api_parameters", "code_cohorts"],
            "properties": {
              "method": {"type": "string", "minLength": 1},
              "api_endpoint": {"type": "string", "format": "uri"},
              "api_parameters": {"type": "object", "additionalProperties": {"type": "string"}},
              "code_cohorts": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["evidence_id", "rows", "first_retrieved_at", "last_retrieved_at", "commit", "git_blob_oid", "sha256", "url"],
                  "properties": {
                    "evidence_id": {"$ref": "#/$defs/id"},
                    "rows": {"type": "integer", "minimum": 1},
                    "first_retrieved_at": {"type": "string", "minLength": 1},
                    "last_retrieved_at": {"type": "string", "minLength": 1},
                    "commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
                    "git_blob_oid": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
                    "sha256": {"$ref": "#/$defs/sha256"},
                    "url": {"type": "string", "format": "uri"}
                  }
                }
              }
            }
          },
          "bibliographic": {
            "type": "object",
            "additionalProperties": false,
            "required": ["editor", "publisher", "translation_origin"],
            "properties": {
              "editor": {"type": "string", "minLength": 1},
              "publisher": {"type": "string", "minLength": 1},
              "translation_origin": {"type": "string", "minLength": 1}
            }
          },
          "description": {
            "type": "object",
            "additionalProperties": false,
            "required": ["author", "period", "genre", "register", "region"],
            "properties": {
              "author": {"type": "string", "minLength": 1},
              "period": {"type": "string", "minLength": 1},
              "genre": {"type": "string", "minLength": 1},
              "register": {"type": "string", "minLength": 1},
              "region": {"type": "string", "minLength": 1}
            }
          },
          "rights": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "jurisdiction", "license_expression", "license_terms_evidence_id", "evidence_ids", "legal_conclusion", "operational_permission", "obligations", "material_ambiguities"],
            "properties": {
              "status": {"const": "granted"},
              "jurisdiction": {"type": "string", "minLength": 1},
              "license_expression": {"type": "string", "minLength": 1},
              "license_terms_evidence_id": {"$ref": "#/$defs/id"},
              "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
              "legal_conclusion": {"const": "not_asserted"},
              "operational_permission": {"type": "string", "minLength": 1},
              "obligations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
              "material_ambiguities": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
            }
          },
          "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
          "review": {
            "type": "object",
            "additionalProperties": false,
            "required": ["reviewer_id", "qualification", "confidence", "unresolved"],
            "properties": {
              "reviewer_id": {"$ref": "#/$defs/id"},
              "qualification": {"type": "string", "minLength": 1},
              "confidence": {"enum": ["low", "medium", "high"]},
              "unresolved": {"const": false}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{2,127}$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "date": {"type": "string", "format": "date"},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "citation", "canonical_url", "receipt_url", "retrieved_on", "sha256"],
      "properties": {
        "evidence_id": {"$ref": "#/$defs/id"},
        "citation": {"type": "string", "minLength": 1},
        "canonical_url": {"type": "string", "format": "uri"},
        "receipt_url": {"type": "string", "format": "uri"},
        "retrieved_on": {"$ref": "#/$defs/date"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
