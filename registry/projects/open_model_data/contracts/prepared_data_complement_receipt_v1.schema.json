{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learn-ukrainian.github.io/schemas/open-model-data/prepared_data_complement_receipt_v1.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "inputs", "outputs", "coverage", "route_totals", "representation_totals", "algorithm", "resources", "safety"],
  "properties": {
    "schema_version": {"const": "prepared_data_complement_receipt_v1"},
    "receipt_id": {"type": "string", "pattern": "^complement-receipt\\.[a-f0-9]{24}$"},
    "inputs": {"$ref": "#/$defs/inputs"},
    "outputs": {"type": "object", "additionalProperties": false, "required": ["complement", "worklist"], "properties": {"complement": {"$ref": "#/$defs/artifact"}, "worklist": {"$ref": "#/$defs/artifact"}}},
    "coverage": {"$ref": "#/$defs/coverage"},
    "route_totals": {"$ref": "#/$defs/routeTotals"},
    "representation_totals": {"$ref": "#/$defs/representationTotals"},
    "algorithm": {"type": "object", "additionalProperties": false, "required": ["ordering", "serialization", "phase1_binding", "locator_binding", "receipt_last_commit_marker"], "properties": {"ordering": {"const": "Phase1 ordinal ascending; worklist source_id then capability"}, "serialization": {"const": "UTF-8 canonical JSON sorted keys LF"}, "phase1_binding": {"const": "validated Phase1 record and receipt schemas plus exact artifacts"}, "locator_binding": {"const": "one exact locator row per Phase1 source_id/work_id pair"}, "receipt_last_commit_marker": {"const": true}}},
    "resources": {"type": "object", "additionalProperties": false, "required": ["streaming", "source_passes", "bounded_state"], "properties": {"streaming": {"const": true}, "source_passes": {"const": 1}, "bounded_state": {"const": "one Phase1 row plus complete text-free locator map, aggregate counters, source/work pair counts, and per-source locator references"}}},
    "safety": {"type": "object", "additionalProperties": false, "required": ["training", "model", "download", "upload", "publication", "text_emitted", "evaluation_fingerprints_emitted"], "properties": {"training": {"const": false}, "model": {"const": false}, "download": {"const": false}, "upload": {"const": false}, "publication": {"const": false}, "text_emitted": {"const": false}, "evaluation_fingerprints_emitted": {"const": false}}}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "count": {"type": "integer", "minimum": 0},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["bytes", "records", "sha256"], "properties": {"bytes": {"$ref": "#/$defs/count"}, "records": {"$ref": "#/$defs/count"}, "sha256": {"$ref": "#/$defs/hash"}}},
    "counts": {"type": "object", "additionalProperties": {"$ref": "#/$defs/count"}},
    "inputs": {"type": "object", "additionalProperties": false, "required": ["phase1_manifest", "phase1_receipt", "policy", "locator_index", "schemas", "generator"], "properties": {"phase1_manifest": {"$ref": "#/$defs/artifact"}, "phase1_receipt": {"$ref": "#/$defs/artifact"}, "policy": {"$ref": "#/$defs/artifact"}, "locator_index": {"$ref": "#/$defs/artifact"}, "schemas": {"type": "object", "additionalProperties": false, "required": ["phase1_row", "phase1_receipt", "policy", "complement", "worklist", "receipt", "locator"], "properties": {"phase1_row": {"$ref": "#/$defs/hash"}, "phase1_receipt": {"$ref": "#/$defs/hash"}, "policy": {"$ref": "#/$defs/hash"}, "complement": {"$ref": "#/$defs/hash"}, "worklist": {"$ref": "#/$defs/hash"}, "receipt": {"$ref": "#/$defs/hash"}, "locator": {"$ref": "#/$defs/hash"}}}, "generator": {"$ref": "#/$defs/hash"}}},
    "coverage": {"type": "object", "additionalProperties": false, "required": ["complete", "records", "locator_mappings", "locator_by_family", "by_textbook_grade", "by_family", "by_source", "by_period", "by_genre", "by_register", "by_origin"], "properties": {"complete": {"const": true}, "records": {"$ref": "#/$defs/count"}, "locator_mappings": {"$ref": "#/$defs/count"}, "locator_by_family": {"$ref": "#/$defs/counts"}, "by_textbook_grade": {"$ref": "#/$defs/counts"}, "by_family": {"$ref": "#/$defs/counts"}, "by_source": {"$ref": "#/$defs/counts"}, "by_period": {"$ref": "#/$defs/counts"}, "by_genre": {"$ref": "#/$defs/counts"}, "by_register": {"$ref": "#/$defs/counts"}, "by_origin": {"$ref": "#/$defs/counts"}}},
    "routeTotals": {"type": "object", "additionalProperties": false, "required": ["acquisition_retention", "local_preparation", "local_model_learning", "raw_redistribution", "derived_redistribution", "dataset_publication", "model_publication"], "properties": {"acquisition_retention": {"$ref": "#/$defs/counts"}, "local_preparation": {"$ref": "#/$defs/counts"}, "local_model_learning": {"$ref": "#/$defs/counts"}, "raw_redistribution": {"$ref": "#/$defs/counts"}, "derived_redistribution": {"$ref": "#/$defs/counts"}, "dataset_publication": {"$ref": "#/$defs/counts"}, "model_publication": {"$ref": "#/$defs/counts"}}},
    "representationTotals": {"type": "object", "additionalProperties": false, "required": ["faithful", "loss_masked", "protected"], "properties": {"faithful": {"type": "object", "additionalProperties": false, "required": ["candidate", "metadata_only"], "properties": {"candidate": {"$ref": "#/$defs/count"}, "metadata_only": {"$ref": "#/$defs/count"}}}, "loss_masked": {"type": "object", "additionalProperties": false, "required": ["not_classified_phase2"], "properties": {"not_classified_phase2": {"$ref": "#/$defs/count"}}}, "protected": {"type": "object", "additionalProperties": false, "required": ["not_classified_phase2"], "properties": {"not_classified_phase2": {"$ref": "#/$defs/count"}}}}}
  }
}
