{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Draft instruction catalog for open-model-data E10",
  "description": "Draft-only shape and binding-role schema. It cannot certify source relationships, Ukrainian quality, independent review, concentration or training eligibility.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "version",
    "status",
    "training_eligible",
    "issue",
    "plan",
    "interpolation",
    "prefix_metric",
    "components"
  ],
  "properties": {
    "schema_version": {
      "const": "instruction-catalog.v1"
    },
    "version": {
      "const": "0.1.0-draft"
    },
    "status": {
      "const": "draft"
    },
    "training_eligible": {
      "const": false
    },
    "issue": {
      "const": 9611
    },
    "plan": {
      "const": {
        "path": "docs/projects/open-model-data/PLAN.md",
        "version": "3.4.4",
        "body_sha256": "2d5db0ae7d15336b61c361c1dacdf89c3c9811cfd0109acc8f156f16149e94e1"
      }
    },
    "interpolation": {
      "const": {
        "mode": "verbatim_source_fields_only",
        "missing_field": "withhold",
        "transformations": "none",
        "recursive_interpolation": false,
        "scope": "Only instructions[].template is project-authored training text. All other catalog fields are control metadata and must not be exported as instructions or answers.",
        "field_mapping": "Slots name binding roles from PLAN.md, not guessed physical database columns. E4 must authenticate the exact source adapter and row/field locators before any rendering."
      }
    },
    "prefix_metric": {
      "const": {
        "id": "instruction-prefix.v1-draft",
        "status": "proposed",
        "scope": "Per component, operation and exported split; additionally the whole split for visibility. C7 remains opt-in and separate.",
        "prefix_lengths": [
          1,
          4
        ],
        "top1_max": 0.15,
        "top5_max": 0.65,
        "small_denominator": "N<8 is insufficient evidence, never PASS. For N>=8 use exact shares without rounding allowances; if integer counts cannot meet both bounds, withhold the build.",
        "specification": "docs/projects/open-model-data/instruction-catalog.md"
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": [
