{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Versioned instruction catalog for open-model-data E10",
  "description": "Structural and binding-role schema only; source relationships, language, reviews, concentration and training eligibility require external evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "version",
    "status",
    "training_eligible",
    "issue",
    "plan",
    "interpolation",
    "prefix_metric",
    "components",
    "repetition_metric"
  ],
  "properties": {
    "schema_version": {
      "const": "instruction-catalog.v1"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[a-z0-9.-]+)?$"
    },
    "status": {
      "enum": [
        "draft",
        "approved"
      ]
    },
    "training_eligible": {
      "type": "boolean"
    },
    "issue": {
      "type": "integer",
      "minimum": 1
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "version",
        "body_sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "body_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "interpolation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "missing_field",
        "transformations",
        "recursive_interpolation",
        "scope",
        "field_mapping",
        "quoted_slot_policy"
      ],
      "properties": {
        "mode": {
          "enum": [
            "verbatim_source_fields_only"
          ]
        },
        "missing_field": {
          "enum": [
            "withhold"
          ]
        },
        "transformations": {
          "enum": [
            "none"
          ]
        },
        "recursive_interpolation": {
          "type": "boolean",
          "const": false
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "field_mapping": {
          "type": "string",
          "minLength": 1
        },
        "quoted_slot_policy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "prefix_metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "scope",
        "prefix_lengths",
        "top1_max",
        "top5_max",
        "small_denominator",
        "specification"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "prefix_lengths": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "top1_max": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "top5_max": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "small_denominator": {
          "type": "string",
          "minLength": 1
        },
        "specification": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "C1",
        "C2",
        "C3",
        "C4",
        "C5",
        "C6",
        "C7",
        "C8",
        "C9"
      ],
      "properties": {
        "C1": {
          "$ref": "#/$defs/C1"
        },
        "C2": {
          "$ref": "#/$defs/C2"
        },
        "C3": {
          "$ref": "#/$defs/C3"
        },
        "C4": {
          "$ref": "#/$defs/C4"
        },
        "C5": {
          "$ref": "#/$defs/C5"
        },
        "C6": {
          "$ref": "#/$defs/C6"
        },
        "C7": {
          "$ref": "#/$defs/C7"
        },
        "C8": {
          "$ref": "#/$defs/C8"
        },
        "C9": {
          "$ref": "#/$defs/C9"
        }
      }
    },
    "repetition_metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "scope",
        "ngram_length",
        "whole_template_top1_max",
        "whole_template_top5_max",
        "suffix_top1_max",
        "ngram_record_share_max",
        "specification"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "ngram_length": {
          "type": "integer",
          "minimum": 1
        },
        "whole_template_top1_max": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "whole_template_top5_max": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "suffix_top1_max": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "ngram_record_share_max": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "specification": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
