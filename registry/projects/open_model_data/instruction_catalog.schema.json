{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Versioned instruction catalog for open-model-data E10",
  "description": "Structural and binding-role schema only; source relationships, language, reviews, concentration and training eligibility require external evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "version",
    "status",
    "training_eligible",
    "issue",
    "plan",
    "interpolation",
    "prefix_metric",
    "components",
    "repetition_metric",
    "review_status"
  ],
  "properties": {
    "schema_version": {
      "const": "instruction-catalog.v1"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[a-z0-9.-]+)?$"
    },
    "status": {
      "enum": [
        "draft",
        "approved",
        "rb1_amendment_pending_reviews"
      ]
    },
    "training_eligible": {
      "type": "boolean"
    },
    "issue": {
      "type": "integer",
      "minimum": 1
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "version",
        "body_sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "body_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "interpolation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "missing_field",
        "transformations",
        "recursive_interpolation",
        "scope",
        "field_mapping",
        "quoted_slot_policy",
        "empty_field_policy"
      ],
      "properties": {
        "mode": {
          "enum": [
            "verbatim_source_fields_only"
          ]
        },
        "missing_field": {
          "enum": [
            "withhold"
          ]
        },
        "transformations": {
          "enum": [
            "fixed_lossless_serialization_only"
          ]
        },
        "recursive_interpolation": {
          "type": "boolean",
          "const": false
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "field_mapping": {
          "type": "string",
          "minLength": 1
        },
        "quoted_slot_policy": {
          "type": "string",
          "minLength": 1
        },
        "empty_field_policy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "prefix_metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "scope",
        "prefix_lengths",
        "top1_max",
        "top5_max",
        "small_denominator",
        "specification"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "prefix_lengths": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "top1_max": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "top5_max": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "small_denominator": {
          "type": "string",
          "minLength": 1
        },
        "specification": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "C1",
        "C2",
        "C3",
        "C4",
        "C5",
        "C6",
        "C7",
        "C9"
      ],
      "properties": {
        "C1": {
          "$ref": "#/$defs/C1"
        },
        "C2": {
          "$ref": "#/$defs/C2"
        },
        "C3": {
          "$ref": "#/$defs/C3"
        },
        "C4": {
          "$ref": "#/$defs/C4"
        },
        "C5": {
          "$ref": "#/$defs/C5"
        },
        "C6": {
          "$ref": "#/$defs/C6"
        },
        "C7": {
          "$ref": "#/$defs/C7"
        },
        "C9": {
          "$ref": "#/$defs/C9"
        }
      }
    },
    "repetition_metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "scope",
        "ngram_length",
        "whole_template_top1_max",
        "whole_template_top5_max",
        "suffix_top1_max",
        "ngram_record_share_max",
        "specification"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "ngram_length": {
          "type": "integer",
          "minimum": 1
        },
        "whole_template_top1_max": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "whole_template_top5_max": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "suffix_top1_max": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "ngram_record_share_max": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "specification": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "review_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pa6",
        "amendment"
      ],
      "properties": {
        "pa6": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "issue",
            "pr",
            "reviewed_head",
            "reviewers",
            "remaining_gate"
          ],
          "properties": {
            "status": {
              "const": "instruction_reviews_approved"
            },
            "issue": {
              "const": 9611
            },
            "pr": {
              "const": 9679
            },
            "reviewed_head": {
              "const": "17dbf1e7"
            },
            "reviewers": {
              "const": [
                "claude-opus-5-5",
                "gemini-3.8-flash-high"
              ]
            },
            "remaining_gate": {
              "type": "string",
              "pattern": "\\S"
            }
          }
        },
        "amendment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "issue",
            "status",
            "author",
            "ukrainian_reviews",
            "code_review"
          ],
          "properties": {
            "issue": {
              "type": "integer",
              "minimum": 1
            },
            "status": {
              "enum": [
                "pending",
                "approved"
              ]
            },
            "author": {
              "type": "string",
              "pattern": "\\S"
            },
            "ukrainian_reviews": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "claude-opus-5-5",
                "gemini-3.8-flash-high"
              ],
              "properties": {
                "claude-opus-5-5": {
                  "enum": [
                    "pending",
                    "approved"
                  ]
                },
                "gemini-3.8-flash-high": {
                  "enum": [
                    "pending",
                    "approved"
                  ]
                }
              }
            },
            "code_review": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "claude-opus-5-5"
              ],
              "properties": {
                "claude-opus-5-5": {
                  "enum": [
                    "pending",
                    "approved"
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "C1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding",
        "source_fields",
        "required_context",
        "target_policy",
        "exclusions",
        "line_count",
        "line_count_rationale",
        "instructions"
      ],
      "properties": {
        "binding": {
          "type": "string",
          "minLength": 1
        },
        "source_fields": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sentence"
          ],
          "properties": {
            "sentence": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required_context": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "target_policy": {
          "type": "string",
          "minLength": 1
        },
        "exclusions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "line_count": {
          "type": "integer",
          "minimum": 10,
          "maximum": 12
        },
        "line_count_rationale": {
          "type": "string",
          "minLength": 1
        },
        "instructions": {
          "type": "array",
          "minItems": 10,
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "operation",
                  "template",
                  "slots"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^C1\\.sentence_correction\\.[0-9]{2}$"
                  },
                  "operation": {
                    "const": "sentence_correction"
                  },
                  "template": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^(?=[\\s\\S]*\\{sentence\\})(?:[^{}]|\\{(?:sentence)\\})+$"
                  },
                  "slots": {
                    "type": "array",
                    "uniqueItems": true,
                    "minItems": 1,
                    "maxItems": 1,
                    "items": {
                      "enum": [
                        "sentence"
                      ]
                    }
                  }
                }
              }
            ]
          },
          "allOf": [
            {
              "contains": {
                "type": "object",
                "required": [
                  "operation"
                ],
                "properties": {
                  "operation": {
                    "const": "sentence_correction"
                  }
                }
              },
              "minContains": 10,
              "maxContains": 12
            }
          ]
        }
      }
    },
    "C2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding",
        "source_fields",
        "required_context",
        "target_policy",
        "exclusions",
        "line_count",
        "line_count_rationale",
        "instructions",
        "serialization"
      ],
      "properties": {
        "binding": {
          "type": "string",
          "minLength": 1
        },
        "source_fields": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "lemma",
            "slot",
            "sense"
          ],
          "properties": {
            "lemma": {
              "type": "string",
              "minLength": 1
            },
            "slot": {
              "type": "string",
              "minLength": 1
            },
            "sense": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required_context": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "target_policy": {
          "type": "string",
          "minLength": 1
        },
        "exclusions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "line_count": {
          "type": "integer",
          "minimum": 20,
          "maximum": 24
        },
        "line_count_rationale": {
          "type": "string",
          "minLength": 1
        },
        "instructions": {
          "type": "array",
          "minItems": 20,
          "maxItems": 24,
          "uniqueItems": true,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "operation",
                  "template",
                  "slots",
                  "sense_variant"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^C2\\.agreed_form\\.[0-9]{2}$"
                  },
                  "operation": {
                    "const": "agreed_form"
                  },
                  "template": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^(?=[\\s\\S]*\\{lemma\\})(?=[\\s\\S]*\\{slot\\})(?:[^{}]|\\{(?:lemma|slot|sense)\\})+\\nЗначення: \\{sense\\}$"
                  },
                  "slots": {
                    "type": "array",
                    "uniqueItems": true,
                    "minItems": 3,
                    "maxItems": 3,
                    "items": {
                      "enum": [
                        "lemma",
                        "slot",
                        "sense"
                      ]
                    }
                  },
                  "sense_variant": {
                    "const": "with_sense"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "operation",
                  "template",
                  "slots",
                  "sense_variant"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^C2\\.agreed_form_without_sense\\.[0-9]{2}$"
                  },
                  "operation": {
                    "const": "agreed_form"
                  },
                  "template": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^(?![\\s\\S]*Значення:)(?=[\\s\\S]*\\{lemma\\})(?=[\\s\\S]*\\{slot\\})(?:[^{}]|\\{(?:lemma|slot)\\})+$"
                  },
                  "slots": {
                    "type": "array",
                    "uniqueItems": true,
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "enum": [
                        "lemma",
                        "slot"
                      ]
                    }
                  },
                  "sense_variant": {
                    "const": "without_sense"
                  }
                }
              }
            ]
          },
          "allOf": [
            {
              "contains": {
                "type": "object",
                "required": [
                  "operation",
                  "sense_variant"
                ],
                "properties": {
                  "operation": {
                    "const": "agreed_form"
                  },
                  "sense_variant": {
                    "const": "with_sense"
                  }
                }
              },
              "minContains": 10,
              "maxContains": 12
            },
            {
              "contains": {
                "type": "object",
                "required": [
                  "operation",
                  "sense_variant"
                ],
                "properties": {
                  "operation": {
                    "const": "agreed_form"
                  },
                  "sense_variant": {
                    "const": "without_sense"
                  }
                }
              },
              "minContains": 10,
              "maxContains": 12
            }
          ]
        },
        "serialization": {
          "const": {
            "header_slot": "c2-header-cells.v2",
            "target": "ordered_json_array_all_agreed_variants",
            "sense_visibility": "with_sense_variant_only",
            "empty_sense": "without_sense_if_equal_forms_and_no_group_parse_error",
            "parse_error_homonym": "withhold_group_empty_sense_records",
            "ambiguous_sense": "withhold_missing_or_non_discriminating",
            "specification": "docs/projects/open-model-data/instruction-catalog.md"
          }
        }
      }
    },
