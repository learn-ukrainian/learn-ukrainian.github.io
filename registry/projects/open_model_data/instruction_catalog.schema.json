                  "template",
                  "slots"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^C3\\.synonyms\\.[0-9]{2}$"
                  },
                  "operation": {
                    "const": "synonyms"
                  },
                  "template": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^(?=[\\s\\S]*\\{headword\\})(?:[^{}]|\\{(?:headword|sense)\\})+ Значення: \\{sense\\}$"
                  },
                  "slots": {
                    "type": "array",
                    "uniqueItems": true,
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "enum": [
                        "sense",
                        "headword"
                      ]
                    }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "operation",
                  "template",
                  "slots"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^C3\\.antonyms\\.[0-9]{2}$"
                  },
                  "operation": {
                    "const": "antonyms"
                  },
                  "template": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^(?=[\\s\\S]*\\{headword\\})(?:[^{}]|\\{(?:headword|sense)\\})+ Значення: \\{sense\\}$"
                  },
                  "slots": {
                    "type": "array",
                    "uniqueItems": true,
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "enum": [
                        "sense",
                        "headword"
                      ]
                    }
                  }
