                  },
                  "operation": {
                    "const": "idiom_definition"
                  },
                  "template": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^(?=[\\s\\S]*\\{idiom\\})(?:[^{}]|\\{(?:idiom)\\})+$"
