          "type": "object",
          "additionalProperties": false,
          "required": [
            "sentence"
          ],
          "properties": {
            "sentence": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required_context": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "target_policy": {
          "type": "string",
          "minLength": 1
        },
        "exclusions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "line_count": {
          "type": "integer",
          "minimum": 10,
          "maximum": 12
        },
        "line_count_rationale": {
          "type": "string",
          "minLength": 1
        },
        "instructions": {
          "type": "array",
          "minItems": 10,
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "operation",
                  "template",
                  "slots"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^C1\\.sentence_correction\\.[0-9]{2}$"
                  },
                  "operation": {
                    "const": "sentence_correction"
                  },
                  "template": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^(?=[\\s\\S]*\\{sentence\\})(?:[^{}]|\\{(?:sentence)\\})+$"
                  },
                  "slots": {
                    "type": "array",
                    "uniqueItems": true,
                    "minItems": 1,
                    "maxItems": 1,
                    "items": {
                      "enum": [
                        "sentence"
                      ]
                    }
                  }
                }
              }
            ]
          },
          "allOf": [
            {
              "contains": {
                "type": "object",
                "required": [
                  "operation"
                ],
                "properties": {
                  "operation": {
                    "const": "sentence_correction"
                  }
                }
              },
              "minContains": 10,
              "maxContains": 12
            }
          ]
        }
