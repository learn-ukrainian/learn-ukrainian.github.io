                  }
                }
              }
            ]
          },
          "allOf": [
            {
              "contains": {
                "type": "object",
                "required": [
                  "operation"
                ],
                "properties": {
                  "operation": {
                    "const": "synonyms"
                  }
                }
              },
              "minContains": 10,
              "maxContains": 12
            },
            {
              "contains": {
                "type": "object",
                "required": [
                  "operation"
                ],
