        },
        "instructions": {
          "type": "array",
          "minItems": 30,
          "maxItems": 36,
          "uniqueItems": true,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
