                  }
                }
              },
              "minContains": 10,
              "maxContains": 12
            }
          ]
        },
        "sense_definition_contract": {
          "const": {
            "context": "c3-sense-context.v1",
            "context_parts": [
              "register_labels",
              "sense_citations"
            ],
            "context_values": "verbatim_same_article_and_sense_source_order",
            "target": "verbatim_same_sense_definition",
            "applicability": "withhold_missing_slots_quarantined_articles_or_non_discriminating_context",
            "specification": "docs/projects/open-model-data/instruction-catalog.md"
          }
        }
      }
    },
    "C4": {
      "type": "object",
      "additionalProperties": false,
      "required": [
