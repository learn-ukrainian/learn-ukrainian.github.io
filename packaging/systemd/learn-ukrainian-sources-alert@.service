[Unit]
Description=Record a learn-ukrainian-sources failure for the Fleet Comms cto channel (%i)
# Started by OnFailure= in learn-ukrainian-sources.service; %i is that unit's
# name. Local and quick (#10674): it writes one safe-field record and never
# talks to Fleet Comms, so it is finished long before the next failure can
# trigger it again. The publisher sends the record.
OnSuccess=learn-ukrainian-sources-alert-publish.service

[Service]
Type=oneshot
WorkingDirectory=@REPO_ROOT@
TimeoutStartSec=30
UMask=0077
StateDirectory=learn-ukrainian-sources-alerts
StateDirectoryMode=0700
ExecStart=@REPO_ROOT@/.venv/bin/python -m scripts.orchestration.sources_failure_alert record %i --sources-state-dir %S/learn-ukrainian-sources
