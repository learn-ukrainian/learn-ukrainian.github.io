[Unit]
Description=Learn Ukrainian MCP Sources server (loopback)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# This unit runs in the operator's per-user systemd manager, which holds no
# capabilities. Only hardening that needs none is set here: the umask, the
# no_new_privs bit and seccomp filters, all applied for a user unit.
# Deliberately absent (systemd.exec(5), sandboxing in user services):
# - CapabilityBoundingSet=: dropping the bounding set needs CAP_SETPCAP, so
#   every start fails with status=218/CAPABILITIES.
# - PrivateMounts=, PrivateTmp=, ProtectSystem=, ProtectHome=: a user manager
#   can only build these mount namespaces inside an unprivileged user
#   namespace. Where the host restricts those (AppArmor userns restriction),
#   systemd skips the mounts and the setting is silently a no-op. The unit
#   also needs its checkout under the owner's home.
# - ProtectProc=, ProcSubset=: documented as system-service only.
UMask=0077
NoNewPrivileges=yes
SystemCallFilter=~@debug
RestrictSUIDSGID=yes
LockPersonality=yes
# Both V4 switches default off; a private deployment drop-in enables them.
Environment=HRAMATKA_V4_EXECUTION_ENABLED=0
Environment=HRAMATKA_V4_ADMISSION_ENABLED=0
WorkingDirectory=@REPO_ROOT@
Environment=PYTHONUNBUFFERED=1
ExecStart=@REPO_ROOT@/.venv/bin/python .mcp/servers/sources/server.py --standalone --host 127.0.0.1 --port 8766
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
