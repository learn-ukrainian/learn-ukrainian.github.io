[Unit]
Description=Learn Ukrainian daily temp scratch sweep and batch_state staleness report

[Service]
Type=oneshot
WorkingDirectory=@REPO_ROOT@
# Read-only report first; then reap quiet, unreferenced scratch (#9737).
ExecStart=@REPO_ROOT@/.venv/bin/python -m scripts.hygiene.batch_state_retention
ExecStart=@REPO_ROOT@/.venv/bin/python -m scripts.hygiene.tmp_sweep --unattributed-scratch --apply --summary
TimeoutStartSec=3600
TimeoutStopSec=300
Nice=15
IOSchedulingClass=idle
# No network. A user manager accepts PrivateNetwork= and IPAddressDeny=
# without enforcing them; the seccomp address-family filter is enforced.
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
