[Unit]
Description=Bounded foreground Git maintenance

[Service]
Type=oneshot
WorkingDirectory=@REPO_ROOT@
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/env bash @REPO_ROOT@/scripts/orchestration/run_scheduled_worktree_cleanup.sh --repo-root @REPO_ROOT@ --repo-root @PRIVATE_ROOT@ --git-maintenance --apply
MemoryHigh=1536M
MemoryMax=2G
MemorySwapMax=0
CPUQuota=100%
TasksMax=32
Nice=15
IOSchedulingClass=idle
TimeoutStartSec=1300
TimeoutStopSec=10
KillMode=control-group
