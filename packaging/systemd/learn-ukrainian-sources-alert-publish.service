[Unit]
Description=Publish recorded learn-ukrainian-sources failures to the Fleet Comms cto channel
# Started by OnSuccess= in learn-ukrainian-sources-alert@.service (#10674).
# Sends every pending record with a stable idempotency key, then deletes it;
# a failed publish keeps its record and the unit retries, at most 6 runs an
# hour. Records left after that wait for the next failure or a manual start.
StartLimitIntervalSec=1h
StartLimitBurst=6

[Service]
Type=oneshot
WorkingDirectory=@REPO_ROOT@
TimeoutStartSec=180
UMask=0077
StateDirectory=learn-ukrainian-sources-alerts
StateDirectoryMode=0700
ExecStart=@REPO_ROOT@/.venv/bin/python -m scripts.orchestration.sources_failure_alert publish
Restart=on-failure
RestartSec=60
