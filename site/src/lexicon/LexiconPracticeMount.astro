---
import LexiconPractice from '../components/LexiconPractice';
import ChromeText from '../components/chrome/ChromeText.astro';
---

<div id="lexicon-practice-mount" data-lexicon-practice-island>
  <!--
    #6715: client:only renders nothing until the bundle downloads and hydrates,
    so first paint used to be an empty <main>. This static shell is SSR'd with
    the page and hidden by the inline script once React content appears (or the
    fallback takes over), keeping session behavior after hydrate unchanged.
  -->
  <div
    id="lexicon-practice-shell"
    class="lexicon-practice-shell"
    role="status"
    aria-busy="true"
  >
    <div class="lexicon-practice-shell-skeleton" aria-hidden="true">
      <div class="lexicon-practice-skel-line wide"></div>
      <div class="lexicon-practice-skel-line"></div>
      <div class="lexicon-practice-skel-block"></div>
      <div class="lexicon-practice-skel-line mid"></div>
    </div>
    <p>Завантаження практики…</p>
  </div>
  <LexiconPractice client:only="react" />
</div>

<div id="lexicon-practice-fallback" class="lexicon-practice-fallback" hidden>
  <p id="lexicon-practice-error"><ChromeText k="practice.loadError" /></p>
  <button type="button" onclick="location.reload()">
    <ChromeText k="practice.retry" />
  </button>
</div>

<script is:inline>
(() => {
  const mount = document.getElementById('lexicon-practice-mount');
  const shell = document.getElementById('lexicon-practice-shell');
  const fallback = document.getElementById('lexicon-practice-fallback');
  const errorMessage = document.getElementById('lexicon-practice-error');
  if (!mount || !fallback) return;

  const island = mount.querySelector('astro-island');
  const SUCCESS_SEL = '.lexicon-practice';
  const RETRY_DELAY_MS = 30000;
  let settled = false;
  let retryTimer;

  function hideShell() {
    if (shell) shell.setAttribute('hidden', '');
  }

  function cleanup() {
    clearTimeout(retryTimer);
    observer.disconnect();
    document.removeEventListener('astro:hydrate', onHydrate, true);
    document.removeEventListener('astro:hydration-error', onError, true);
    document.removeEventListener('astro:before-swap', dispose);
  }

  function markSuccess() {
    if (settled) return;
    settled = true;
    hideShell();
    mount.removeAttribute('hidden');
    fallback.setAttribute('hidden', '');
    cleanup();
  }

  function showFallback() {
    if (settled) return;
    clearTimeout(retryTimer);
    hideShell();
    mount.setAttribute('hidden', '');
    if (errorMessage) errorMessage.removeAttribute('hidden');
    fallback.removeAttribute('hidden');
    // Keep observing: successful hydration can still recover without a reload.
  }

  function isOurIsland(event) {
    return event.target instanceof Node && mount.contains(event.target);
  }

  function onHydrate(event) {
    if (isOurIsland(event)) markSuccess();
  }

  function onError(event) {
    const componentUrl = island?.getAttribute('component-url');
    if (isOurIsland(event) || (
      event.target === document && componentUrl && event.detail?.componentUrl === componentUrl
    )) showFallback();
  }

  function dispose() {
    settled = true;
    cleanup();
  }

  const observer = new MutationObserver(() => {
    if (mount.querySelector(SUCCESS_SEL)) markSuccess();
  });
  observer.observe(mount, { childList: true, subtree: true });
  document.addEventListener('astro:hydrate', onHydrate, true);
  document.addEventListener('astro:hydration-error', onError, true);
  document.addEventListener('astro:before-swap', dispose, { once: true });

  // Elapsed time is not proof of failure: dependencies may still be downloading
  // after the entry chunk completes. Offer retry once without hiding the island
  // or replacing its loading status; actual hydration/error events own the UI.
  retryTimer = setTimeout(() => {
    if (mount.querySelector(SUCCESS_SEL)) {
      markSuccess();
      return;
    }
    if (errorMessage) errorMessage.setAttribute('hidden', '');
    fallback.removeAttribute('hidden');
  }, RETRY_DELAY_MS);

  if (mount.querySelector(SUCCESS_SEL)) markSuccess();
})();
</script>

<style is:global>
.lexicon-practice-shell {
  display: grid;
  gap: 0.85rem;
  max-width: 760px;
  padding: 1rem 0;
}
.lexicon-practice-shell[hidden] {
  display: none;
}
.lexicon-practice-shell-skeleton {
  display: grid;
  gap: 0.65rem;
}
.lexicon-practice-skel-line,
.lexicon-practice-skel-block {
  border-radius: 6px;
  background: linear-gradient(
    90deg,
    color-mix(in srgb, var(--lu-border, #ddd) 65%, transparent),
    color-mix(in srgb, var(--lu-border, #ddd) 35%, transparent),
    color-mix(in srgb, var(--lu-border, #ddd) 65%, transparent)
  );
  background-size: 200% 100%;
  animation: lexicon-practice-shimmer 1.2s ease-in-out infinite;
}
.lexicon-practice-skel-line {
  height: 0.9rem;
  width: 70%;
}
.lexicon-practice-skel-line.wide {
  width: 92%;
}
.lexicon-practice-skel-line.mid {
  width: 55%;
}
.lexicon-practice-skel-block {
  height: 9rem;
  width: 100%;
}
@keyframes lexicon-practice-shimmer {
  0% {
    background-position: 100% 0;
  }
  100% {
    background-position: -100% 0;
  }
}
@media (prefers-reduced-motion: reduce) {
  .lexicon-practice-skel-line,
  .lexicon-practice-skel-block {
    animation: none;
  }
}
.lexicon-practice-shell p {
  margin: 0;
  color: var(--lu-text-muted);
  font-weight: 700;
  line-height: 1.5;
}
.lexicon-practice-fallback {
  display: grid;
  gap: 0.75rem;
  padding: 1rem;
  border: 1px solid var(--lu-border);
  border-radius: 12px;
  background: var(--lu-surface-raised);
}
.lexicon-practice-fallback[hidden] {
  display: none;
}
.lexicon-practice-fallback p {
  margin: 0 0 0.5rem;
  color: var(--lu-text);
  line-height: 1.5;
}
.lexicon-practice-fallback button {
  justify-self: start;
  min-height: 44px;
  padding: 0.5rem 1rem;
  border: 1px solid var(--lu-border);
  border-radius: 6px;
  background: var(--lu-surface);
  color: var(--lu-text);
  font: inherit;
  font-weight: 800;
  cursor: pointer;
}
.lexicon-practice-fallback button:hover,
.lexicon-practice-fallback button:focus-visible {
  border-color: var(--lu-primary);
  outline: 2px solid var(--lu-primary);
  outline-offset: 2px;
}
</style>
