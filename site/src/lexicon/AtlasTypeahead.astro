---
interface Props {
  id: string;
  label: string;
  placeholder?: string;
  containerClass?: string;
  labelClass?: string;
}

const {
  id,
  label,
  placeholder = "офіс / ofis / office",
  containerClass = "",
  labelClass = "atlas-typeahead-label sr-only",
} = Astro.props as Props;

const inputId = `${id}-input`;
const listId = `${id}-list`;
---

<div class:list={["atlas-typeahead", containerClass]} data-atlas-typeahead>
  <label for={inputId} class={labelClass}>{label}</label>
  <input
    id={inputId}
    type="search"
    class="atlas-typeahead-input"
    placeholder={placeholder}
    role="combobox"
    aria-expanded="false"
    aria-autocomplete="list"
    aria-haspopup="listbox"
    aria-controls={listId}
    autocomplete="off"
    spellcheck="false"
    data-atlas-typeahead-input
  />
  <ul
    id={listId}
    class="atlas-typeahead-list"
    role="listbox"
    aria-label="Результати пошуку"
    hidden
    data-atlas-typeahead-list
  ></ul>
</div>

<script>
  import { bindAtlasTypeaheads } from "../lib/lexicon/atlas-typeahead";

  bindAtlasTypeaheads(document);
</script>
