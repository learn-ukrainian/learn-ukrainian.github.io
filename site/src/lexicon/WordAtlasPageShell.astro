---
/**
 * Word Atlas page-state shell.
 *
 * `ready` delegates to WordAtlasArticle with zero extra DOM. Other states are
 * dormant (no scoped CSS / no global imports) so a later client reader can
 * reuse this shell without changing ready-page HTML assets.
 *
 * PR3 slice 1: WordAtlasArticle is a pure React component rendered SSR-only
 * (no client: directive). AtlasTypeahead stays Astro so its search script still
 * boots on prerendered pages; etymology click handlers remain an is:inline script.
 */
import WordAtlasArticle from "./WordAtlasArticle";
import AtlasTypeahead from "./AtlasTypeahead.astro";
import type { WordAtlasPageState } from "../lib/lexicon/word-atlas-page-state";
import { atlasLinkCatalog } from "../lib/lexicon/atlas-link-catalog";

interface Props {
  state: WordAtlasPageState;
}

const { state } = Astro.props as Props;
---

{state.status === "ready" ? (
  <>
    <WordAtlasArticle
      record={state.record}
      generatedAt={state.generatedAt}
      manifestVersion={state.manifestVersion}
      atlasLinkCatalog={atlasLinkCatalog}
      partnerRecord={state.record.partnerRecord}
    >
      <AtlasTypeahead id="atlas-article-search" label="Шукати слово в Лексиконі" />
    </WordAtlasArticle>
    <script is:inline>
      (() => {
        function initAtlasInteractions() {
          const root = document.querySelector('[data-word-atlas]');
          if (!root) return;

          root.querySelectorAll('[data-ety-note]').forEach((stage) => {
            stage.addEventListener('click', () => {
              root.querySelectorAll('[data-ety-note]').forEach((item) => item.classList.remove('active'));
              stage.classList.add('active');
              const output = stage.closest('.atlas-section')?.querySelector('[data-ety-note-output]');
              if (output) {
                output.textContent = stage.dataset.etyNote || output.textContent;
                output.style.background = 'var(--teal-light)';
              }
            });
          });

          // Heteronym tab navigation
          const tabs = root.querySelectorAll('[data-heteronym-target]');
          const panels = root.querySelectorAll('[data-heteronym-idx]');
          if (!tabs.length || !panels.length) return;

          function activateHeteronymTab(index) {
            tabs.forEach((tab, i) => {
              const isSelected = i === index;
              tab.classList.toggle('active', isSelected);
              tab.setAttribute('aria-selected', isSelected ? 'true' : 'false');
              tab.tabIndex = isSelected ? 0 : -1;
            });
            panels.forEach((panel, i) => {
              const isSelected = i === index;
              panel.style.display = isSelected ? '' : 'none';
              panel.hidden = !isSelected;
            });
          }

          function selectHeteronymByHash() {
            const raw = decodeURIComponent(window.location.hash.replace(/^#/, '')).trim().normalize('NFC');
            if (!raw) return;
            tabs.forEach((tab, i) => {
              const hw = (tab.dataset.heteronymHeadword || '').normalize('NFC');
              const unaccented = hw.replace(/[\u0300-\u036f]/g, '');
              if (hw === raw || `${i + 1}` === raw || unaccented === raw) {
                activateHeteronymTab(i);
              }
            });
          }

          tabs.forEach((tab, i) => {
            tab.addEventListener('click', () => {
              activateHeteronymTab(i);
              const hw = tab.dataset.heteronymHeadword;
              if (hw && window.history?.replaceState) {
                window.history.replaceState(null, '', `#${encodeURIComponent(hw)}`);
              }
            });
            tab.addEventListener('keydown', (e) => {
              let nextIndex = null;
              if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
                nextIndex = (i + 1) % tabs.length;
              } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
                nextIndex = (i - 1 + tabs.length) % tabs.length;
              } else if (e.key === 'Home') {
                nextIndex = 0;
              } else if (e.key === 'End') {
                nextIndex = tabs.length - 1;
              }
              if (nextIndex !== null) {
                e.preventDefault();
                tabs[nextIndex].focus();
                tabs[nextIndex].click();
              }
            });
          });

          root.querySelectorAll('[data-heteronym-jump]').forEach((btn) => {
            btn.addEventListener('click', (e) => {
              e.preventDefault();
              const targetIdx = parseInt(btn.dataset.heteronymJump, 10);
              if (!isNaN(targetIdx) && tabs[targetIdx]) {
                tabs[targetIdx].click();
                tabs[targetIdx].scrollIntoView({ behavior: 'smooth', block: 'nearest' });
              }
            });
          });

          selectHeteronymByHash();
          window.addEventListener('hashchange', selectHeteronymByHash);
        }

        initAtlasInteractions();
        document.addEventListener('astro:page-load', initAtlasInteractions);
      })();
    </script>
  </>
) : state.status === "loading" ? (
  <div role="status" aria-busy="true" data-word-atlas-state="loading">
    <p>Завантаження статті Атласу…</p>
  </div>
) : state.status === "missing" ? (
  <div role="alert" data-word-atlas-state="missing" data-http-status="404">
    <h1 class="lu-i18n-block">
      <span data-loc="en">Word not found</span>
      <span data-loc="uk">Слово не знайдено</span>
    </h1>
    <p class="lu-i18n-block">
      <span data-loc="en">No public article for «{state.slug}».</span>
      <span data-loc="uk">Немає публічної статті для «{state.slug}».</span>
    </p>
    <p>
      <a href="/lexicon/">
        <span class="lu-i18n">
          <span data-loc="en">Back to Atlas</span>
          <span data-loc="uk">До Атласу</span>
        </span>
      </a>
      {" · "}
      <a href="/lexicon/#lexicon-landing-search">
        <span class="lu-i18n">
          <span data-loc="en">Search</span>
          <span data-loc="uk">Пошук</span>
        </span>
      </a>
    </p>
    <AtlasTypeahead id="atlas-missing-search" label="Шукати слово в Лексиконі" />
  </div>
) : state.status === "offline" ? (
  <div role="alert" data-word-atlas-state="offline" data-http-status="503">
    <h1>Атлас тимчасово недоступний</h1>
    <p>{state.message}</p>
    {state.retryable ? (
      <p><button type="button" data-word-atlas-retry>Спробувати знову</button></p>
    ) : null}
  </div>
) : (
  <div role="alert" data-word-atlas-state="version-mismatch" data-http-status="409">
    <h1>Версія даних змінилася</h1>
    <p>
      Очікувалась {state.expectedVersion}
      {state.actualVersion ? `, зараз ${state.actualVersion}` : ""}.
    </p>
    <p><button type="button" data-word-atlas-retry>Оновити</button></p>
  </div>
)}

<script>
  import { mountAtlasPronunciation, unmountAtlasPronunciation } from "../lib/lexicon/pronunciation-player";
  mountAtlasPronunciation();
  document.addEventListener("astro:page-load", mountAtlasPronunciation);
  document.addEventListener("astro:before-swap", unmountAtlasPronunciation);
  window.addEventListener("pagehide", unmountAtlasPronunciation);
  window.addEventListener("pageshow", mountAtlasPronunciation);
</script>
