---
import CourseLayout from '../../layouts/CourseLayout.astro';
import WordAtlasPageShell from '../../lexicon/WordAtlasPageShell.astro';
import WordCardPreview from '../../lexicon/WordCardPreview';
import type { PreviewCard } from '../../lib/lexicon/word-card-preview';
import type { EntryRecord } from '../../lib/lexicon/atlas-data-source';
import type { LoadedRelease, ReleaseCard } from '../../lib/lexicon/word-card-release';
import type { ReleasePage } from '../../lib/lexicon/word-card-readable';
import '../../styles/word-card-preview.css';
import { releasePreviewInputs, type PreviewInput } from '../../lib/lexicon/word-card-preview-inputs';

export async function getStaticPaths() {
  if (process.env.ATLAS_WORD_CARD_PREVIEW !== '1') return [];
  const samples: PreviewInput[] = [];
  // Vite removes this import entirely from builds without the explicit test flag.
  if (import.meta.env.PUBLIC_ATLAS_WORD_CARD_PREVIEW_CONTROLS === '1') {
    const { previewInputs } = await import('../../../tests/fixtures/word-card-preview/inputs');
    samples.push(...await previewInputs());
  }
  samples.push(...releasePreviewInputs({ enabled: true,
    controlled: import.meta.env.PUBLIC_ATLAS_WORD_CARD_PREVIEW_CONTROLS === '1',
    artifactPath: process.env.ATLAS_WORD_CARD_RELEASE_PATH, pin: process.env.ATLAS_WORD_CARD_RELEASE_PIN }));
  return samples.flatMap(sample => [false, true].map(compare => ({
    params: { path: `${compare ? 'compare/' : ''}${sample.name}` },
    props: { ...sample, compare },
  })));
}
interface Props {
  card: PreviewCard | ReleaseCard | ReleasePage | LoadedRelease; current: EntryRecord | null; compare: boolean;
  fingerprint: string; source: string; generatedAt: string; manifestVersion: string;
}
const { card, current, compare, fingerprint, source, generatedAt, manifestVersion } = Astro.props;
const page = card.kind === 'release-page' ? card.page : null;
---
<CourseLayout title={page ? `${page.title} — word-card preview` : 'Word-card preview'} description="Pinned candidate release preview" currentPath={Astro.url.pathname} wide showHero={false}>
  <meta slot="head" name="robots" content="noindex, nofollow" />
  <main class="word-card-preview">
    {page ? <>
      <aside role="note" data-preview-banner class="compact">CANDIDATE preview, not certified learner cards.</aside>
      <h1 lang="uk">{page.title}</h1>
      {compare && <p>Current / candidate comparison</p>}
    </> : <>
      <aside role="note" data-preview-banner>Optional noindex preview, not certified learner cards. Producer status is not linguistic certification or switch approval.</aside>
      <h1>{compare ? 'Current / candidate comparison' : 'Word-card preview'}</h1>
      <p>Input: {source}. SHA-256: <code data-input-hash>{fingerprint}</code></p>
      <p>{card.kind === 'release-card' || card.kind === 'release' ? 'Pinned release preview. Publication and switch gates remain separate.' : 'Real data unavailable. Data #10516 owns the certified export. Atlas retains deployed preview, accepted better/worse evidence and page-switch gates.'}</p>
    </>}
    <div class:list={['preview-columns', { comparison: compare }]}>
      {compare && <section aria-label="Current presentation"><h2>Current presentation</h2>
        {current ? <WordAtlasPageShell state={{ status: 'ready', record: current, generatedAt, manifestVersion }} /> : <p>Unavailable: unresolved identity pairing.</p>}
      </section>}
      <section aria-label="Candidate presentation"><WordCardPreview card={card} current={current} compare={compare} /></section>
    </div>
    {page && <p class="input-line">Input: {source}. SHA-256: <code data-input-hash>{fingerprint}</code>. Producer status is not linguistic certification or switch approval.</p>}
  </main>
</CourseLayout>
<style>
  .word-card-preview { padding: 1.5rem; }
  aside { border: 2px solid currentColor; padding: 1rem; }
  aside.compact { padding: .25rem .75rem; font-size: .9rem; }
  .input-line { font-size: .85rem; overflow-wrap: anywhere; }
  .comparison { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 1.5rem; }
  .preview-columns > section { min-width: 0; overflow: auto; }
  .word-card-preview :global(pre) { white-space: pre-wrap; overflow-wrap: anywhere; }
  .word-card-preview :global(td), .word-card-preview :global(th) { vertical-align: top; padding: .5rem; border: 1px solid currentColor; }
  @media (max-width: 60rem) { .comparison { grid-template-columns: minmax(0, 1fr); } }
</style>
