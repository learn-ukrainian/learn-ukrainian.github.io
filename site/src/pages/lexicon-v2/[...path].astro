---
import CourseLayout from '../../layouts/CourseLayout.astro';
import WordAtlasPageShell from '../../lexicon/WordAtlasPageShell.astro';
import AtlasTypeahead from '../../lexicon/AtlasTypeahead.astro';
import WordCardPreview, { candidateSearchVisible, cardHeading } from '../../lexicon/WordCardPreview';
import type { PreviewCard } from '../../lib/lexicon/word-card-preview';
import type { EntryRecord } from '../../lib/lexicon/atlas-data-source';
import type { LoadedRelease, ReleaseCard, ReleaseIndex } from '../../lib/lexicon/word-card-release';
import { readableEntry, type ReleasePage } from '../../lib/lexicon/word-card-readable';
import '../../styles/word-card-preview.css';
import { previewIndexPaths, previewStaticPaths, releasePreviewInputs, type PreviewInput } from '../../lib/lexicon/word-card-preview-inputs';

export async function getStaticPaths() {
  if (process.env.ATLAS_WORD_CARD_PREVIEW !== '1') return [];
  const samples: PreviewInput[] = [];
  // Vite removes this import entirely from builds without the explicit test flag.
  if (import.meta.env.PUBLIC_ATLAS_WORD_CARD_PREVIEW_CONTROLS === '1') {
    const { previewInputs } = await import('../../../tests/fixtures/word-card-preview/inputs');
    samples.push(...await previewInputs());
  }
  samples.push(...releasePreviewInputs({ enabled: true,
    controlled: import.meta.env.PUBLIC_ATLAS_WORD_CARD_PREVIEW_CONTROLS === '1',
    artifactPath: process.env.ATLAS_WORD_CARD_RELEASE_PATH, pin: process.env.ATLAS_WORD_CARD_RELEASE_PIN }));
  return [...previewStaticPaths(samples), ...previewIndexPaths(samples)];
}
interface Props {
  card: PreviewCard | ReleaseCard | ReleasePage | ReleaseIndex | LoadedRelease; current: EntryRecord | null; compare: boolean;
  fingerprint: string; source: string; generatedAt: string; manifestVersion: string;
}
const { card, current, compare, fingerprint, source, generatedAt, manifestVersion } = Astro.props;
const page = card.kind === 'release-page' ? card.page : null;
const singleHead = card.kind === 'release-card' ? cardHeading(readableEntry(card.row, 1)) : null;
const index = card.kind === 'release-index';
const showCandidateSearch = candidateSearchVisible(Astro.params.path ?? '');
const pinned = card.kind === 'release-card' || card.kind === 'release' || index;
const readableTitle = page ? page.title : singleHead ? singleHead.title : null;
---
<CourseLayout title={readableTitle ? `${readableTitle} — word-card preview` : index ? 'Word cards' : 'Word-card preview'} description="Pinned candidate release preview" currentPath={Astro.url.pathname} wide showHero={false}>
  <meta slot="head" name="robots" content="noindex, nofollow" />
  <main class="word-card-preview">
    {page ? <>
      <aside role="note" data-preview-banner class="compact">CANDIDATE preview, not certified learner cards.</aside>
      <h1 lang="uk">{page.title}</h1>
      {compare && <p>Current / candidate comparison</p>}
    </> : singleHead && card.kind === 'release-card' ? <>
      <aside role="note" data-preview-banner class="compact">
        {card.row.status === 'CANDIDATE' ? 'CANDIDATE preview, not certified learner cards.' : 'Optional noindex preview, not certified learner cards.'}
      </aside>
      <h1 lang={singleHead.hasText ? 'uk' : undefined}>{singleHead.title}</h1>
      {compare && <p>Current / candidate comparison</p>}
    </> : <>
      <aside role="note" data-preview-banner>Optional noindex preview, not certified learner cards. Producer status is not linguistic certification or switch approval.</aside>
      <h1>{index ? 'Word cards' : compare ? 'Current / candidate comparison' : 'Word-card preview'}</h1>
      <p>Input: {source}. SHA-256: <code data-input-hash>{fingerprint}</code></p>
      <p>{pinned ? 'Pinned release preview. Publication and switch gates remain separate.' : 'Real data unavailable. Data #10516 owns the certified export. Atlas retains deployed preview, accepted better/worse evidence and page-switch gates.'}</p>
    </>}
    <div class:list={['preview-columns', { comparison: compare }]}>
      {compare && <section aria-label="Current presentation"><h2>Current presentation</h2>
        {current ? <WordAtlasPageShell state={{ status: 'ready', record: current, generatedAt, manifestVersion }} /> : <p>Unavailable: unresolved identity pairing.</p>}
      </section>}
      <section aria-label="Candidate presentation">
        {showCandidateSearch && <div class="word-switch">
          <AtlasTypeahead id="atlas-candidate-search" label="Шукати слово в Лексиконі" />
          <a class="atlas-button filter" href="/lexicon/">До Атласу</a>
          <span class="poc-label">Атлас слів (Лексикон)</span>
        </div>}
        <WordCardPreview card={card} current={current} compare={compare} />
      </section>
    </div>
    {readableTitle && <p class="input-line">Input: {source}. SHA-256: <code data-input-hash>{fingerprint}</code>. Producer status is not linguistic certification or switch approval.</p>}
  </main>
</CourseLayout>
<script>
  function initCreditMarkers() {
    document.querySelectorAll('[data-release-page], [data-release-card]').forEach(root => {
      root.querySelectorAll<HTMLAnchorElement>('a[data-credit-ref]').forEach(marker => {
        if (marker.dataset.creditBound === 'true') return;
        const target = Array.from(root.querySelectorAll('[data-source-credit]'))
          .find(credit => `#${credit.id}` === marker.getAttribute('href'));
        const details = target?.closest('details[data-page-audit], details[data-card-audit]');
        if (!(details instanceof HTMLDetailsElement)) return;
        marker.addEventListener('click', () => { details.open = true; });
        marker.dataset.creditBound = 'true';
      });
    });
  }
  function openHashTarget() {
    if (location.hash.length <= 1) return;
    const rawId = location.hash.slice(1);
    let target = document.getElementById(rawId);
    if (!target) {
      try {
        const decoded = decodeURIComponent(rawId);
        if (decoded !== rawId) target = document.getElementById(decoded);
      } catch { return; }
    }
    if (!target || !target.closest('.word-card-preview')) return;
    let opened = false;
    let current: Element | null = target.closest('details');
    while (current instanceof HTMLDetailsElement) {
      if (!current.open) { current.open = true; opened = true; }
      current = current.parentElement?.closest('details') ?? null;
    }
    if (opened) target.scrollIntoView();
  }
  initCreditMarkers();
  openHashTarget();
  document.addEventListener('astro:page-load', () => { initCreditMarkers(); openHashTarget(); });
  window.addEventListener('hashchange', openHashTarget);
</script>
<style>
  .word-card-preview { padding: 1.5rem; }
  aside { border: 2px solid currentColor; padding: 1rem; }
  aside.compact { padding: .25rem .75rem; font-size: .9rem; }
  .input-line { font-size: .85rem; overflow-wrap: anywhere; }
  .comparison { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 1.5rem; }
  .preview-columns > section { min-width: 0; overflow: auto; }
  .word-card-preview :global(pre) { white-space: pre-wrap; overflow-wrap: anywhere; }
  .word-card-preview :global(td), .word-card-preview :global(th) { vertical-align: top; padding: .5rem; border: 1px solid currentColor; }
  .word-card-preview :global(.wc-missing) { font-style: italic; }
  .word-card-preview :global(.wc-cefr-badge) { display: inline-block; border: 1px solid currentColor; border-radius: .25rem; padding: 0 .4rem; font-weight: 600; }
  @media (max-width: 60rem) { .comparison { grid-template-columns: minmax(0, 1fr); } }
</style>
