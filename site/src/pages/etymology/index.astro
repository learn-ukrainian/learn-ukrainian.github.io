---
/**
 * Etymology redirect / moved page at /etymology/.
 *
 * Etymology entries are integrated directly into Word Atlas (/lexicon/<lemma>/#etymology).
 * This page cleanly redirects learners to Word Atlas and provides a direct navigation link.
 */
import CourseLayout from '../../layouts/CourseLayout.astro';

const frontmatter = {
  title: 'Етимологія · Атлас слів',
  description: 'Етимологічні довідки перенесено до Атласу слів (/lexicon/).',
};
---

<CourseLayout
  title={frontmatter.title}
  description={frontmatter.description}
  eyebrow="Word Atlas"
  subtitle="Етимологічні довідки доступні у статтях Атласу слів."
  currentPath="/etymology/"
  heroVariant="lexicon"
>
  <meta slot="head" http-equiv="refresh" content="0; url=/lexicon/" />
  <script slot="head" is:inline>
    if (typeof window !== 'undefined' && window.location.pathname.startsWith('/etymology')) {
      window.location.replace('/lexicon/');
    }
  </script>

  <div class="etymology-moved-card">
    <span class="state-code">Moved to Word Atlas</span>
    <h2>Етимологію перенесено до Атласу слів</h2>
    <p class="lead">
      Етимологічні довідки, праслов'янські корені та когнати тепер доступні безпосередньо
      у статтях <strong>Атласу слів</strong>.
    </p>
    <div class="state-actions">
      <a class="primary-btn" href="/lexicon/">Перейти до Атласу слів →</a>
      <a class="secondary-btn" href="/search/">Пошук по курсу</a>
    </div>
  </div>
</CourseLayout>

<style>
  .etymology-moved-card {
    margin: 2rem 0;
    padding: 2rem;
    border: 1px solid var(--lu-border);
    border-radius: 12px;
    background: var(--lu-surface-raised);
    box-shadow: var(--lu-shadow);
  }
  .state-code {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--lu-primary);
    margin-bottom: 0.5rem;
  }
  .etymology-moved-card h2 {
    margin-top: 0;
    margin-bottom: 0.75rem;
    color: var(--lu-text);
  }
  .lead {
    font-size: var(--sl-text-lg);
    color: var(--sl-color-gray-2);
    margin-bottom: 1.5rem;
  }
  .state-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .primary-btn,
  .secondary-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 1.25rem;
    border-radius: 8px;
    font-weight: 700;
    text-decoration: none;
  }
  .primary-btn {
    background: var(--lu-yellow);
    color: var(--lu-gray-900);
    border: none;
  }
  .secondary-btn {
    background: var(--lu-surface);
    color: var(--lu-text);
    border: 1px solid var(--lu-border);
  }
</style>
