---
/**
 * Атлас слів (Лексикон) — article detail route.
 *
 * Route semantics (GH #4385): the `[lemma]` param is an ENTRY slug, not a lemma
 * parameter. The value is always `entry.url_slug`, so multiword-term slugs
 * (e.g. `брати-взяти`, `іі-відміна`) resolve exactly like single-lemma slugs.
 * The Astro filename stays `[lemma].astro` (a later PR handles the rename); the
 * `entry_type` carried on each entry drives per-type rendering in the article
 * component.
 *
 * PR #2: SSG reads a pinned SqliteAtlasDataSource catalog snapshot and renders
 * from EntryRecord only (source-swappable; byte-identical to the legacy path).
 */
import CourseLayout from "../../layouts/CourseLayout.astro";
import WordAtlasPageShell from "../../lexicon/WordAtlasPageShell.astro";
import WordAtlasClientShell from "../../lexicon/WordAtlasClientShell";
import { buildAtlasStaticPaths } from "../../lib/lexicon/atlas-static-paths";
import { SqliteAtlasDataSource } from "../../lib/lexicon/sqlite-atlas-data-source";
import { atlasLinkCatalog } from "../../lib/lexicon/atlas-link-catalog";
import { buildAtlasLinkResolver } from "../../lib/lexicon/word-atlas-article-model";
import type { EntryRecord } from "../../lib/lexicon/atlas-data-source";
import type { WordAtlasPageState } from "../../lib/lexicon/word-atlas-page-state";

export async function getStaticPaths() {
  // Publisher builds (`npm run build`) set ATLAS_STATIC_ROUTES=1 after hydrate
  // so Astro prerenders from data/atlas.db. Shell/dev builds leave it unset and
  // serve the client shell from committed public projections.
  return buildAtlasStaticPaths();
}

const { record, generatedAt, manifestVersion } = Astro.props as Partial<{
  record: EntryRecord;
  generatedAt: string;
  manifestVersion: string;
}>;

if (record && !record.partnerRecord) {
  const enrichment = record.entry?.enrichment as
    | { verb_pedagogy?: { aspect_partner?: { url_slug?: string } } }
    | null
    | undefined;
  const rawPartnerSlug = enrichment?.verb_pedagogy?.aspect_partner?.url_slug?.trim();
  if (rawPartnerSlug && typeof process !== "undefined" && process.env.ATLAS_STATIC_ROUTES === "1") {
    const resolver = buildAtlasLinkResolver(
      atlasLinkCatalog,
      record.relations.map((relation) => relation.related_slug),
    );
    const resolvedPartnerSlug = resolver.resolveSlug(rawPartnerSlug, record.entry.url_slug);
    if (resolvedPartnerSlug) {
      try {
        const globalKey = Symbol.for("learn_ukrainian.ssg_source");
        const ssgSource: SqliteAtlasDataSource =
          ((globalThis as Record<symbol, any>)[globalKey] ??= new SqliteAtlasDataSource());
        const partnerResult = await ssgSource.getEntry(resolvedPartnerSlug);
        if (partnerResult.kind === "entry") {
          record.partnerRecord = partnerResult.record;
        }
      } catch {
        // Fail closed: partner lookup failure leaves partnerRecord null/undefined
      }
    }
  }
}
const entry = record?.entry;
const readyState = record && generatedAt && manifestVersion
  ? {
      status: "ready",
      record,
      generatedAt,
      manifestVersion,
    } satisfies WordAtlasPageState
  : undefined;
const baseUrl = import.meta.env.BASE_URL || "/";
const atlasAssetBase = `${baseUrl === "/" ? "" : baseUrl.replace(/\/$/, "")}/atlas`;
const frontmatter = {
  title: entry?.lemma ?? "Атлас слів",
  description: entry?.form_of
    ? `${entry.lemma} — форма слова «${entry.form_of.lemma}»`
    : entry?.gloss ? `${entry.lemma} — ${entry.gloss}` : "Стаття Лексикону",
};
---

<CourseLayout
  title={frontmatter.title}
  description={frontmatter.description}
  currentPath={entry ? `/lexicon/${entry.url_slug}/` : Astro.url.pathname}
  heroVariant="lexicon"
  wide
  showHero={false}
>
  {readyState ? (
    <WordAtlasPageShell state={readyState} />
  ) : (
    <WordAtlasClientShell
      client:only="react"
      baseUrl={baseUrl}
      assetBaseUrl={atlasAssetBase}
    />
  )}
</CourseLayout>
