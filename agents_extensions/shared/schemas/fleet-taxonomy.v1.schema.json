{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fleet-taxonomy.v1",
  "title": "Fleet taxonomy registry schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "areas"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "areas": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z0-9_-]+$": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "aliases",
            "epics"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9_-]+$"
            },
            "aliases": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9_-]+$"
              },
              "uniqueItems": true
            },
            "epics": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "number",
                  "name"
                ],
                "properties": {
                  "number": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
