{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "area-assignments.v1",
  "title": "Area assignments registry schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "assignments"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "assignments": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z0-9_-]+$": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "driver_agent_type",
            "slots"
          ],
          "properties": {
            "driver_agent_type": {
              "type": "string",
              "minLength": 1
            },
            "slots": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
