{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "lu-machinery-hook-v2 codex-session-setup",
            "timeout": 15,
            "statusMessage": "Checking learn-ukrainian session state",
            "additionalContextLimit": 1200
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "lu-machinery-hook-v2 codex-post-compact",
            "timeout": 15,
            "statusMessage": "Hydrating bound fleet-driver context",
            "additionalContextLimit": 800
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Bash|Write|Edit|MultiEdit|apply_patch)$",
        "hooks": [
          {
            "type": "command",
            "command": "lu-machinery-hook-v2 codex-pre-tool-use",
            "timeout": 45,
            "statusMessage": "Running Codex tool policy"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Bash|apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "lu-machinery-hook-v2 codex-post-tool-use",
            "timeout": 15,
            "statusMessage": "Recording Codex tool result"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "lu-machinery-hook-v2 codex-user-prompt-submit",
            "timeout": 5,
            "statusMessage": "Checking cross-agent inbox"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "lu-machinery-hook-v2 codex-goal-driver-stop",
            "timeout": 5,
            "statusMessage": "Checking goal-driver state"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "lu-machinery-hook-v2 codex-release-thread-lease",
            "timeout": 5,
            "statusMessage": "Releasing learn-ukrainian session state"
          }
        ]
      }
    ]
  }
}
