{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "(bash \"${LEARN_UKRAINIAN_PRIMARY_REPO_ROOT:?configured primary required}/.codex/hooks/session-setup.sh\") || exit 2",
            "timeout": 15,
            "statusMessage": "Checking learn-ukrainian session state",
            "additionalContextLimit": 1200
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "(CODEX_COMPACT_SESSION_START=1 bash \"${LEARN_UKRAINIAN_PRIMARY_REPO_ROOT:?configured primary required}/.codex/hooks/post-compact.sh\") || exit 2",
            "timeout": 15,
            "statusMessage": "Hydrating bound fleet-driver context",
            "additionalContextLimit": 800
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Bash|Write|Edit|MultiEdit|apply_patch)$",
        "hooks": [
          {
            "type": "command",
            "command": "(bash \"${LEARN_UKRAINIAN_PRIMARY_REPO_ROOT:?configured primary required}/scripts/agent_runtime/codex_hook_entry.sh\" pre-tool-use) || exit 2",
            "timeout": 45,
            "statusMessage": "Running Codex tool policy"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Bash|apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "(bash \"${LEARN_UKRAINIAN_PRIMARY_REPO_ROOT:?configured primary required}/scripts/agent_runtime/codex_hook_entry.sh\" post-tool-use) || exit 2",
            "timeout": 15,
            "statusMessage": "Recording Codex tool result"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "(bash \"${LEARN_UKRAINIAN_PRIMARY_REPO_ROOT:?configured primary required}/scripts/agent_runtime/codex_hook_entry.sh\" user-prompt-submit) || exit 2",
            "timeout": 5,
            "statusMessage": "Checking cross-agent inbox"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "(bash \"${LEARN_UKRAINIAN_PRIMARY_REPO_ROOT:?configured primary required}/.codex/hooks/goal-driver-stop.sh\") || exit 2",
            "timeout": 5,
            "statusMessage": "Checking goal-driver state"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "(bash \"${LEARN_UKRAINIAN_PRIMARY_REPO_ROOT:?configured primary required}/.codex/hooks/release-thread-lease.sh\") || exit 2",
            "timeout": 5,
            "statusMessage": "Releasing learn-ukrainian session state"
          }
        ]
      }
    ]
  }
}
