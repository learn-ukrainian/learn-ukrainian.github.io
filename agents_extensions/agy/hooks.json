{
  "pending-orders-announce": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "lu-machinery-hook-v2 agy-pending-orders",
        "timeout": 10
      }
    ]
  },
  "driver-state-pin": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "lu-machinery-hook-v2 agy-hook",
        "timeout": 10
      }
    ]
  },
  "driver-keep-driving": {
    "Stop": [
      {
        "type": "command",
        "command": "lu-machinery-hook-v2 agy-stop-hook",
        "timeout": 20
      }
    ]
  },
  "driver-no-ask-question": {
    "PreToolUse": [
      {
        "matcher": "ask_question",
        "hooks": [
          {
            "type": "command",
            "command": "lu-machinery-hook-v2 agy-pretool-hook",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "shell-secret-print-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "lu-machinery-hook-v2 agy-secret-print",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "primary-checkout-write-guard": {
    "PreToolUse": [
      {
        "matcher": "write_file|edit_file|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "lu-machinery-hook-v2 agy-primary-write",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
