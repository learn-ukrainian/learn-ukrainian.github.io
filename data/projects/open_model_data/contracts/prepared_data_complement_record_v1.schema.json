{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learn-ukrainian.github.io/schemas/open-model-data/prepared_data_complement_record_v1.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "ordinal", "record_id", "source_id", "work_id", "source_family", "inventory_asset_id", "dimensions", "content_sha256", "admission_evidence_state", "capability_evidence", "signals", "exact_duplicate", "near_duplicate", "heldout_contamination", "protection_state", "phase1_binding", "policy_binding", "locator_binding", "capabilities", "routes"],
  "properties": {
    "schema_version": {"const": "prepared_data_complement_record_v1"}, "ordinal": {"type": "integer", "minimum": 0},
    "record_id": {"$ref": "#/$defs/id"}, "source_id": {"$ref": "#/$defs/id"}, "work_id": {"$ref": "#/$defs/id"}, "source_family": {"type": "string", "minLength": 1}, "inventory_asset_id": {"type": "string", "minLength": 1},
    "dimensions": {"$ref": "#/$defs/dimensions"}, "content_sha256": {"$ref": "#/$defs/hash"}, "admission_evidence_state": {"$ref": "#/$defs/admission"}, "capability_evidence": {"$ref": "#/$defs/capabilityEvidence"}, "signals": {"$ref": "#/$defs/signals"}, "exact_duplicate": {"$ref": "#/$defs/exact"}, "near_duplicate": {"$ref": "#/$defs/near"}, "heldout_contamination": {"$ref": "#/$defs/heldout"},
    "protection_state": {"const": "not_classified_phase2"},
    "phase1_binding": {"type": "object", "additionalProperties": false, "required": ["record_sha256", "manifest_sha256", "receipt_sha256", "record_schema_sha256", "receipt_schema_sha256", "generator_sha256"], "properties": {"record_sha256": {"$ref": "#/$defs/hash"}, "manifest_sha256": {"$ref": "#/$defs/hash"}, "receipt_sha256": {"$ref": "#/$defs/hash"}, "record_schema_sha256": {"$ref": "#/$defs/hash"}, "receipt_schema_sha256": {"$ref": "#/$defs/hash"}, "generator_sha256": {"$ref": "#/$defs/hash"}}},
    "policy_binding": {"type": "object", "additionalProperties": false, "required": ["policy_id", "policy_sha256", "scope_id", "decision_id", "context"], "properties": {"policy_id": {"type": "string"}, "policy_sha256": {"$ref": "#/$defs/hash"}, "scope_id": {"type": "string"}, "decision_id": {"type": "string", "pattern": "^decision\\.[a-f0-9]{24}$"}, "context": {"$ref": "#/$defs/context"}}},
    "capabilities": {"$ref": "#/$defs/decisions"}, "locator_binding": {"type":"object","additionalProperties":false,"required":["locator_id","source_id","work_id","canonical_url","locator_row_sha256","locator_index_sha256"],"properties":{"locator_id":{"type":"string","pattern":"^locator\\.[a-f0-9]{24}$"},"source_id":{"$ref":"#/$defs/id"},"work_id":{"$ref":"#/$defs/id"},"canonical_url":{"type":["string","null"]},"locator_row_sha256":{"$ref":"#/$defs/hash"},"locator_index_sha256":{"$ref":"#/$defs/hash"}}}, "routes": {"type": "object", "additionalProperties": false, "required": ["capabilities", "representations"], "properties": {"capabilities": {"$ref": "#/$defs/capabilityRoutes"}, "representations": {"type": "object", "additionalProperties": false, "required": ["faithful", "loss_masked", "protected"], "properties": {"faithful": {"enum": ["candidate", "metadata_only"]}, "loss_masked": {"const": "not_classified_phase2"}, "protected": {"const": "not_classified_phase2"}}}}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z]+(?:\\.[a-z0-9_:-]+)*\\.[a-f0-9]{24}$"}, "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "count": {"type": "integer", "minimum": 0},
    "dimensions": {"type": "object", "additionalProperties": false, "required": ["period", "genre", "register", "origin"], "properties": {"period": {"type": "string"}, "genre": {"type": "string"}, "register": {"type": "string"}, "origin": {"type": "string"}}},
    "admission": {"type": "object", "additionalProperties": false, "required": ["provenance", "acquisition", "snapshot", "rights", "origin", "contamination"], "properties": {"provenance": {"type": "string"}, "acquisition": {"type": "string"}, "snapshot": {"type": "string"}, "rights": {"type": "string"}, "origin": {"type": "string"}, "contamination": {"type": "string"}}},
    "capabilityEvidence": {"type": "object", "additionalProperties": false, "required": ["rights_evidence", "origin_evidence", "contamination_evidence", "admission_disposition", "raw_text_redistribution", "local_model_learning", "model_training", "dataset_publication", "learning_view_emission"], "properties": {"rights_evidence": {"type": "string"}, "origin_evidence": {"type": "string"}, "contamination_evidence": {"type": "string"}, "admission_disposition": {"type": "string", "pattern": "^family_(?:all_[a-z_]+|mixed_or_unknown)$"}, "raw_text_redistribution": {"const": "not_decided_by_document_signal_manifest"}, "local_model_learning": {"const": "not_decided_by_document_signal_manifest"}, "model_training": {"const": "not_decided_by_document_signal_manifest"}, "dataset_publication": {"const": "not_decided_by_document_signal_manifest"}, "learning_view_emission": {"enum": ["not_emitted_by_admission_receipt", "not_determined_by_document_signal_manifest"]}}},
    "signals": {"type":"object","additionalProperties":false,"required":["counts","normalization","boilerplate"],"properties":{"counts":{"type":"object","additionalProperties":false,"required":["characters","utf8_bytes","lexical_words","lines","cyrillic","latin","digits","ukrainian_specific","russian_specific"],"properties":{"characters":{"$ref":"#/$defs/count"},"utf8_bytes":{"$ref":"#/$defs/count"},"lexical_words":{"$ref":"#/$defs/count"},"lines":{"$ref":"#/$defs/count"},"cyrillic":{"$ref":"#/$defs/count"},"latin":{"$ref":"#/$defs/count"},"digits":{"$ref":"#/$defs/count"},"ukrainian_specific":{"$ref":"#/$defs/count"},"russian_specific":{"$ref":"#/$defs/count"}}},"normalization":{"type":"object","additionalProperties":false,"required":["nfc_changed","nfkc_changed","apostrophe_variants","stress_marks","control_characters","replacement_characters"],"properties":{"nfc_changed":{"type":"boolean"},"nfkc_changed":{"type":"boolean"},"apostrophe_variants":{"$ref":"#/$defs/count"},"stress_marks":{"$ref":"#/$defs/count"},"control_characters":{"$ref":"#/$defs/count"},"replacement_characters":{"$ref":"#/$defs/count"}}},"boilerplate":{"type":"object","additionalProperties":false,"required":["repeated_nonblank_lines","url_like_tokens"],"properties":{"repeated_nonblank_lines":{"$ref":"#/$defs/count"},"url_like_tokens":{"$ref":"#/$defs/count"}}}}},
    "exact": {"type":"object","additionalProperties":false,"required":["group_id","count"],"properties":{"group_id":{"$ref":"#/$defs/id"},"count":{"type":"integer","minimum":1}}},
    "near": {"type":"object","additionalProperties":false,"required":["algorithm","fingerprint","bands","state"],"properties":{"algorithm":{"const":"nfkc-casefold-word-3gram-partition-minhash-v1"},"fingerprint":{"$ref":"#/$defs/hash"},"bands":{"type":"array","minItems":8,"maxItems":8,"items":{"type":"string","pattern":"^[a-f0-9]{16}$"}},"state":{"const":"unresolved_candidate_only_no_automatic_erasure"}}},
    "heldout": {"type":"object","additionalProperties":false,"required":["state","method","semantics"],"properties":{"state":{"enum":["matched","clear"]},"method":{"type":["string","null"]},"semantics":{"const":"signal_only_no_automatic_erasure"}}},
    "context": {"type": "object", "additionalProperties": false, "required": ["actor_scope", "destination_scope", "jurisdiction_scope", "decision_authority"], "properties": {"actor_scope": {"type": "string"}, "destination_scope": {"type": "string"}, "jurisdiction_scope": {"type": "string"}, "decision_authority": {"const": "evidence_record_not_legal_advice"}}},
    "decision": {"type": "object", "additionalProperties": false, "required": ["state", "evidence_refs", "missing_evidence_keys"], "properties": {"state": {"enum": ["evidenced", "unresolved", "blocked", "excluded"]}, "evidence_refs": {"type": "array", "items": {"type": "string"}}, "missing_evidence_keys": {"type": "array", "items": {"type": "string"}}}},
    "decisions": {"type": "object", "additionalProperties": false, "required": ["acquisition_retention", "local_preparation", "local_model_learning", "raw_redistribution", "derived_redistribution", "dataset_publication", "model_publication"], "properties": {"acquisition_retention": {"$ref": "#/$defs/decision"}, "local_preparation": {"$ref": "#/$defs/decision"}, "local_model_learning": {"$ref": "#/$defs/decision"}, "raw_redistribution": {"$ref": "#/$defs/decision"}, "derived_redistribution": {"$ref": "#/$defs/decision"}, "dataset_publication": {"$ref": "#/$defs/decision"}, "model_publication": {"$ref": "#/$defs/decision"}}},
    "capabilityRoutes": {"type": "object", "additionalProperties": false, "required": ["acquisition_retention", "local_preparation", "local_model_learning", "raw_redistribution", "derived_redistribution", "dataset_publication", "model_publication"], "properties": {"acquisition_retention": {"enum": ["candidate", "metadata_only", "blocked", "excluded"]}, "local_preparation": {"enum": ["candidate", "metadata_only", "blocked", "excluded"]}, "local_model_learning": {"enum": ["candidate", "metadata_only", "blocked", "excluded"]}, "raw_redistribution": {"enum": ["candidate", "metadata_only", "blocked", "excluded"]}, "derived_redistribution": {"enum": ["candidate", "metadata_only", "blocked", "excluded"]}, "dataset_publication": {"enum": ["candidate", "metadata_only", "blocked", "excluded"]}, "model_publication": {"enum": ["candidate", "metadata_only", "blocked", "excluded"]}}}
  }
}
