{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learn-ukrainian.github.io/schemas/open-model-data/phase3_heldout_label_transport_bundle_v1.schema.json",
  "title": "Private Phase 3 v2.1 heldout-label transport bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "text_free", "bindings", "packet_count", "row_count", "packets", "manifest_sha256"],
  "properties": {
    "schema_version": {"const": "phase3_heldout_label_manifest_v1"},
    "text_free": {"const": true},
    "bindings": {"$ref": "#/$defs/bindings"},
    "packet_count": {"type": "integer", "minimum": 1},
