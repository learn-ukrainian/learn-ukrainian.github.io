        "zero_heldout_cases_state": {"const": "BLOCKED_NOT_ZERO"},
        "builder_clearance": {"const": "positive_only_metadata_hashes"},
        "builder_receives_membership": {"const": false}, "derivation_callback_permitted": {"const": false},
        "private_steward_role": {"const": "evaluation_steward_only"},
