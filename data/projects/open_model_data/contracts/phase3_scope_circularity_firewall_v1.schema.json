      "properties": {
        "environment_binding": {"const": "PHASE3_EVAL_STEWARD_CONFIG"}, "file_mode": {"const": "0600"},
        "directory_mode": {"const": "0700"}, "self_hash_verified_config_and_pack_manifest": {"const": true},
        "uses_cycle007_storage_pack_proof": {"const": true},
        "rejects": {"const": ["symlink", "hardlink", "traversal", "owner_mismatch", "path_overlap", "inode_device_change", "ancestor_replacement", "post_pin_toctou"]},
        "public_output_text_free": {"const": true},
        "schemas": {
          "type": "object", "additionalProperties": false,
          "required": ["public_receipt", "private_corpus", "run_state"],
          "properties": {
            "public_receipt": {"$ref": "#/$defs/artifact"},
            "private_corpus": {"$ref": "#/$defs/artifact"},
            "run_state": {"$ref": "#/$defs/artifact"}
          }
        }
      }
