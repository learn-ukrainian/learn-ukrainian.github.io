      "required": ["terminal_codes", "batch_failure_outputs", "partial_denominator_permitted", "provider_calls", "labels_created", "gold_created", "training_performed"],
      "properties": {
        "terminal_codes": {"const": ["leakage", "uncertain_lineage", "graph_incompleteness", "hash_drift", "denominator_drift", "rights_provenance_corruption", "protected_damage", "custody_role_collision", "private_binding_unbound", "private_path_unsafe", "document_lineage_denominator_not_frozen", "unregistered_authority"]},
        "batch_failure_outputs": {"type": "object", "additionalProperties": false, "required": ["emitted", "promoted", "activated"], "properties": {"emitted": {"const": 0}, "promoted": {"const": 0}, "activated": {"const": 0}}},
        "partial_denominator_permitted": {"const": false}, "provider_calls": {"const": 0},
        "labels_created": {"const": 0}, "gold_created": {"const": 0}, "training_performed": {"const": false}
