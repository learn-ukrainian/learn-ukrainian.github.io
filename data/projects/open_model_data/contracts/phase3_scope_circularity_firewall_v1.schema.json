    },
    "den": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_units", "unknown_rights_blockers", "base_required_cells", "composite_required_cells", "coverage_blocked_cells", "not_applicable_cells", "rule_slots_R", "membership_hash_required", "canonical_order_required"],
      "properties": {
        "source_units": {"const": 57}, "unknown_rights_blockers": {"const": 39},
        "base_required_cells": {"const": 15}, "composite_required_cells": {"const": 16},
        "coverage_blocked_cells": {"const": 14}, "not_applicable_cells": {"const": 2},
        "rule_slots_R": {"const": 0}, "membership_hash_required": {"const": true},
        "canonical_order_required": {"const": true}
