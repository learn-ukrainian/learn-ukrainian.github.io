        "p1": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"const": "data/projects/open_model_data/evidence/phase3_p1_universe_freeze_v1.json"}, "sha256": {"const": "0b1cd81448b96b4e818aa1dedd7df7633ff88eb500bb4d6ac3668be02962a35b"}}},
        "p1_dialect_amendment": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"const": "data/projects/open_model_data/evidence/phase3_p1_dialect_regional_protection_amendment_v1.json"}, "sha256": {"const": "5a4b259f764a3d41499f0a989c02fed921c18b62c9831d361d18d19dcc948afa"}}},
        "p2": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"const": "data/projects/open_model_data/evidence/phase3_p2_canonical_contracts_v1.json"}, "sha256": {"const": "dc8dfdf207728ef386cea14ddb328289b2beee5159afb98bf076e5f117602ea3"}}},
        "near_duplicate_policy": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"const": "data/projects/open_model_data/evidence/correction_protection_near_duplicate_policy_v1.json"}, "sha256": {"const": "fa30e82d7a5f90b7bf4b58d3aef6106b255dda270e81459a91ba011489fdb4b4"}}}
