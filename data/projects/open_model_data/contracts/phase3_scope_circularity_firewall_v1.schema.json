        "pack_manifest_receipt_sha256": {"const": "2a883cb3e9a3b2ee673e397c8f5ba511f886f725bea980b2c982ca17f92a5e7d"},
        "object_set_sha256": {"const": "af94e8d12c075e1e5e1816de076327dd68a3fd5d5f06ec77debcbbd590bcc9ec"},
        "ordered_row_identity_commitment_sha256": {"const": "d873d7493c6cd276a9604954c9c7aa07e760ca4f47a276658fd28956d6fa940b"},
        "public_packet_count": {"const": 204}, "public_row_count": {"const": 10159},
        "physical_sidecar_count": {"const": 204}, "logical_sidecar_count": {"const": 408}, "object_count": {"const": 419},
        "private_binding_state": {"const": "BOUND"}, "fresh_private_materialization_claimed": {"const": true},
        "private_graph_commitment_sha256": {"const": "de77b0e2444365e3c9cdec3441128f87b96ca8a15f897e4c769f9b840ccac398"},
        "component_count": {"const": 38}, "document_work_edition_group_count": {"const": 39},
        "exact_fingerprint_count": {"const": 10155}, "candidate_clearance_count": {"const": 0},
        "same_uid_role_isolation": {"const": "governance_limited_not_cryptographic"},
        "concept_reuse": {"const": "independent_origin_only_without_cycle007_identity_or_membership"},
        "authority_reuse": {"const": "citation_only_without_heldout_span_locator_annotation_or_membership"}
      }
    },
    "fail": {
