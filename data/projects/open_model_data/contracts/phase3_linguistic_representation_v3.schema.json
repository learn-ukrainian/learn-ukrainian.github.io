{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learn-ukrainian.github.io/schemas/open-model-data/phase3_linguistic_representation_v3.schema.json",
  "title": "Phase 3 v3 complete-context linguistic representation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document", "source", "context", "tokens", "edit_shape", "edits", "minimal_edit_spans", "construction_spans", "unchanged_function_word_token_ids", "corrected", "evidence", "classification", "linguistic_analyses", "analysis_provenance", "model_subword_diagnostics", "provider_calls"],
  "properties": {
    "schema_version": {"const": "phase3_linguistic_representation_v3"},
    "document": {"$ref": "#/$defs/document"},
    "source": {"$ref": "#/$defs/source"},
    "context": {"$ref": "#/$defs/context"},
    "tokens": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/token"}},
    "edit_shape": {"enum": ["substitution", "insertion", "deletion", "reordering", "punctuation_only", "multi_edit"]},
    "edits": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/edit"}},
    "minimal_edit_spans": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/span"}},
    "construction_spans": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/span"}},
    "unchanged_function_word_token_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^tok:[0-9]{6}$"}},
    "corrected": {"$ref": "#/$defs/corrected"},
    "evidence": {"$ref": "#/$defs/evidence"},
    "classification": {"$ref": "#/$defs/classification"},
    "linguistic_analyses": {"type": "array", "items": {"$ref": "#/$defs/analysis"}},
    "analysis_provenance": {"$ref": "#/$defs/analysisProvenance"},
    "model_subword_diagnostics": {"type": "object", "additionalProperties": false, "required": ["status"], "properties": {"status": {"enum": ["absent", "deferred"]}}},
    "provider_calls": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "locator": {"type": "object", "minProperties": 1, "additionalProperties": true},
    "document": {"type": "object", "additionalProperties": false, "required": ["document_or_edition_identity", "frozen_locator", "frozen_locator_sha256", "source_document_bytes_sha256"], "properties": {"document_or_edition_identity": {"type": "string", "minLength": 1}, "frozen_locator": {"$ref": "#/$defs/locator"}, "frozen_locator_sha256": {"$ref": "#/$defs/sha256"}, "source_document_bytes_sha256": {"$ref": "#/$defs/sha256"}}},
    "normalization": {"type": "object", "additionalProperties": false, "required": ["nfc", "nfkc", "nfc_sha256", "nfkc_sha256", "source_is_nfc", "source_is_nfkc"], "properties": {"nfc": {"type": "string"}, "nfkc": {"type": "string"}, "nfc_sha256": {"$ref": "#/$defs/sha256"}, "nfkc_sha256": {"$ref": "#/$defs/sha256"}, "source_is_nfc": {"type": "boolean"}, "source_is_nfkc": {"type": "boolean"}}},
    "source": {"type": "object", "additionalProperties": false, "required": ["complete_text", "complete_text_utf8_sha256", "source_text_sha256", "offset_basis", "original_preserved", "normalization"], "properties": {"complete_text": {"type": "string", "minLength": 1}, "complete_text_utf8_sha256": {"$ref": "#/$defs/sha256"}, "source_text_sha256": {"$ref": "#/$defs/sha256"}, "offset_basis": {"const": "unicode_code_points"}, "original_preserved": {"const": true}, "normalization": {"$ref": "#/$defs/normalization"}}},
    "span": {"type": "object", "additionalProperties": false, "required": ["start", "end", "text"], "properties": {"start": {"type": "integer", "minimum": 0}, "end": {"type": "integer", "minimum": 0}, "text": {"type": "string"}}},
    "context": {"type": "object", "additionalProperties": false, "required": ["paragraphs", "sentences", "focal_paragraph_index", "focal_sentence_index"], "properties": {"paragraphs": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/span"}}, "sentences": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/span"}}, "focal_paragraph_index": {"const": 0}, "focal_sentence_index": {"const": 0}}},
    "token": {"type": "object", "additionalProperties": false, "required": ["token_id", "kind", "text", "normalized_text", "start", "end", "paragraph_index", "sentence_index"], "properties": {"token_id": {"type": "string", "pattern": "^tok:[0-9]{6}$"}, "kind": {"enum": ["word", "punctuation"]}, "text": {"type": "string", "minLength": 1}, "normalized_text": {"type": "string", "minLength": 1}, "start": {"type": "integer", "minimum": 0}, "end": {"type": "integer", "minimum": 0}, "paragraph_index": {"type": ["integer", "null"], "minimum": 0}, "sentence_index": {"type": ["integer", "null"], "minimum": 0}}},
    "edit": {"type": "object", "additionalProperties": false, "required": ["start", "end", "source_text", "replacement", "operation", "target_start", "target_end", "target_text"], "properties": {"start": {"type": "integer", "minimum": 0}, "end": {"type": "integer", "minimum": 0}, "source_text": {"type": "string"}, "replacement": {"type": "string"}, "operation": {"enum": ["substitution", "insertion", "deletion"]}, "target_start": {"type": "integer", "minimum": 0}, "target_end": {"type": "integer", "minimum": 0}, "target_text": {"type": "string"}}},
    "corrected": {"type": "object", "additionalProperties": false, "required": ["complete_text", "complete_text_sha256"], "properties": {"complete_text": {"type": "string", "minLength": 1}, "complete_text_sha256": {"$ref": "#/$defs/sha256"}}},
    "correctionEvidence": {"type": "object", "additionalProperties": false, "required": ["kind", "evidence_id", "locator", "locator_sha256", "source_document_bytes_sha256", "evidence_text", "evidence_text_sha256", "source_context_sha256", "corrected_context_sha256", "qualified_human", "authority"], "properties": {"kind": {"enum": ["ua_gec", "human_correction"]}, "evidence_id": {"type": "string", "minLength": 1}, "locator": {"$ref": "#/$defs/locator"}, "locator_sha256": {"$ref": "#/$defs/sha256"}, "source_document_bytes_sha256": {"$ref": "#/$defs/sha256"}, "evidence_text": {"type": "string", "minLength": 1}, "evidence_text_sha256": {"$ref": "#/$defs/sha256"}, "source_context_sha256": {"$ref": "#/$defs/sha256"}, "corrected_context_sha256": {"$ref": "#/$defs/sha256"}, "qualified_human": {"type": "boolean"}, "authority": {"enum": ["qualified_human", "model_output", "other"]}}},
    "corroboration": {"type": "object", "additionalProperties": false, "required": ["evidence_id", "locator", "locator_sha256", "source_document_bytes_sha256", "retrieved_text", "retrieved_text_sha256", "retrieval_status"], "properties": {"evidence_id": {"type": "string", "minLength": 1}, "locator": {"$ref": "#/$defs/locator"}, "locator_sha256": {"$ref": "#/$defs/sha256"}, "source_document_bytes_sha256": {"$ref": "#/$defs/sha256"}, "retrieved_text": {"type": "string", "minLength": 1}, "retrieved_text_sha256": {"$ref": "#/$defs/sha256"}, "retrieval_status": {"const": "exact"}}},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["correction_evidence", "corroborating_corpus_evidence"], "properties": {"correction_evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/correctionEvidence"}}, "corroborating_corpus_evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/corroboration"}}}},
    "classification": {"type": "object", "additionalProperties": false, "required": ["primary_role_id", "secondary_attributes", "claim_type", "scope", "exceptions", "register", "period", "genre", "rights", "evidence_grade", "consumer_views"], "properties": {"primary_role_id": {"enum": ["explicit_rule", "correct_example", "incorrect_example", "corrected_example", "editing_exercise", "answer_key", "distractor", "quotation", "historical_or_literary_excerpt", "metalinguistic_mention", "ordinary_narration", "ambiguous_or_ocr"]}, "secondary_attributes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "claim_type": {"enum": ["prescriptive_rule", "human_correction_pair", "style_preference", "acceptable_variant", "historical_advice", "attestation_only", "unresolved"]}, "scope": {"type": "string", "minLength": 1}, "exceptions": {"type": "array", "items": {"type": "string"}}, "register": {"type": "string", "minLength": 1}, "period": {"type": "string", "minLength": 1}, "genre": {"type": "string", "minLength": 1}, "rights": {"type": "object", "additionalProperties": false, "required": ["status", "license"], "properties": {"status": {"type": "string", "minLength": 1}, "license": {"type": "string", "minLength": 1}}}, "evidence_grade": {"type": "string", "minLength": 1}, "consumer_views": {"type": "array", "uniqueItems": true, "items": {"enum": ["supervised_pair", "preference", "protection", "filtering", "review", "automatic", "research_only"]}}}},
    "analysis": {"type": "object", "additionalProperties": false, "required": ["token_id", "lemma", "pos", "morph", "head_token_id", "dependency", "ambiguity"], "properties": {"token_id": {"type": "string", "pattern": "^tok:[0-9]{6}$"}, "lemma": {"type": ["string", "null"]}, "pos": {"type": ["string", "null"]}, "morph": {"type": "object", "additionalProperties": {"type": "string"}}, "head_token_id": {"type": ["string", "null"], "pattern": "^tok:[0-9]{6}$"}, "dependency": {"type": ["string", "null"]}, "ambiguity": {"type": "array", "items": {"type": "string"}}}},
    "analysisProvenance": {"oneOf": [{"type": "object", "additionalProperties": false, "required": ["status"], "properties": {"status": {"const": "absent"}}}, {"type": "object", "additionalProperties": false, "required": ["status", "vesum_identity", "universal_dependencies_identity"], "properties": {"status": {"const": "present"}, "vesum_identity": {"type": ["string", "null"]}, "universal_dependencies_identity": {"type": ["string", "null"]}}}]}
  }
}
