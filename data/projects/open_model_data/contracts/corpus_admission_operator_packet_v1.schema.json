{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learn-ukrainian.github.io/schemas/open-model-data/corpus_admission_operator_packet_v1.schema.json",
  "title": "Ukrainian Data Foundry corpus-admission operator packet v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "admission_id", "decision_required", "advisor_verdict", "operator_decision_status", "operator_decision", "families", "operator_choices", "total_rows", "total_words"],
  "properties": {
    "schema_version": {"const": "corpus_admission_operator_packet_v1"},
    "admission_id": {"type": "string", "minLength": 3},
    "decision_required": {"type": "boolean"},
    "advisor_verdict": {"enum": ["proposal_supported", "proposal_blocked"]},
    "operator_decision_status": {"enum": ["pending", "accepted", "rejected"]},
    "operator_decision": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision", "decided_on", "decision_reference", "operator_id", "source_families"],
          "properties": {
            "decision": {"enum": ["accepted", "rejected"]},
            "decided_on": {"type": "string", "format": "date"},
            "decision_reference": {"type": "string", "format": "uri"},
            "operator_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{2,127}$"},
            "source_families": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 3}}
          }
        }
      ]
    },
    "families": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["source_family", "current_disposition", "rows", "words", "blocked_by", "proposed_destination", "evidence_packet_id", "obligations", "material_ambiguities"], "properties": {"source_family": {"type": "string", "minLength": 3}, "current_disposition": {"enum": ["unresolved", "investigation_only", "proposed_admission", "admitted", "excluded"]}, "rows": {"type": "integer", "minimum": 0}, "words": {"type": "integer", "minimum": 0}, "blocked_by": {"type": "array", "items": {"type": "string", "minLength": 1}}, "proposed_destination": {"type": ["string", "null"]}, "evidence_packet_id": {"type": ["string", "null"]}, "obligations": {"type": "array", "items": {"type": "string", "minLength": 1}}, "material_ambiguities": {"type": "array", "items": {"type": "string", "minLength": 1}}}}},
    "operator_choices": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}},
    "total_rows": {"type": "integer", "minimum": 0},
    "total_words": {"type": "integer", "minimum": 0}
  },
  "allOf": [
    {
      "if": {"properties": {"operator_decision_status": {"const": "pending"}}},
      "then": {"properties": {"decision_required": {"const": true}, "operator_decision": {"type": "null"}}},
      "else": {"properties": {"decision_required": {"const": false}, "operator_decision": {"type": "object"}}}
    }
  ]
}
