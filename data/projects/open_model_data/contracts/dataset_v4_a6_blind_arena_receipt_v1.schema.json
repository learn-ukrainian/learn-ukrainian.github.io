{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learn-ukrainian.github.io/schemas/open-model-data/dataset_v4_a6_blind_arena_receipt_v1.schema.json",
  "title": "Dataset V4 A6 label-blind, author-blind safe arena receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "status",
    "text_free",
    "controlling_outcome_sha256",
    "control_surfaces",
    "bindings",
    "role_map",
    "frozen_slot_denominator",
    "packet",
    "arena_gate",
    "a2_residuals_carried_forward",
    "a4_residuals_carried_forward",
    "a5_residuals_carried_forward",
    "a6_residuals",
    "execution_counters",
    "eligibility",
    "safety_assertions"
  ],
  "properties": {
    "schema_version": {"const": "dataset_v4_a6_blind_arena_receipt_v1"},
    "receipt_id": {"const": "dataset-v4-a6-blind-arena-v1"},
    "status": {
      "enum": [
        "A6_BLIND_ARENA_PACKET_AND_PARSER_READY_SLICE_NOT_READY_TEXT_FREE_NO_SELF_VOTE",
        "ARENA_SLICE_READY"
      ]
    },
    "text_free": {"const": true},
    "controlling_outcome_sha256": {"const": "78a1edad36f7bab31f77470fcbf95e1542adbcd9ff5701a6c539a2cfdc49ff20"},
    "control_surfaces": {
      "type": "object",
      "additionalProperties": false,
      "required": ["public_control_issue", "pilot_child_issue", "private_operational_board"],
      "properties": {
        "public_control_issue": {"const": 7423},
        "pilot_child_issue": {"const": 7430},
        "private_operational_board": {"const": 622}
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "a2_source_operation_admission",
        "a4_deterministic_extraction",
        "a5_evidence_enrichment",
        "pilot_slot_manifest",
        "arena_engine_implementation",
        "wiring_implementation"
      ],
      "properties": {
        "a2_source_operation_admission": {
          "allOf": [{"$ref": "#/$defs/artifact_binding"}],
          "properties": {
            "path": {"const": "data/projects/open_model_data/admission/dataset_v4_a2_source_operation_admission_receipt_v1.json"},
            "schema_version": {"const": "dataset_v4_a2_source_operation_admission_receipt_v1"}
          }
        },
        "a4_deterministic_extraction": {
          "allOf": [{"$ref": "#/$defs/artifact_binding"}],
          "properties": {
            "path": {"const": "data/projects/open_model_data/admission/dataset_v4_a4_deterministic_extraction_receipt_v1.json"},
            "schema_version": {"const": "dataset_v4_a4_deterministic_extraction_receipt_v1"}
          }
        },
        "a5_evidence_enrichment": {
          "allOf": [{"$ref": "#/$defs/artifact_binding"}],
          "properties": {
            "path": {"const": "data/projects/open_model_data/admission/dataset_v4_a5_evidence_enrichment_receipt_v1.json"},
            "schema_version": {"const": "dataset_v4_a5_evidence_enrichment_receipt_v1"}
          }
        },
        "pilot_slot_manifest": {
          "allOf": [{"$ref": "#/$defs/artifact_binding"}],
          "properties": {
            "path": {"const": "data/projects/open_model_data/admission/dataset_v4_pilot_slot_manifest_v1.json"},
            "schema_version": {"const": "dataset_v4_pilot_slot_manifest_v1"}
          }
        },
        "arena_engine_implementation": {
          "allOf": [{"$ref": "#/$defs/artifact_binding"}],
          "properties": {
            "path": {"const": "scripts/projects/open_model_data/v4_arena_receipt.py"},
            "schema_version": {"const": "v4_arena_receipt_script_v1"}
          }
        },
        "wiring_implementation": {
          "allOf": [{"$ref": "#/$defs/artifact_binding"}],
          "properties": {
            "path": {"const": "scripts/projects/open_model_data/v4_a6_blind_arena.py"},
            "schema_version": {"const": "v4_a6_blind_arena_script_v1"}
          }
        }
      }
    },
    "role_map": {
      "type": "object",
      "additionalProperties": false,
      "required": ["A0", "A1", "A2", "A3", "A4", "A5", "A6", "A7", "A8", "A9", "A10", "A11", "A12", "A13"],
      "properties": {
        "A0": {"const": "scope_lead"},
        "A1": {"const": "custody"},
        "A2": {"const": "source_inventory_admission"},
        "A3": {"const": "heldout"},
        "A4": {"const": "deterministic_extraction"},
        "A5": {"const": "evidence_enrichment"},
        "A6": {"const": "safe_arena"},
        "A7": {"const": "original_row_factory"},
        "A8": {"const": "admission_assembly"},
        "A9": {"const": "evaluation_package"},
        "A10": {"const": "pilot_review"},
        "A11": {"const": "training_ready_release"},
        "A12": {"const": "later_gold_overlay"},
        "A13": {"const": "cleanup_recovery"}
      }
    },
    "frozen_slot_denominator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total_slots", "strata"],
      "properties": {
        "total_slots": {"const": 100},
        "strata": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["stratum", "id_prefix", "count", "assignment_state", "slot_ids"],
            "properties": {
              "stratum": {"type": "string", "minLength": 1},
              "id_prefix": {"type": "string", "pattern": "^v4p-[a-z-]+$"},
              "count": {"type": "integer", "minimum": 1},
              "assignment_state": {"type": "string", "minLength": 1},
              "slot_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"type": "string", "pattern": "^v4p-[a-z-]+-[0-9]{3}$"}
              }
            }
          }
        }
      }
    },
    "packet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label_blind", "author_blind", "proposal_schema_version", "begin_marker", "end_marker",
        "canonical_json", "self_vote_forbidden", "format_retry_policy", "aggregation", "quarantine_disposition"
      ],
      "properties": {
        "label_blind": {"const": true},
        "author_blind": {"const": true},
        "proposal_schema_version": {"const": "v4-arena-proposal-v1"},
        "begin_marker": {"const": "<<<V4_ARENA_PROPOSAL_JSON_BEGIN>>>"},
        "end_marker": {"const": "<<<V4_ARENA_PROPOSAL_JSON_END>>>"},
        "canonical_json": {"const": "utf8-sort-keys-compact-newline-sha256"},
        "self_vote_forbidden": {"const": true},
        "format_retry_policy": {"const": "one_format_only_retry_then_recorded_failure"},
        "aggregation": {"const": "leave_one_out_ballots_only_never_self_report"},
        "quarantine_disposition": {"const": "MODEL_AGREEMENT_QUARANTINED_NOT_GOLD"}
      }
    },
    "arena_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_id", "requires", "a5_receipt_valid", "a2_rights_resolved",
        "all_slots_assigned", "arena_slice_ready", "owner_role", "blocked_reason_code"
      ],
      "properties": {
        "gate_id": {"const": "v4-a6-arena-gate-v1"},
        "requires": {
          "const": ["a5_receipt_independently_valid", "a2_rights_fully_resolved", "all_frozen_slots_assigned"]
        },
        "a5_receipt_valid": {"type": "boolean"},
        "a2_rights_resolved": {"type": "boolean"},
        "all_slots_assigned": {"type": "boolean"},
        "arena_slice_ready": {"type": "boolean"},
        "owner_role": {"type": "string", "minLength": 1},
        "blocked_reason_code": {"type": ["string", "null"]}
      }
    },
    "a2_residuals_carried_forward": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["residual_id", "origin_stage", "status"],
        "properties": {
          "residual_id": {
            "enum": [
              "a2-residual-standard-correct-rights-unknown",
              "a2-residual-correction-coverage-blocked",
              "a2-residual-literary-rights-unknown",
              "a2-residual-dialect-regional-source-incomplete",
              "a2-residual-archaic-historical-coverage-blocked",
              "a2-residual-mixing-source-incomplete",
              "a2-residual-quotation-interference-rights-unknown",
              "a2-residual-abstention-source-incomplete"
            ]
          },
          "origin_stage": {"const": "A2"},
          "status": {"const": "unresolved_carried_to_a6"}
        }
      }
    },
    "a4_residuals_carried_forward": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["residual_id", "origin_stage", "status"],
        "properties": {
          "residual_id": {"type": "string", "pattern": "^a4-residual-[a-z0-9_-]+$"},
          "origin_stage": {"const": "A4"},
          "status": {"const": "unresolved_carried_to_a6"}
        }
      }
    },
    "a5_residuals_carried_forward": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["residual_id", "origin_stage", "status"],
        "properties": {
          "residual_id": {"type": "string", "pattern": "^a5-residual-[a-z0-9_-]+$"},
          "origin_stage": {"const": "A5"},
          "status": {"const": "unresolved_carried_to_a6"}
        }
      }
    },
    "a6_residuals": {
      "type": "array",
      "minItems": 100,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "residual_id", "subject_kind", "subject_id", "stage", "reason_code",
          "owner_role", "next_action", "retryability", "evidence_refs"
        ],
        "properties": {
          "residual_id": {"type": "string", "pattern": "^a6-residual-independence-unavailable-v4p-[a-z-]+-[0-9]{3}$"},
          "subject_kind": {"const": "pilot_slot"},
          "subject_id": {"type": "string", "pattern": "^v4p-[a-z-]+-[0-9]{3}$"},
          "stage": {"const": "A6"},
          "reason_code": {"const": "independence_unavailable"},
          "owner_role": {"type": "string", "minLength": 1},
          "next_action": {"type": "string", "minLength": 1},
          "retryability": {"const": "retryable"},
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "execution_counters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_rows_emitted", "live_proposals_run", "candidates_voted",
        "frozen_slot_count", "slots_arena_ready", "slots_independence_unavailable"
      ],
      "properties": {
        "dataset_rows_emitted": {"const": 0},
        "live_proposals_run": {"const": 0},
        "candidates_voted": {"const": 0},
        "frozen_slot_count": {"const": 100},
        "slots_arena_ready": {"type": "integer", "minimum": 0, "maximum": 100},
        "slots_independence_unavailable": {"type": "integer", "minimum": 0, "maximum": 100}
      }
    },
    "eligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gold", "training", "evaluation", "teaching", "coverage"],
      "properties": {
        "gold": {"const": false},
        "training": {"const": false},
        "evaluation": {"const": false},
        "teaching": {"const": false},
        "coverage": {"const": false}
      }
    },
    "safety_assertions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rows_not_admitted", "text_emitted", "source_text_transmitted_to_model",
        "live_model_inference_over_corpus", "held_out_membership_referenced",
        "self_vote_permitted", "silver_admitted_by_arena", "gold_created_by_arena",
        "mac_corpus_copy_created", "epic_done_claimed", "heldout_family_identity_leaked"
      ],
      "properties": {
        "rows_not_admitted": {"const": true},
        "text_emitted": {"const": false},
        "source_text_transmitted_to_model": {"const": false},
        "live_model_inference_over_corpus": {"const": false},
        "held_out_membership_referenced": {"const": false},
        "self_vote_permitted": {"const": false},
        "silver_admitted_by_arena": {"const": false},
        "gold_created_by_arena": {"const": false},
        "mac_corpus_copy_created": {"const": false},
        "epic_done_claimed": {"const": false},
        "heldout_family_identity_leaked": {"const": false}
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifact_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "schema_version"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
        },
        "sha256": {"$ref": "#/$defs/sha256"},
        "schema_version": {"type": "string", "minLength": 1}
      }
    }
  }
}
