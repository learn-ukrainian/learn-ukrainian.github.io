{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learn-ukrainian.github.io/schemas/open-model-data/phase3_cycle007_evidence_sidecar_v1.schema.json",
  "title": "Phase 3 Cycle 007 per-packet evidence sidecar v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "evaluation_cycle_id", "packet_index", "row_count", "tokenizer_id", "tokenizer_version", "code_hashes", "server_code_sha256", "sources_db_sha256", "vesum_db_sha256", "network_lookups_performed", "rows", "retrieval_payloads", "sidecar_id"],
  "properties": {
    "schema_version": {"const": "phase3_cycle007_evidence_sidecar_v1"},
    "evaluation_cycle_id": {"const": "phase3-v2-1-evaluation-cycle-007"},
    "packet_index": {"type": "integer", "minimum": 1},
    "row_count": {"type": "integer", "minimum": 1},
    "tokenizer_id": {"type": "string", "minLength": 1},
    "tokenizer_version": {"type": "string", "minLength": 1},
    "code_hashes": {"$ref": "#/$defs/codeHashes"},
    "server_code_sha256": {"$ref": "#/$defs/sha256"},
    "sources_db_sha256": {"$ref": "#/$defs/sha256"},
    "vesum_db_sha256": {"$ref": "#/$defs/sha256"},
    "network_lookups_performed": {"const": 0},
    "rows": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/rowEvidence"}},
    "retrieval_payloads": {"type": "object"},
    "sidecar_id": {"type": "string", "pattern": "^cycle007_sidecar:[a-f0-9]{64}$"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "codeHashes": {
      "type": "object", "additionalProperties": false,
      "required": ["compiler_id", "compiler_sha256", "tokenizer_id", "tokenizer_version", "tokenizer_sha256", "compound_parser_id", "compound_parser_version", "compound_parser_sha256", "mcp_response_parser_id", "mcp_response_parser_version", "mcp_response_parser_sha256", "query_plan_id", "query_plan_version", "query_plan_sha256"],
      "properties": {
        "compiler_id": {"type": "string", "minLength": 1},
        "compiler_sha256": {"$ref": "#/$defs/sha256"},
        "tokenizer_id": {"type": "string", "minLength": 1},
        "tokenizer_version": {"type": "string", "minLength": 1},
        "tokenizer_sha256": {"$ref": "#/$defs/sha256"},
        "compound_parser_id": {"type": "string", "minLength": 1},
        "compound_parser_version": {"type": "string", "minLength": 1},
        "compound_parser_sha256": {"$ref": "#/$defs/sha256"},
        "mcp_response_parser_id": {"type": "string", "minLength": 1},
        "mcp_response_parser_version": {"type": "string", "minLength": 1},
        "mcp_response_parser_sha256": {"$ref": "#/$defs/sha256"},
        "query_plan_id": {"type": "string", "minLength": 1},
        "query_plan_version": {"type": "string", "minLength": 1},
        "query_plan_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "rowEvidence": {
      "type": "object", "additionalProperties": false,
      "required": ["unit_id", "unit_sha256", "tokenizer_id", "tokenizer_version", "extracted_forms", "evidence", "evidence_ids", "phenomenon_evidence_ids", "sufficient_support", "archaic_only_risk", "russian_shadow_suspected"],
      "properties": {
        "unit_id": {"type": "string", "minLength": 1},
        "unit_sha256": {"$ref": "#/$defs/sha256"},
        "tokenizer_id": {"type": "string", "minLength": 1},
        "tokenizer_version": {"type": "string", "minLength": 1},
        "extracted_forms": {"type": "array", "items": {"type": "string"}},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "phase3_cycle007_evidence_v1.schema.json"}},
        "evidence_ids": {"type": "array", "items": {"type": "string", "pattern": "^cycle007_evidence:[a-f0-9]{64}$"}},
        "phenomenon_evidence_ids": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string", "pattern": "^cycle007_evidence:[a-f0-9]{64}$"}}},
        "sufficient_support": {"type": "boolean"},
        "archaic_only_risk": {"type": "boolean"},
        "russian_shadow_suspected": {"type": "boolean"}
      }
    }
  }
}
