{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phase3_evaluation_reproduction_bundle_v1.schema.json",
  "title": "Phase 3 v2.1 scorer and outsider reproduction receipt bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "text_free",
    "contract_bindings",
    "artifact_locators",
    "evaluation_input_manifest",
    "evaluation_input_manifest_sha256",
    "scorer_result",
    "scorer_result_sha256",
    "scorer_action_receipt",
    "outsider_input_manifest",
    "outsider_input_manifest_sha256",
    "reproduction_result",
    "reproduction_result_sha256",
    "outsider_action_receipt",
    "gate_claims"
  ],
  "properties": {
    "schema_version": {"const": "phase3_evaluation_reproduction_bundle_v1"},
    "text_free": {"const": true},
    "contract_bindings": {"$ref": "#/$defs/contractBindings"},
    "artifact_locators": {"$ref": "#/$defs/artifactLocators"},
    "evaluation_input_manifest": {"$ref": "#/$defs/evaluationInput"},
    "evaluation_input_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "scorer_result": {"$ref": "#/$defs/scorerResult"},
    "scorer_result_sha256": {"$ref": "#/$defs/sha256"},
    "scorer_action_receipt": {"$ref": "#/$defs/actionReceipt"},
    "outsider_input_manifest": {"$ref": "#/$defs/outsiderInput"},
    "outsider_input_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "reproduction_result": {"$ref": "#/$defs/reproductionResult"},
    "reproduction_result_sha256": {"$ref": "#/$defs/sha256"},
    "outsider_action_receipt": {"$ref": "#/$defs/actionReceipt"},
    "gate_claims": {"$ref": "#/$defs/gateClaims"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "gitSha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "artifactLocator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "sha256"],
      "properties": {
        "relative_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*//).+$"
        },
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "artifactLocators": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixed_release",
        "heldout_evaluation_freeze_container",
        "denominator_contract",
        "threshold_contract",
        "published_inputs_manifest",
        "sealed_evaluator_interface",
        "release_instructions",
        "ukrainian_recipe",
        "english_recipe",
        "scorer_metrics",
        "first_build",
        "second_build",
        "reproduced_export"
      ],
      "properties": {
        "fixed_release": {"$ref": "#/$defs/artifactLocator"},
        "heldout_evaluation_freeze_container": {"$ref": "#/$defs/artifactLocator"},
        "denominator_contract": {"$ref": "#/$defs/artifactLocator"},
        "threshold_contract": {"$ref": "#/$defs/artifactLocator"},
        "published_inputs_manifest": {"$ref": "#/$defs/artifactLocator"},
        "sealed_evaluator_interface": {"$ref": "#/$defs/artifactLocator"},
        "release_instructions": {"$ref": "#/$defs/artifactLocator"},
        "ukrainian_recipe": {"$ref": "#/$defs/artifactLocator"},
        "english_recipe": {"$ref": "#/$defs/artifactLocator"},
        "scorer_metrics": {"$ref": "#/$defs/artifactLocator"},
        "first_build": {"$ref": "#/$defs/artifactLocator"},
        "second_build": {"$ref": "#/$defs/artifactLocator"},
        "reproduced_export": {"$ref": "#/$defs/artifactLocator"}
      }
    },
    "contractBindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_contract_sha256",
        "amendment_sha256",
        "combined_contract_sha256",
        "functional_role_contract_sha256",
        "conflict_graph_sha256",
        "evaluation_cycle_id"
      ],
      "properties": {
        "base_contract_sha256": {"$ref": "#/$defs/sha256"},
        "amendment_sha256": {"$ref": "#/$defs/sha256"},
        "combined_contract_sha256": {"$ref": "#/$defs/sha256"},
        "functional_role_contract_sha256": {"$ref": "#/$defs/sha256"},
        "conflict_graph_sha256": {"$ref": "#/$defs/sha256"},
        "evaluation_cycle_id": {"const": "phase3-v2-1-evaluation-cycle-001"}
      }
    },
    "evaluationInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "evaluation_cycle_id",
        "fixed_release_task_id",
        "fixed_release_sha256",
        "heldout_evaluation_freeze_sha256",
        "denominator_contract_sha256",
        "threshold_contract_sha256",
        "published_inputs_manifest_sha256",
        "sealed_evaluator_interface_sha256",
        "release_instructions_sha256",
        "ukrainian_recipe_sha256",
        "english_recipe_sha256",
        "release_mutation_allowed",
        "threshold_mutation_allowed",
        "heldout_plaintext_exposed"
      ],
      "properties": {
        "schema_version": {"const": "phase3_evaluation_input_manifest_v1"},
        "evaluation_cycle_id": {"const": "phase3-v2-1-evaluation-cycle-001"},
        "fixed_release_task_id": {"const": "phase3-v2-1-fixed-release-freeze"},
        "fixed_release_sha256": {"$ref": "#/$defs/sha256"},
        "heldout_evaluation_freeze_sha256": {"$ref": "#/$defs/sha256"},
        "denominator_contract_sha256": {"$ref": "#/$defs/sha256"},
        "threshold_contract_sha256": {"$ref": "#/$defs/sha256"},
        "published_inputs_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "sealed_evaluator_interface_sha256": {"$ref": "#/$defs/sha256"},
        "release_instructions_sha256": {"$ref": "#/$defs/sha256"},
        "ukrainian_recipe_sha256": {"$ref": "#/$defs/sha256"},
        "english_recipe_sha256": {"$ref": "#/$defs/sha256"},
        "release_mutation_allowed": {"const": false},
        "threshold_mutation_allowed": {"const": false},
        "heldout_plaintext_exposed": {"const": false}
      }
    },
    "scorerResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluation_input_manifest_sha256",
        "fixed_release_sha256",
        "heldout_evaluation_freeze_sha256",
        "threshold_contract_sha256",
        "metrics_sha256",
        "rules_modified",
        "thresholds_modified",
        "heldout_plaintext_exported",
        "status"
      ],
      "properties": {
        "evaluation_input_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "fixed_release_sha256": {"$ref": "#/$defs/sha256"},
        "heldout_evaluation_freeze_sha256": {"$ref": "#/$defs/sha256"},
        "threshold_contract_sha256": {"$ref": "#/$defs/sha256"},
        "metrics_sha256": {"$ref": "#/$defs/sha256"},
        "rules_modified": {"const": false},
        "thresholds_modified": {"const": false},
        "heldout_plaintext_exported": {"const": false},
        "status": {"const": "completed"}
      }
    },
    "outsiderInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "evaluation_cycle_id",
        "evaluation_input_manifest_sha256",
        "scorer_result_sha256",
        "fixed_release_sha256",
        "published_inputs_manifest_sha256",
        "sealed_evaluator_interface_sha256",
        "release_instructions_sha256",
        "ukrainian_recipe_sha256",
        "english_recipe_sha256",
        "fresh_worktree_commit_sha",
        "source_blind",
        "fresh_clean_worktree",
        "author_worktree_used",
        "private_heldout_plaintext_available",
        "public_canary_evidence_allowed"
      ],
      "properties": {
        "schema_version": {"const": "phase3_outsider_reproduction_input_manifest_v1"},
        "evaluation_cycle_id": {"const": "phase3-v2-1-evaluation-cycle-001"},
        "evaluation_input_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "scorer_result_sha256": {"$ref": "#/$defs/sha256"},
        "fixed_release_sha256": {"$ref": "#/$defs/sha256"},
        "published_inputs_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "sealed_evaluator_interface_sha256": {"$ref": "#/$defs/sha256"},
        "release_instructions_sha256": {"$ref": "#/$defs/sha256"},
        "ukrainian_recipe_sha256": {"$ref": "#/$defs/sha256"},
        "english_recipe_sha256": {"$ref": "#/$defs/sha256"},
        "fresh_worktree_commit_sha": {"$ref": "#/$defs/gitSha"},
        "source_blind": {"const": true},
        "fresh_clean_worktree": {"const": true},
        "author_worktree_used": {"const": false},
        "private_heldout_plaintext_available": {"const": false},
        "public_canary_evidence_allowed": {"const": false}
      }
    },
    "reproductionResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outsider_input_manifest_sha256",
        "first_build_sha256",
        "second_build_sha256",
        "reproduced_export_sha256",
        "scorer_metrics_sha256",
        "input_bytes_preserved",
        "protected_material_preserved",
        "ukrainian_recipe_verified",
        "english_recipe_verified",
        "source_blind",
        "fresh_clean_worktree",
        "author_worktree_used",
        "private_heldout_plaintext_accessed",
        "canary_used_as_quality_coverage_or_completion_proof",
        "training_performed",
        "paid_compute_used",
        "hugging_face_mutated",
        "upload_performed",
        "outreach_performed",
        "no_phase4_actions",
        "status"
      ],
      "properties": {
        "outsider_input_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "first_build_sha256": {"$ref": "#/$defs/sha256"},
        "second_build_sha256": {"$ref": "#/$defs/sha256"},
        "reproduced_export_sha256": {"$ref": "#/$defs/sha256"},
        "scorer_metrics_sha256": {"$ref": "#/$defs/sha256"},
        "input_bytes_preserved": {"const": true},
        "protected_material_preserved": {"const": true},
        "ukrainian_recipe_verified": {"const": true},
        "english_recipe_verified": {"const": true},
        "source_blind": {"const": true},
        "fresh_clean_worktree": {"const": true},
        "author_worktree_used": {"const": false},
        "private_heldout_plaintext_accessed": {"const": false},
        "canary_used_as_quality_coverage_or_completion_proof": {"const": false},
        "training_performed": {"const": false},
        "paid_compute_used": {"const": false},
        "hugging_face_mutated": {"const": false},
        "upload_performed": {"const": false},
        "outreach_performed": {"const": false},
        "no_phase4_actions": {"const": true},
        "status": {"const": "completed"}
      }
    },
    "actionReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_id",
        "role_id",
        "task_id",
        "action_kind",
        "provider",
        "exact_model",
        "model_family",
        "harness",
        "input_manifest_sha256",
        "output_sha256",
        "evaluation_cycle_id",
        "base_contract_sha256",
        "amendment_sha256",
        "combined_contract_sha256",
        "functional_role_contract_sha256",
        "conflict_graph_sha256",
        "started_at",
        "completed_at",
        "status"
      ],
      "properties": {
        "receipt_id": {"type": "string", "pattern": "^phase3_functional_action:[a-f0-9]{64}$"},
        "role_id": {"enum": ["scorer", "outsider_reproducer"]},
        "task_id": {"enum": ["phase3-v2-1-heldout-scoring", "phase3-v2-1-outsider-reproduction"]},
        "action_kind": {"enum": ["score_fixed_release_against_sealed_heldout", "fresh_worktree_byte_identical_reproduction"]},
        "provider": {"type": "string", "minLength": 1},
        "exact_model": {"type": "string", "minLength": 1},
        "model_family": {"type": "string", "minLength": 1},
        "harness": {"type": "string", "minLength": 1},
        "input_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "output_sha256": {"$ref": "#/$defs/sha256"},
        "evaluation_cycle_id": {"const": "phase3-v2-1-evaluation-cycle-001"},
        "base_contract_sha256": {"$ref": "#/$defs/sha256"},
        "amendment_sha256": {"$ref": "#/$defs/sha256"},
        "combined_contract_sha256": {"$ref": "#/$defs/sha256"},
        "functional_role_contract_sha256": {"$ref": "#/$defs/sha256"},
        "conflict_graph_sha256": {"$ref": "#/$defs/sha256"},
        "started_at": {"type": "string", "format": "date-time"},
        "completed_at": {"type": "string", "format": "date-time"},
        "status": {"const": "completed"}
      }
    },
    "gateClaims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mechanics_verified",
        "engine_ready_claimed",
        "source_coverage_ready_claimed",
        "linguistically_validated_claimed",
        "consumer_proven_claimed",
        "phase3_complete_claimed",
        "phase4_authorized"
      ],
      "properties": {
        "mechanics_verified": {"const": true},
        "engine_ready_claimed": {"const": false},
        "source_coverage_ready_claimed": {"const": false},
        "linguistically_validated_claimed": {"const": false},
        "consumer_proven_claimed": {"const": false},
        "phase3_complete_claimed": {"const": false},
        "phase4_authorized": {"const": false}
      }
    }
  }
}
