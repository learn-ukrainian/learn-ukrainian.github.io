{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learn-ukrainian.github.io/schemas/open-model-data/phase3_cycle007_evidence_manifest_v1.schema.json",
  "title": "Phase 3 Cycle 007 text-free evidence compile manifest v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "text_free", "evaluation_cycle_id", "tokenizer_id", "tokenizer_version", "code_hashes", "server_code_sha256", "sources_db_sha256", "vesum_db_sha256", "packet_count", "row_count", "network_lookups_performed", "counts_by_channel", "counts_by_status", "counts_by_supports", "sufficient_support_rows", "archaic_only_risk_rows", "russian_shadow_suspected_rows", "sidecars", "source_package_binding", "mcp_transport_attestation", "manifest_sha256"],
  "properties": {
    "schema_version": {"const": "phase3_cycle007_evidence_manifest_v1"},
    "text_free": {"const": true},
    "evaluation_cycle_id": {"const": "phase3-v2-1-evaluation-cycle-007"},
    "tokenizer_id": {"type": "string", "minLength": 1},
    "tokenizer_version": {"type": "string", "minLength": 1},
    "code_hashes": {"$ref": "#/$defs/codeHashes"},
    "server_code_sha256": {"$ref": "#/$defs/sha256"},
    "sources_db_sha256": {"$ref": "#/$defs/sha256"},
    "vesum_db_sha256": {"$ref": "#/$defs/sha256"},
    "packet_count": {"type": "integer", "minimum": 0},
    "row_count": {"type": "integer", "minimum": 0},
    "network_lookups_performed": {"const": 0},
    "counts_by_channel": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "counts_by_status": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "counts_by_supports": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "sufficient_support_rows": {"type": "integer", "minimum": 0},
    "archaic_only_risk_rows": {"type": "integer", "minimum": 0},
    "russian_shadow_suspected_rows": {"type": "integer", "minimum": 0},
    "sidecars": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["packet_index", "row_count", "sidecar_sha256", "sidecar_id", "lane", "packet_binding"],
        "properties": {
          "packet_index": {"type": "integer", "minimum": 1},
          "row_count": {"type": "integer", "minimum": 1},
          "sidecar_sha256": {"$ref": "#/$defs/sha256"},
          "sidecar_id": {"type": "string", "pattern": "^cycle007_sidecar:[a-f0-9]{64}$"},
          "lane": {"enum": ["clean_label", "residual_label"]},
          "packet_binding": {"$ref": "#/$defs/packetBinding"}
        }
      }
    },
    "source_package_binding": {
      "type": ["object", "null"], "additionalProperties": false,
      "required": ["source_evaluation_cycle_id", "custody_receipt_raw_sha256", "materialization_manifest_sha256", "ordered_identity_commitment_sha256", "identity_union_commitment_sha256", "ordered_packet_commitment_sha256", "packet_count", "row_count"],
      "properties": {
        "source_evaluation_cycle_id": {"type": "string", "minLength": 1},
        "custody_receipt_raw_sha256": {"$ref": "#/$defs/sha256"},
        "materialization_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "ordered_identity_commitment_sha256": {"$ref": "#/$defs/sha256"},
        "identity_union_commitment_sha256": {"$ref": "#/$defs/sha256"},
        "ordered_packet_commitment_sha256": {"$ref": "#/$defs/sha256"},
        "packet_count": {"type": "integer", "minimum": 0},
        "row_count": {"type": "integer", "minimum": 0}
      }
    },
    "mcp_transport_attestation": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["schema_version", "transport", "endpoint_sha256", "required_tool_set_sha256", "tool_call_count", "counts_by_tool", "server_identity_call_count", "ordered_call_commitment_sha256"],
          "properties": {
            "schema_version": {"const": "phase3_cycle007_mcp_transport_attestation_v1"},
            "transport": {"enum": ["streamable_http", "synthetic"]},
            "endpoint_sha256": {"$ref": "#/$defs/sha256"},
            "required_tool_set_sha256": {"$ref": "#/$defs/sha256"},
            "tool_call_count": {"type": "integer", "minimum": 0},
            "counts_by_tool": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
            "server_identity_call_count": {"type": "integer", "minimum": 0},
            "ordered_call_commitment_sha256": {"$ref": "#/$defs/sha256"}
          }
        }
      ]
    },
    "manifest_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "packetBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["canonical_basename", "raw_sha256", "packet_identity_set_sha256"],
      "properties": {
        "canonical_basename": {"type": "string", "minLength": 1},
        "raw_sha256": {"$ref": "#/$defs/sha256"},
        "packet_identity_set_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "codeHashes": {
      "type": "object", "additionalProperties": false,
      "required": ["compiler_id", "compiler_sha256", "tokenizer_id", "tokenizer_version", "tokenizer_sha256", "compound_parser_id", "compound_parser_version", "compound_parser_sha256", "mcp_response_parser_id", "mcp_response_parser_version", "mcp_response_parser_sha256", "query_plan_id", "query_plan_version", "query_plan_sha256"],
      "properties": {
        "compiler_id": {"type": "string", "minLength": 1},
        "compiler_sha256": {"$ref": "#/$defs/sha256"},
        "tokenizer_id": {"type": "string", "minLength": 1},
        "tokenizer_version": {"type": "string", "minLength": 1},
        "tokenizer_sha256": {"$ref": "#/$defs/sha256"},
        "compound_parser_id": {"type": "string", "minLength": 1},
        "compound_parser_version": {"type": "string", "minLength": 1},
        "compound_parser_sha256": {"$ref": "#/$defs/sha256"},
        "mcp_response_parser_id": {"type": "string", "minLength": 1},
        "mcp_response_parser_version": {"type": "string", "minLength": 1},
        "mcp_response_parser_sha256": {"$ref": "#/$defs/sha256"},
        "query_plan_id": {"type": "string", "minLength": 1},
        "query_plan_version": {"type": "string", "minLength": 1},
        "query_plan_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
