{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learn-ukrainian.github.io/schemas/open-model-data/dataset_v4_a3_heldout_source_family_seal_receipt_v1.schema.json",
  "title": "Dataset V4 A3 held-out source-family seal receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "status",
    "text_free",
    "controlling_outcome_sha256",
    "control_surfaces",
    "bindings",
    "source_family_registry",
    "identity_group_freeze",
    "heldout_partition_seal",
    "access_firewall",
    "temporal_firewall",
    "cycle007_denial",
    "a2_residuals_carried_forward",
    "a3_residuals",
    "execution_counters",
    "safety_assertions"
  ],
  "properties": {
    "schema_version": {"const": "dataset_v4_a3_heldout_source_family_seal_receipt_v1"},
    "receipt_id": {"const": "dataset-v4-a3-heldout-source-family-seal-v1"},
    "status": {"const": "A3_HELDOUT_SOURCE_FAMILY_SEAL_FIREWALL_SEALED_MEMBERSHIP_PENDING"},
    "text_free": {"const": true},
    "controlling_outcome_sha256": {"const": "78a1edad36f7bab31f77470fcbf95e1542adbcd9ff5701a6c539a2cfdc49ff20"},
    "control_surfaces": {
      "type": "object",
      "additionalProperties": false,
      "required": ["public_control_issue", "pilot_child_issue", "private_operational_board"],
      "properties": {
        "public_control_issue": {"const": 7423},
        "pilot_child_issue": {"const": 7430},
        "private_operational_board": {"const": 622}
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["a2_source_operation_admission", "slot_manifest", "near_duplicate_policy", "cycle007_scope_circularity_evidence"],
      "properties": {
        "a2_source_operation_admission": {"$ref": "#/$defs/artifact_binding"},
        "slot_manifest": {"$ref": "#/$defs/artifact_binding"},
        "near_duplicate_policy": {"$ref": "#/$defs/artifact_binding"},
        "cycle007_scope_circularity_evidence": {
          "allOf": [{"$ref": "#/$defs/artifact_binding"}],
          "type": "object",
          "required": ["v3_only", "used_for_denial_only"],
          "properties": {
            "v3_only": {"const": true},
            "used_for_denial_only": {"const": true}
          }
        }
      }
    },
    "source_family_registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grouping_basis", "family_count", "families"],
      "properties": {
        "grouping_basis": {"const": "source_identity_not_prestige_or_provider_arrival_order"},
        "family_count": {"const": 9},
        "families": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["family_id", "member_source_unit_ids", "source_class", "grouping_rationale"],
            "properties": {
              "family_id": {"type": "string", "pattern": "^fam-[a-z0-9-]+$"},
              "member_source_unit_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 3}
              },
              "source_class": {"enum": ["existing_corpus_collection", "frozen_historical_source_unit"]},
              "grouping_rationale": {
                "enum": [
                  "distinct_existing_local_corpus_collection_identity_no_cross_collection_merge_evidence",
                  "distinct_historical_author_or_repository_provenance_no_cross_unit_merge_evidence"
                ]
              }
            }
          }
        }
      }
    },
    "identity_group_freeze": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "freeze_id", "status", "family_count", "same_family_never_split",
        "dimension_order_is_frozen", "source_admission_assigns_hidden_membership",
        "construction_receives_hidden_membership"
      ],
      "properties": {
        "freeze_id": {"const": "v4-a3-identity-group-freeze-v1"},
        "status": {"const": "FROZEN_FAMILY_GROUPING_NO_HELDOUT_MEMBERSHIP"},
        "family_count": {"const": 9},
        "same_family_never_split": {"const": true},
        "dimension_order_is_frozen": {"const": true},
        "source_admission_assigns_hidden_membership": {"const": false},
        "construction_receives_hidden_membership": {"const": false}
      }
    },
    "heldout_partition_seal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seal_id", "status", "sealed_before_any_builder_packet", "partition_unit", "family_count",
        "assignment_algorithm_id", "assignment_is_deterministic", "assignment_is_content_blind",
        "assignment_requires_private_salt", "bucket_count", "heldout_bucket_range",
        "builder_eligible_bucket_range", "families_assigned_heldout", "families_assigned_builder_eligible",
        "families_assignment_pending", "heldout_membership_included", "membership_owner_role",
        "membership_materialization_location", "disjointness_assertion", "reseal_required_on"
      ],
      "properties": {
        "seal_id": {"const": "v4-a3-heldout-partition-seal-v1"},
        "status": {"const": "FROZEN_ALGORITHM_AND_FIREWALL_SEALED_MEMBERSHIP_NOT_YET_ASSIGNED"},
        "sealed_before_any_builder_packet": {"const": true},
        "partition_unit": {"const": "source_family"},
        "family_count": {"const": 9},
        "assignment_algorithm_id": {"const": "v4-a3-sha256-family-bucket-split-v1"},
        "assignment_is_deterministic": {"const": true},
        "assignment_is_content_blind": {"const": true},
        "assignment_requires_private_salt": {"const": true},
        "bucket_count": {"const": 10000},
        "heldout_bucket_range": {"const": [0, 999]},
        "builder_eligible_bucket_range": {"const": [1000, 9999]},
        "families_assigned_heldout": {"const": 0},
        "families_assigned_builder_eligible": {"const": 0},
        "families_assignment_pending": {"const": 9},
        "heldout_membership_included": {"const": false},
        "membership_owner_role": {"const": "A3_heldout"},
        "membership_materialization_location": {"const": "private_operational_board_622"},
        "disjointness_assertion": {"const": "each_family_will_be_assigned_to_exactly_one_pool_no_family_split_across_pools"},
        "reseal_required_on": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "access_firewall": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "items": {"$ref": "#/$defs/visibility_role"}
    },
    "temporal_firewall": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "firewall_id", "exposure_allowed", "exposure_before_seal_forbidden", "builder_packet_issued",
        "builder_packet_issuance_requires", "mutation_after_seal", "current_state"
      ],
      "properties": {
        "firewall_id": {"const": "v4-a3-temporal-firewall-v1"},
        "exposure_allowed": {"const": false},
        "exposure_before_seal_forbidden": {"const": true},
        "builder_packet_issued": {"const": false},
        "builder_packet_issuance_requires": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "mutation_after_seal": {"const": "forbidden_without_reseal"},
        "current_state": {"const": "SEALED_NO_BUILDER_EXPOSURE"}
      }
    },
    "cycle007_denial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "denial_id", "source_cycle_label", "source_cycle_controlling_outcome_sha256", "denied",
        "reused_in_v4", "adoption_forbidden", "reason_code", "denied_fingerprints"
      ],
      "properties": {
        "denial_id": {"const": "v4-a3-cycle007-denial-v1"},
        "source_cycle_label": {"const": "phase3_scope_circularity_firewall_v1.cycle007"},
        "source_cycle_controlling_outcome_sha256": {"const": "890498103f96a7b8f27fd52bc14418d8752e5b73a72ed8774dd0f52eb3160a47"},
        "denied": {"const": true},
        "reused_in_v4": {"const": false},
        "adoption_forbidden": {"const": true},
        "reason_code": {"const": "cross_version_evidence_not_reusable_for_v4_family_split"},
        "denied_fingerprints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["fingerprint_kind", "value", "denied"],
            "properties": {
              "fingerprint_kind": {"type": "string", "minLength": 1},
              "value": {"$ref": "#/$defs/sha256"},
              "denied": {"const": true}
            }
          }
        }
      }
    },
    "a2_residuals_carried_forward": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["residual_id", "origin_stage", "status"],
        "properties": {
          "residual_id": {
            "enum": [
              "a2-residual-standard-correct-rights-unknown",
              "a2-residual-correction-coverage-blocked",
              "a2-residual-literary-rights-unknown",
              "a2-residual-dialect-regional-source-incomplete",
              "a2-residual-archaic-historical-coverage-blocked",
              "a2-residual-mixing-source-incomplete",
              "a2-residual-quotation-interference-rights-unknown",
              "a2-residual-abstention-source-incomplete"
            ]
          },
          "origin_stage": {"const": "A2"},
          "status": {"const": "unresolved_carried_to_a3"}
        }
      }
    },
    "a3_residuals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "residual_id", "subject_kind", "subject_id", "stage", "reason_code",
          "owner_role", "next_action", "retryability", "evidence_refs"
        ],
        "properties": {
          "residual_id": {"type": "string", "minLength": 3},
          "subject_kind": {"type": "string", "minLength": 1},
          "subject_id": {"type": "string", "minLength": 1},
          "stage": {"const": "A3"},
          "reason_code": {
            "enum": ["source_incomplete", "rights_unknown", "coverage_blocked", "membership_not_yet_assigned"]
          },
          "owner_role": {"type": "string", "minLength": 1},
          "next_action": {"type": "string", "minLength": 1},
          "retryability": {"enum": ["retryable", "not_retryable"]},
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "execution_counters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_rows_emitted", "new_source_fetches", "builder_packets_issued",
        "heldout_exposures_to_builder", "cycle007_material_reused", "family_merges_performed"
      ],
      "properties": {
        "dataset_rows_emitted": {"const": 0},
        "new_source_fetches": {"const": 0},
        "builder_packets_issued": {"const": 0},
        "heldout_exposures_to_builder": {"const": 0},
        "cycle007_material_reused": {"const": 0},
        "family_merges_performed": {"const": 0}
      }
    },
    "safety_assertions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rows_not_admitted", "heldout_membership_exposed_to_builder", "builder_packet_issued_before_seal",
        "cycle007_material_reused", "historical_v3_control_not_used", "mac_corpus_copy_created",
        "modern_rusyn_not_mapped_to_dialect", "prebuilder_state_claimed", "pre_scale_state_claimed",
        "training_ready_silver_claimed", "eval_artifact_ready_claimed", "later_release_state_claimed",
        "epic_done_claimed"
      ],
      "properties": {
        "rows_not_admitted": {"const": true},
        "heldout_membership_exposed_to_builder": {"const": false},
        "builder_packet_issued_before_seal": {"const": false},
        "cycle007_material_reused": {"const": false},
        "historical_v3_control_not_used": {"const": true},
        "mac_corpus_copy_created": {"const": false},
        "modern_rusyn_not_mapped_to_dialect": {"const": true},
        "prebuilder_state_claimed": {"const": false},
        "pre_scale_state_claimed": {"const": false},
        "training_ready_silver_claimed": {"const": false},
        "eval_artifact_ready_claimed": {"const": false},
        "later_release_state_claimed": {"const": false},
        "epic_done_claimed": {"const": false}
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifact_binding": {
      "type": "object",
      "required": ["path", "sha256", "schema_version"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
        },
        "sha256": {"$ref": "#/$defs/sha256"},
        "schema_version": {"type": "string", "minLength": 1},
        "v3_only": {"type": "boolean"},
        "used_for_denial_only": {"type": "boolean"}
      }
    },
    "visibility_role": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role_id", "heldout_family_pool_visible", "heldout_membership_locator_visible",
        "heldout_fingerprint_visible", "heldout_near_neighbour_visible", "forbidden_fields"
      ],
      "properties": {
        "role_id": {
          "enum": [
            "A0_scope_lead", "A1_custody", "A2_source_inventory_admission", "A3_heldout",
            "A4_deterministic_extraction", "A5_evidence_enrichment", "A6_safe_arena",
            "A7_original_row_factory", "A8_admission_assembly", "A9_evaluation_package",
            "A10_pilot_review", "A11_training_ready_release", "A12_later_gold_overlay",
            "A13_cleanup_recovery"
          ]
        },
        "heldout_family_pool_visible": {"type": "boolean"},
        "heldout_membership_locator_visible": {"type": "boolean"},
        "heldout_fingerprint_visible": {"type": "boolean"},
        "heldout_near_neighbour_visible": {"type": "boolean"},
        "forbidden_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
