{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learn-ukrainian.github.io/schemas/open-model-data/dataset_v4_pilot_slot_manifest_v1.schema.json",
  "title": "Dataset V4 pilot slot manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "text_free", "controlling_outcome_sha256", "product_scope", "release_train", "custody_policy", "rights_policy", "required_role_ids", "required_gate_ids", "sealed_heldout_commitment", "slot_series"],
  "properties": {
    "schema_version": {"const": "dataset_v4_pilot_slot_manifest_v1"},
    "status": {"const": "FROZEN_PREBUILD_SLOT_CONTRACT"},
    "text_free": {"const": true},
    "controlling_outcome_sha256": {"const": "78a1edad36f7bab31f77470fcbf95e1542adbcd9ff5701a6c539a2cfdc49ff20"},
    "product_scope": {"type": "array", "minItems": 7, "maxItems": 7, "uniqueItems": true, "items": {"enum": ["standard_control", "literary", "dialect_regional", "archaic_historical", "mixing", "quotation_interference", "abstention"]}},
    "release_train": {"type": "object", "additionalProperties": false, "required": ["initial", "later_overlay", "model_agreement_creates_gold"], "properties": {"initial": {"const": "silver"}, "later_overlay": {"const": "gold"}, "model_agreement_creates_gold": {"const": false}}},
    "custody_policy": {"type": "object", "additionalProperties": false, "required": ["execution", "mac_corpus_copy_allowed", "capacity_gate_required"], "properties": {"execution": {"const": "VPS_FIRST"}, "mac_corpus_copy_allowed": {"const": false}, "capacity_gate_required": {"const": true}}},
    "rights_policy": {"type": "object", "additionalProperties": false, "required": ["operation_specific", "unresolved_operation_is_global_blocker"], "properties": {"operation_specific": {"const": true}, "unresolved_operation_is_global_blocker": {"const": false}}},
    "required_role_ids": {"type": "array", "minItems": 14, "maxItems": 14, "uniqueItems": true, "items": {"pattern": "^A(?:[0-9]|1[0-3])$"}},
    "required_gate_ids": {"type": "array", "minItems": 6, "uniqueItems": true, "items": {"enum": ["VPS_CUSTODY_CAPACITY", "SOURCE_OPERATION_ADMISSION", "SEALED_HELDOUT_SOURCE_FAMILY_SPLIT", "NON_SELF_ARENA_VOTING", "MODEL_AGREEMENT_NOT_GOLD", "SILVER_FIRST_STABLE_IDS"]}},
    "sealed_heldout_commitment": {"type": "object", "additionalProperties": false, "required": ["required_before_builders_start", "source_family_split_required", "heldout_membership_included", "assignment_owner"], "properties": {"required_before_builders_start": {"const": true}, "source_family_split_required": {"const": true}, "heldout_membership_included": {"const": false}, "assignment_owner": {"const": "A2_A3_PRIVATE_ARTIFACT"}}},
    "slot_series": {"type": "array", "minItems": 8, "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/slot_series"}}
  },
  "$defs": {
    "slot_series": {"type": "object", "additionalProperties": false, "required": ["stratum", "id_prefix", "start", "count", "assignment_state"], "properties": {"stratum": {"enum": ["standard_correct", "correction", "literary", "dialect_regional", "archaic_historical", "mixing", "quotation_interference", "abstention"]}, "id_prefix": {"pattern": "^v4p-[a-z-]+$"}, "start": {"const": 1}, "count": {"enum": [5, 10, 15]}, "assignment_state": {"const": "UNASSIGNED_PENDING_A2_A3"}}}
  }
}
