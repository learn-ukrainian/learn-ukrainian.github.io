{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learn-ukrainian.github.io/schemas/open-model-data/vesum_unattested_sample_receipt_v1.schema.json",
  "title": "Text-free VESUM unattested sample receipt v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "denominator", "production_expected_denominator", "pins", "stratification", "output", "sample_counts", "sample_hashes", "coverage", "limitations", "two_build_identity", "safety"],
  "properties": {
    "schema_version": {"const": "vesum_unattested_sample_receipt_v1"}, "denominator": {"type": "integer", "minimum": 1}, "production_expected_denominator": {"const": 9292022},
    "pins": {"type": "object", "additionalProperties": false, "required": ["config_sha256", "database_sha256", "vesum_sha256", "profile_sha256", "profile_receipt_sha256", "phase1_manifest_sha256", "phase1_receipt_sha256", "sampler_sha256", "detector_config_sha256", "detector_generator_sha256", "record_schema_sha256", "receipt_schema_sha256"], "properties": {"config_sha256": {"$ref": "#/$defs/sha256"}, "database_sha256": {"$ref": "#/$defs/sha256"}, "vesum_sha256": {"$ref": "#/$defs/sha256"}, "profile_sha256": {"$ref": "#/$defs/sha256"}, "profile_receipt_sha256": {"$ref": "#/$defs/sha256"}, "phase1_manifest_sha256": {"$ref": "#/$defs/sha256"}, "phase1_receipt_sha256": {"$ref": "#/$defs/sha256"}, "sampler_sha256": {"$ref": "#/$defs/sha256"}, "detector_config_sha256": {"$ref": "#/$defs/sha256"}, "detector_generator_sha256": {"$ref": "#/$defs/sha256"}, "record_schema_sha256": {"$ref": "#/$defs/sha256"}, "receipt_schema_sha256": {"$ref": "#/$defs/sha256"}}},
    "stratification": {"type": "object", "additionalProperties": false, "required": ["algorithm", "algorithm_sha256", "quotas"], "properties": {"algorithm": {"type": "string", "minLength": 1}, "algorithm_sha256": {"$ref": "#/$defs/sha256"}, "quotas": {"$ref": "#/$defs/countMap"}}},
    "output": {"$ref": "#/$defs/artifact"}, "sample_counts": {"$ref": "#/$defs/countMap"}, "sample_hashes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}}, "coverage": {"$ref": "#/$defs/countMap"}, "limitations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "two_build_identity": {"type": "object", "additionalProperties": false, "required": ["comparison_algorithm", "first_output", "second_output", "identical"], "properties": {"comparison_algorithm": {"const": "independent-artifact-byte-identity-sha256-v1"}, "first_output": {"$ref": "#/$defs/buildArtifact"}, "second_output": {"$ref": "#/$defs/buildArtifact"}, "identical": {"const": true}}},
    "safety": {"type": "object", "additionalProperties": false, "required": ["text_published", "training", "human_gold", "authoritative"], "properties": {"text_published": {"const": false}, "training": {"const": false}, "human_gold": {"const": false}, "authoritative": {"const": false}}}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "count": {"type": "integer", "minimum": 0}, "countMap": {"type": "object", "propertyNames": {"minLength": 1}, "additionalProperties": {"$ref": "#/$defs/count"}}, "buildArtifact": {"type": "object", "additionalProperties": false, "required": ["logical_path", "sha256"], "properties": {"logical_path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}}, "artifact": {"type": "object", "additionalProperties": false, "required": ["logical_path", "records", "sha256"], "properties": {"logical_path": {"type": "string", "minLength": 1}, "records": {"$ref": "#/$defs/count"}, "sha256": {"$ref": "#/$defs/sha256"}}}}
}
