{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learn-ukrainian.github.io/schemas/open-model-data/phase3_rule_author_run_manifest_v1.schema.json",
  "title": "Private Phase 3 rule-author run manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bundle_sha256", "role_contract_sha256", "bindings", "runner", "author", "packets"],
  "properties": {
    "schema_version": {"const": "phase3_rule_author_run_manifest_v1"},
    "bundle_sha256": {"$ref": "#/$defs/sha256"},
    "role_contract_sha256": {"$ref": "#/$defs/sha256"},
    "bindings": {"$ref": "#/$defs/bindings"},
    "runner": {"$ref": "#/$defs/runner"},
    "author": {"$ref": "#/$defs/author"},
    "packets": {"type": "array", "items": {"$ref": "#/$defs/packetEntry"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "compiler": {"type": "object", "additionalProperties": false, "required": ["implementation_version", "script_sha256", "phase3_v2_contract_sha256", "query_plan_sha256", "max_items", "max_utf8_bytes"], "properties": {"implementation_version": {"const": "phase3_rule_author_packet_compiler_v1"}, "script_sha256": {"$ref": "#/$defs/sha256"}, "phase3_v2_contract_sha256": {"const": "298591094d1281629ea444707909b679d1a5368f3ad8afddf39120bc0c34532b"}, "query_plan_sha256": {"$ref": "#/$defs/sha256"}, "max_items": {"const": 24}, "max_utf8_bytes": {"const": 196608}}},
    "bindings": {"type": "object", "additionalProperties": false, "required": ["phase3_v2_contract_sha256", "evaluation_contract_sha256", "coverage_contract_sha256", "near_duplicate_policy_sha256", "query_plan_sha256", "packet_schema_sha256", "compiler"], "properties": {"phase3_v2_contract_sha256": {"const": "298591094d1281629ea444707909b679d1a5368f3ad8afddf39120bc0c34532b"}, "evaluation_contract_sha256": {"$ref": "#/$defs/sha256"}, "coverage_contract_sha256": {"$ref": "#/$defs/sha256"}, "near_duplicate_policy_sha256": {"$ref": "#/$defs/sha256"}, "query_plan_sha256": {"$ref": "#/$defs/sha256"}, "packet_schema_sha256": {"$ref": "#/$defs/sha256"}, "compiler": {"$ref": "#/$defs/compiler"}}},
    "runner": {"type": "object", "additionalProperties": false, "required": ["implementation_version", "script_sha256", "schema_sha256"], "properties": {"implementation_version": {"const": "phase3_rule_author_runner_v1"}, "script_sha256": {"$ref": "#/$defs/sha256"}, "schema_sha256": {"$ref": "#/$defs/sha256"}}},
    "author": {"type": "object", "additionalProperties": false, "required": ["role_id", "controller_identity_id", "task_id", "provider", "model_family", "harness", "exact_model"], "properties": {"role_id": {"const": "rule_author_extractor"}, "controller_identity_id": {"type": "string", "pattern": "^controller_[a-z0-9_]+$"}, "task_id": {"type": "string", "minLength": 1}, "provider": {"const": "google"}, "model_family": {"const": "gemini"}, "harness": {"const": "agy"}, "exact_model": {"const": "gemini-3.6-flash-high"}}},
    "packetEntry": {"type": "object", "additionalProperties": false, "required": ["ordinal", "packet_id", "packet_sha256", "attachment", "attachment_sha256", "prompt", "prompt_sha256", "raw", "record"], "properties": {"ordinal": {"type": "integer", "minimum": 1}, "packet_id": {"type": "string", "pattern": "^rule_author_packet:[a-f0-9]{64}$"}, "packet_sha256": {"$ref": "#/$defs/sha256"}, "attachment": {"type": "string", "pattern": "^[a-z0-9_-]+/[0-9]+\\.json$"}, "attachment_sha256": {"$ref": "#/$defs/sha256"}, "prompt": {"type": "string", "pattern": "^[a-z0-9_-]+/[0-9]+\\.txt$"}, "prompt_sha256": {"$ref": "#/$defs/sha256"}, "raw": {"type": "string", "pattern": "^[a-z0-9_-]+/[0-9]+\\.raw$"}, "record": {"type": "string", "pattern": "^[a-z0-9_-]+/[0-9]+\\.json$"}}},
    "publicReceipt": {"type": "object", "additionalProperties": false, "required": ["schema_version", "text_free", "execution_mode", "planned_count", "attempted_count", "parsed_count", "unparsed_count", "failed_count", "proposal_count", "abstention_count", "bundle_sha256", "phase3_v2_contract_sha256", "role_contract_sha256", "evaluation_contract_sha256", "coverage_contract_sha256", "near_duplicate_policy_sha256", "query_plan_sha256", "packet_schema_sha256", "compiler", "runner", "prompt_set_sha256", "model", "complete", "canary", "canary_succeeded", "no_leakage"], "properties": {"schema_version": {"const": "phase3_rule_author_public_receipt_v1"}, "text_free": {"const": true}, "execution_mode": {"const": "sequential"}, "planned_count": {"type": "integer", "minimum": 0}, "attempted_count": {"type": "integer", "minimum": 0}, "parsed_count": {"type": "integer", "minimum": 0}, "unparsed_count": {"type": "integer", "minimum": 0}, "failed_count": {"type": "integer", "minimum": 0}, "proposal_count": {"type": "integer", "minimum": 0}, "abstention_count": {"type": "integer", "minimum": 0}, "bundle_sha256": {"$ref": "#/$defs/sha256"}, "phase3_v2_contract_sha256": {"const": "298591094d1281629ea444707909b679d1a5368f3ad8afddf39120bc0c34532b"}, "role_contract_sha256": {"$ref": "#/$defs/sha256"}, "evaluation_contract_sha256": {"$ref": "#/$defs/sha256"}, "coverage_contract_sha256": {"$ref": "#/$defs/sha256"}, "near_duplicate_policy_sha256": {"$ref": "#/$defs/sha256"}, "query_plan_sha256": {"$ref": "#/$defs/sha256"}, "packet_schema_sha256": {"$ref": "#/$defs/sha256"}, "compiler": {"$ref": "#/$defs/compiler"}, "runner": {"$ref": "#/$defs/runner"}, "prompt_set_sha256": {"$ref": "#/$defs/sha256"}, "model": {"type": "object", "additionalProperties": false, "required": ["provider", "model_family", "harness", "exact_model"], "properties": {"provider": {"const": "google"}, "model_family": {"const": "gemini"}, "harness": {"const": "agy"}, "exact_model": {"const": "gemini-3.6-flash-high"}}}, "complete": {"type": "boolean"}, "canary": {"type": "boolean"}, "canary_succeeded": {"type": "boolean"}, "no_leakage": {"const": true}}}
  }
}
