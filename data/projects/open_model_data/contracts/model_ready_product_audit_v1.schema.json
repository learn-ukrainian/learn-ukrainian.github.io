{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learn-ukrainian.github.io/schemas/open-model-data/model_ready_product_audit_v1.schema.json",
  "title": "Model-ready product audit receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "audit_id", "direct_inputs", "validation", "invariants", "product_truth", "empty_lane_explanation", "payload_availability", "public_release_and_redistribution", "safety_claims", "phase_1_entry_conditions", "phase_1_remaining_deliverables"],
  "properties": {
    "schema_version": {"const": "model_ready_product_audit_v1"},
    "audit_id": {"type": "string", "pattern": "^model-ready-product-audit:[a-f0-9]{64}$"},
    "direct_inputs": {"type": "object", "minProperties": 14, "additionalProperties": {"$ref": "#/$defs/file"}},
    "validation": {"type": "object", "additionalProperties": false, "required": ["schema_valid", "source_receipts_reconciled", "payload_rows_read"], "properties": {"schema_valid": {"const": true}, "source_receipts_reconciled": {"const": true}, "payload_rows_read": {"const": false}}},
    "invariants": {"type": "object", "additionalProperties": false, "required": ["faithful_cpt_records", "modern_cpt_records", "silver_records", "heldout_evaluation_records", "silver_distributions_sum_to_output", "evaluation_isolated_from_non_evaluation_views", "silver_lanes_block_all_silver_records", "silver_and_correction_contracts_deny_training_or_export"], "properties": {"faithful_cpt_records": {"const": 1028}, "modern_cpt_records": {"const": 1028}, "silver_records": {"const": 739503}, "heldout_evaluation_records": {"const": 691}, "silver_distributions_sum_to_output": {"const": true}, "evaluation_isolated_from_non_evaluation_views": {"const": true}, "silver_lanes_block_all_silver_records": {"const": true}, "silver_and_correction_contracts_deny_training_or_export": {"const": true}}},
    "product_truth": {"type": "object", "additionalProperties": false, "required": ["corpus_inventory", "continued_pretraining", "silver", "heldout_evaluation"], "properties": {"corpus_inventory": {"$ref": "#/$defs/corpusInventory"}, "continued_pretraining": {"type": "object", "additionalProperties": false, "required": ["faithful", "modern"], "properties": {"faithful": {"$ref": "#/$defs/cpt"}, "modern": {"$ref": "#/$defs/cpt"}}}, "silver": {"type": "object", "additionalProperties": false, "required": ["records", "distributions", "record_learning_or_export_eligible", "lanes"], "properties": {"records": {"const": 739503}, "distributions": {"type": "object", "additionalProperties": false, "required": ["by_disposition", "by_evidence_grade", "by_source_family", "by_period", "by_genre", "by_register"], "properties": {"by_disposition": {"$ref": "#/$defs/distribution"}, "by_evidence_grade": {"$ref": "#/$defs/distribution"}, "by_source_family": {"$ref": "#/$defs/distribution"}, "by_period": {"$ref": "#/$defs/distribution"}, "by_genre": {"$ref": "#/$defs/distribution"}, "by_register": {"$ref": "#/$defs/distribution"}}}, "record_learning_or_export_eligible": {"const": false}, "lanes": {"type": "object", "additionalProperties": false, "required": ["correction_instruction", "pairwise_preference", "quality_filter"], "properties": {"correction_instruction": {"$ref": "#/$defs/lane"}, "pairwise_preference": {"$ref": "#/$defs/lane"}, "quality_filter": {"$ref": "#/$defs/lane"}}}}}, "heldout_evaluation": {"type": "object", "additionalProperties": false, "required": ["records", "learning_eligible", "isolation_verified"], "properties": {"records": {"const": 691}, "learning_eligible": {"const": false}, "isolation_verified": {"const": true}}}}},
    "empty_lane_explanation": {"type": "object", "additionalProperties": false, "required": ["blocked_records", "reason", "interpretation", "reclassification_performed"], "properties": {"blocked_records": {"const": 739503}, "reason": {"const": "The current silver and correction contracts force model training/export eligibility false."}, "interpretation": {"const": "This contract state does not determine whether source material is usable."}, "reclassification_performed": {"const": false}}},
    "payload_availability": {"type": "object", "additionalProperties": false, "required": ["faithful_continued_pretraining", "modern_continued_pretraining", "heldout_evaluation"], "properties": {"faithful_continued_pretraining": {"$ref": "#/$defs/availability"}, "modern_continued_pretraining": {"$ref": "#/$defs/availability"}, "heldout_evaluation": {"$ref": "#/$defs/availability"}}},
    "public_release_and_redistribution": {"type": "object", "additionalProperties": false, "required": ["status", "publication_performed_in_receipts", "redistribution_permission_evidence", "note"], "properties": {"status": {"const": "unknown"}, "publication_performed_in_receipts": {"const": false}, "redistribution_permission_evidence": {"const": "unknown"}, "note": {"const": "No receipt evidence authorizes public release or redistribution; absence is not permission."}}},
    "safety_claims": {"type": "object", "additionalProperties": false, "required": ["training_performed", "model_call_performed", "upload_performed", "publication_performed", "human_gold_created", "record_text_emitted"], "properties": {"training_performed": {"const": false}, "model_call_performed": {"const": false}, "upload_performed": {"const": false}, "publication_performed": {"const": false}, "human_gold_created": {"const": false}, "record_text_emitted": {"const": false}}},
    "phase_1_entry_conditions": {"type": "object", "additionalProperties": false, "required": ["state", "satisfied"], "properties": {"state": {"const": "ready"}, "satisfied": {"const": ["receipt_reconciliation", "no_reclassification", "receipt_only_no_payload_text", "evaluation_isolation", "mutation_canary_contract_bound"]}}},
    "phase_1_remaining_deliverables": {"const": ["deterministic_document_signal_manifest", "planted_mutation_canary_harness", "lineage_and_limitations_receipt", "source_family_rights_state_input"]}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "file": {"type": "object", "additionalProperties": false, "required": ["bytes", "sha256"], "properties": {"bytes": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["bytes", "records", "sha256"], "properties": {"bytes": {"type": "integer", "minimum": 0}, "records": {"type": "integer", "minimum": 0}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "distribution": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "integer", "minimum": 0}},
    "cpt": {"type": "object", "additionalProperties": false, "required": ["records", "record_learning_eligible", "operation_training_authorized"], "properties": {"records": {"const": 1028}, "record_learning_eligible": {"const": true}, "operation_training_authorized": {"const": false}}},
    "corpusInventory": {"type": "object", "additionalProperties": false, "required": ["public_or_external_source", "historical_combined_gate", "capability_specific_wikipedia_cpt_rows", "interpretation"], "properties": {"public_or_external_source": {"type": "object", "additionalProperties": false, "required": ["database_rows", "database_rows_unit", "lexical_words", "lexical_words_unit"], "properties": {"database_rows": {"const": 189150}, "database_rows_unit": {"const": "database_rows"}, "lexical_words": {"const": 50298925}, "lexical_words_unit": {"const": "lexical_words"}}}, "historical_combined_gate": {"type": "object", "additionalProperties": false, "required": ["potential_training_admission_assets", "scope"], "properties": {"potential_training_admission_assets": {"const": 0}, "scope": {"const": "historical_existing_asset_inventory"}}}, "capability_specific_wikipedia_cpt_rows": {"const": 1028}, "interpretation": {"const": "The historical asset-inventory gate is distinct from later capability-specific Wikipedia CPT rows."}}},
    "lane": {"type": "object", "additionalProperties": false, "required": ["state", "eligible", "emitted", "blocked", "blocked_reasons", "artifact", "receipt"], "properties": {"state": {"const": "blocked"}, "eligible": {"const": 0}, "emitted": {"const": 0}, "blocked": {"const": 739503}, "blocked_reasons": {"const": ["no_eligible_records"]}, "artifact": {"$ref": "#/$defs/emptyArtifact"}, "receipt": {"$ref": "#/$defs/emptyArtifact"}}},
    "emptyArtifact": {"type": "object", "additionalProperties": false, "required": ["bytes", "records", "sha256"], "properties": {"bytes": {"const": 0}, "records": {"const": 0}, "sha256": {"const": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"}}},
    "availability": {"type": "object", "additionalProperties": false, "required": ["logical_path", "state", "receipt_artifact"], "properties": {"logical_path": {"type": "string", "minLength": 1}, "state": {"const": "not_present_in_checkout"}, "receipt_artifact": {"$ref": "#/$defs/artifact"}}},
    "condition": {"type": "object", "additionalProperties": false, "required": ["code", "state", "evidence_sha256"], "properties": {"code": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,127}$"}, "state": {"enum": ["satisfied", "pending", "blocked", "not_applicable"]}, "evidence_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}}}
  }
}
