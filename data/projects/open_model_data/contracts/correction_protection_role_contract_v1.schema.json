{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learn-ukrainian.github.io/schemas/open-model-data/correction_protection_role_contract_v1.schema.json",
  "title": "Phase 3 correction/protection exclusive decision-role freeze v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_inputs", "identity_exclusivity_contract", "root", "seats", "heldout_acl", "task_bindings"],
  "properties": {
    "schema_version": {"const": "correction_protection_role_contract_v1"},
    "contract_inputs": {"$ref": "#/$defs/contractInputs"},
    "identity_exclusivity_contract": {"const": {"scope": "entire_phase3_recovery_program", "registry": "durable_program_identity_registry", "one_natural_person_or_continuing_agent_identity_per_decision_role_maximum": true, "same_controller_reuses_identity_across_sessions_task_ids_harnesses_models_and_providers": true, "controller_identity_attestation_required_before_role_action": true, "assigned_controller_identity_ids_unique_across_decision_seats": true, "root_controller_identity_forbidden_from_decision_seats": true, "unassigned_reserved_seats_may_not_act_or_issue_receipts": true, "task_binding_must_match_seat_controller_identity": true}},
    "root": {"type": "object", "additionalProperties": false, "required": ["controller_identity_id", "decision_role_ids", "may_hold_decision_role"], "properties": {"controller_identity_id": {"type": "string", "pattern": "^controller_[a-z0-9_]+$"}, "decision_role_ids": {"type": "array", "maxItems": 0}, "may_hold_decision_role": {"const": false}}},
    "seats": {"type": "array", "minItems": 10, "maxItems": 10, "prefixItems": [{"allOf": [{"$ref": "#/$defs/seat"}, {"properties": {"seat_id": {"const": "seat_scope_circularity_critic"}, "role_id": {"const": "scope_circularity_critic"}}}]}, {"allOf": [{"$ref": "#/$defs/seat"}, {"properties": {"seat_id": {"const": "seat_ukrainian_source_reviewer"}, "role_id": {"const": "ukrainian_source_reviewer"}}}]}, {"allOf": [{"$ref": "#/$defs/seat"}, {"properties": {"seat_id": {"const": "seat_rule_author_extractor"}, "role_id": {"const": "rule_author_extractor"}}}]}, {"allOf": [{"$ref": "#/$defs/seat"}, {"properties": {"seat_id": {"const": "seat_heldout_steward"}, "role_id": {"const": "heldout_steward"}}}]}, {"allOf": [{"$ref": "#/$defs/seat"}, {"properties": {"seat_id": {"const": "seat_heldout_label_reviewer"}, "role_id": {"const": "heldout_label_reviewer"}}}]}, {"allOf": [{"$ref": "#/$defs/seat"}, {"properties": {"seat_id": {"const": "seat_scorer"}, "role_id": {"const": "scorer"}}}]}, {"allOf": [{"$ref": "#/$defs/seat"}, {"properties": {"seat_id": {"const": "seat_outsider_reproducer"}, "role_id": {"const": "outsider_reproducer"}}}]}, {"allOf": [{"$ref": "#/$defs/seat"}, {"properties": {"seat_id": {"const": "seat_cross_family_code_infra_reviewer"}, "role_id": {"const": "cross_family_code_infra_reviewer"}}}]}, {"allOf": [{"$ref": "#/$defs/seat"}, {"properties": {"seat_id": {"const": "seat_disposition_auditor"}, "role_id": {"const": "disposition_auditor"}}}]}, {"allOf": [{"$ref": "#/$defs/seat"}, {"properties": {"seat_id": {"const": "seat_textbook_nonhit_auditor"}, "role_id": {"const": "textbook_nonhit_auditor"}}}]}], "items": false},
    "heldout_acl": {"$ref": "#/$defs/heldoutAcl"},
    "task_bindings": {"type": "array", "minItems": 10, "maxItems": 10, "prefixItems": [{"allOf": [{"$ref": "#/$defs/taskBinding"}, {"properties": {"role_id": {"const": "scope_circularity_critic"}}}]}, {"allOf": [{"$ref": "#/$defs/taskBinding"}, {"properties": {"role_id": {"const": "ukrainian_source_reviewer"}}}]}, {"allOf": [{"$ref": "#/$defs/taskBinding"}, {"properties": {"role_id": {"const": "rule_author_extractor"}}}]}, {"allOf": [{"$ref": "#/$defs/taskBinding"}, {"properties": {"role_id": {"const": "heldout_steward"}}}]}, {"allOf": [{"$ref": "#/$defs/taskBinding"}, {"properties": {"role_id": {"const": "heldout_label_reviewer"}}}]}, {"allOf": [{"$ref": "#/$defs/taskBinding"}, {"properties": {"role_id": {"const": "scorer"}}}]}, {"allOf": [{"$ref": "#/$defs/taskBinding"}, {"properties": {"role_id": {"const": "outsider_reproducer"}}}]}, {"allOf": [{"$ref": "#/$defs/taskBinding"}, {"properties": {"role_id": {"const": "cross_family_code_infra_reviewer"}}}]}, {"allOf": [{"$ref": "#/$defs/taskBinding"}, {"properties": {"role_id": {"const": "disposition_auditor"}}}]}, {"allOf": [{"$ref": "#/$defs/taskBinding"}, {"properties": {"role_id": {"const": "textbook_nonhit_auditor"}}}]}], "items": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "contractInputs": {"type": "object", "additionalProperties": false, "required": ["original_prompt_sha256", "scope_amendment_sha256", "combined_contract_sha256"], "properties": {"original_prompt_sha256": {"$ref": "#/$defs/sha256"}, "scope_amendment_sha256": {"$ref": "#/$defs/sha256"}, "combined_contract_sha256": {"$ref": "#/$defs/sha256"}}},
    "seat": {"type": "object", "additionalProperties": false, "required": ["seat_id", "role_id", "assignment_state", "controller_identity_id", "controller_identity_attested", "ukrainian_capable_required", "may_decide", "must_not"], "properties": {"seat_id": {"type": "string", "pattern": "^seat_[a-z0-9_]+$"}, "role_id": {"enum": ["scope_circularity_critic", "ukrainian_source_reviewer", "rule_author_extractor", "heldout_steward", "heldout_label_reviewer", "scorer", "outsider_reproducer", "cross_family_code_infra_reviewer", "disposition_auditor", "textbook_nonhit_auditor"]}, "assignment_state": {"enum": ["assigned_verified", "reserved_unassigned"]}, "controller_identity_id": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^controller_[a-z0-9_]+$"}]}, "controller_identity_attested": {"type": "boolean"}, "ukrainian_capable_required": {"type": "boolean"}, "may_decide": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "must_not": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}, "allOf": [{"if": {"properties": {"assignment_state": {"const": "assigned_verified"}}}, "then": {"properties": {"controller_identity_id": {"type": "string", "pattern": "^controller_[a-z0-9_]+$"}, "controller_identity_attested": {"const": true}}}}, {"if": {"properties": {"assignment_state": {"const": "reserved_unassigned"}}}, "then": {"properties": {"controller_identity_id": {"const": null}, "controller_identity_attested": {"const": false}}}}]},
    "heldoutAcl": {"type": "object", "additionalProperties": false, "required": ["pre_release_read_roles", "post_release_scorer_roles", "forbidden_roles"], "properties": {"pre_release_read_roles": {"const": ["heldout_steward", "heldout_label_reviewer"]}, "post_release_scorer_roles": {"const": ["scorer"]}, "forbidden_roles": {"const": ["scope_circularity_critic", "ukrainian_source_reviewer", "rule_author_extractor", "outsider_reproducer", "cross_family_code_infra_reviewer", "disposition_auditor", "textbook_nonhit_auditor"]}}},
    "taskBinding": {"type": "object", "additionalProperties": false, "required": ["role_id", "reserved_task_id", "controller_identity_id", "status", "artifact_approval_claimed", "program_completion_claimed"], "properties": {"role_id": {"type": "string", "pattern": "^[a-z0-9_]+$"}, "reserved_task_id": {"type": "string", "minLength": 1}, "controller_identity_id": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^controller_[a-z0-9_]+$"}]}, "status": {"enum": ["reserved_not_launched", "identity_attested_pre_artifact", "combined_contract_text_approved_pre_artifact"]}, "artifact_approval_claimed": {"const": false}, "program_completion_claimed": {"const": false}}, "allOf": [{"if": {"properties": {"status": {"enum": ["identity_attested_pre_artifact", "combined_contract_text_approved_pre_artifact"]}}}, "then": {"properties": {"controller_identity_id": {"type": "string", "pattern": "^controller_[a-z0-9_]+$"}}}}, {"if": {"properties": {"status": {"const": "reserved_not_launched"}}}, "then": {"properties": {"controller_identity_id": {"const": null}}}}]}
  }
}
