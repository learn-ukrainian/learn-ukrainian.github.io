{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learn-ukrainian.github.io/schemas/open-model-data/correction_protection_disagreement_v1.schema.json",
  "title": "Correction/protection model disagreement record v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "disagreement_id", "case_id", "proposals", "evidence_refs", "challenge", "consensus", "claim_boundary"],
  "properties": {
    "schema_version": {"const": "correction_protection_disagreement_v1"}, "disagreement_id": {"type": "string", "pattern": "^cp_disagreement:[a-f0-9]{64}$"}, "case_id": {"type": "string", "pattern": "^cp_case:[a-f0-9]{64}$"},
    "proposals": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/proposal"}}, "evidence_refs": {"$ref": "#/$defs/refs"}, "challenge": {"type": "string", "minLength": 1},
    "consensus": {"type": "object", "additionalProperties": false, "required": ["state", "human_reviewed", "human_gold", "authoritative"], "properties": {"state": {"enum": ["none", "model_only", "unresolved"]}, "human_reviewed": {"const": false}, "human_gold": {"const": false}, "authoritative": {"const": false}}},
    "claim_boundary": {"type": "object", "additionalProperties": false, "required": ["assurance_tier", "authoritative"], "properties": {"assurance_tier": {"const": "evidence_graded_non_gold"}, "authoritative": {"const": false}}}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "proposal": {"type": "object", "additionalProperties": false, "required": ["provider", "family", "harness", "exact_model_id", "proposal_sha256", "evidence_refs", "dissent"], "properties": {"provider": {"type": "string", "minLength": 1}, "family": {"type": "string", "minLength": 1}, "harness": {"type": "string", "minLength": 1}, "exact_model_id": {"type": "string", "minLength": 1}, "proposal_sha256": {"$ref": "#/$defs/sha256"}, "evidence_refs": {"$ref": "#/$defs/refs"}, "dissent": {"type": "string", "minLength": 1}}}}
}
