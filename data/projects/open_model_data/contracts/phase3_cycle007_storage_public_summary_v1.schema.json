{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learn-ukrainian.github.io/schemas/open-model-data/phase3_cycle007_storage_public_summary_v1.schema.json",
  "title": "Phase 3 Cycle 007 storage lane public summary v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "text_free",
    "outcome_sha256",
    "handoff_receipt_sha256",
    "issue",
    "epic",
    "private_binding_state",
    "retention_outcome",
    "deletion_authorized",
    "issue_7434_is_not_deletion_authorization",
    "authorization_gate",
    "public_packet_count",
    "public_row_count",
    "labeling_state",
    "provider_calls",
    "provider_derived_training_labels",
    "evaluation_firewall_requires_cycle007_identities",
    "production_inventory_frozen",
    "fixture_representation_proven",
    "receipt_sha256"
  ],
  "properties": {
    "schema_version": {"const": "phase3_cycle007_storage_public_summary_v1"},
    "text_free": {"const": true},
    "outcome_sha256": {"$ref": "#/$defs/sha256"},
    "handoff_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "issue": {"const": 7434},
    "epic": {"const": 7423},
    "private_binding_state": {"enum": ["BOUND", "UNBOUND"]},
    "reconcile_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "retention_outcome": {
      "enum": ["RETAIN_MINIMAL_EVALUATION_ASSET", "RETIRE_CYCLE007"]
    },
    "retention_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "retention_rationale_code": {"type": "string", "minLength": 1},
    "deletion_authorized": {"const": false},
    "issue_7434_is_not_deletion_authorization": {"const": true},
    "authorization_gate": {"type": "string", "minLength": 1},
    "stopped_at": {"type": "string", "minLength": 1},
    "safe_failure_code": {
      "anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]
    },
    "public_packet_count": {"const": 204},
    "public_row_count": {"const": 10159},
    "labeling_state": {"const": "OFF"},
    "provider_calls": {"const": 0},
    "provider_derived_training_labels": {"const": 0},
    "evaluation_firewall_requires_cycle007_identities": {"type": "boolean"},
    "production_inventory_frozen": {"type": "boolean"},
    "fixture_representation_proven": {"type": "boolean"},
    "workstation_filesystem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frsize", "blocks", "bfree", "bavail", "total_bytes", "free_bytes", "avail_bytes"],
      "properties": {
        "frsize": {"type": "integer", "minimum": 1},
        "blocks": {"type": "integer", "minimum": 0},
        "bfree": {"type": "integer", "minimum": 0},
        "bavail": {"type": "integer", "minimum": 0},
        "total_bytes": {"type": "integer", "minimum": 0},
        "free_bytes": {"type": "integer", "minimum": 0},
        "avail_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "fixture_lane_complete": {"type": "boolean"},
    "fixture_packet_count": {"type": "integer", "minimum": 1},
    "fixture_row_count": {"type": "integer", "minimum": 1},
    "fixture_object_count": {"type": "integer", "minimum": 1},
    "fixture_total_allocated_bytes": {"type": "integer", "minimum": 0},
    "fixture_compact_stored_allocated_bytes": {"type": "integer", "minimum": 0},
    "fixture_reclaimed_byte_forecast": {"type": "integer", "minimum": 0},
    "fixture_deletion_candidate_count": {"type": "integer", "minimum": 0},
    "fixture_identity_proof_ok": {"type": "boolean"},
    "fixture_backup_restore_ok": {"type": "boolean"},
    "fixture_roundtrip_ok": {"type": "boolean"},
    "fixture_lane_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "fixture_peak_temporary_bytes": {"type": "integer", "minimum": 0},
    "fixture_capacity_sufficient_for_peak": {"type": "boolean"},
    "fixture_filesystem_avail_bytes": {"type": "integer", "minimum": 0},
    "receipt_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
