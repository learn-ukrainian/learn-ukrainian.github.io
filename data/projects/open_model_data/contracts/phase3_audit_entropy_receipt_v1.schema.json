{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learn-ukrainian.github.io/schemas/open-model-data/phase3_audit_entropy_receipt_v1.schema.json",
  "title": "Phase 3 approved common anti-grinding entropy receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "text_free", "purpose", "frozen_universe_sha256", "frozen_population_sha256", "sampler_plan_sha256", "frozen_artifact_path", "frozen_artifact_sha256", "auditor_role_id", "auditor_task_id", "base_contract_sha256", "amendment_sha256", "combined_contract_sha256", "functional_role_contract_sha256", "conflict_graph_sha256", "evaluation_cycle_id", "auditor_only_nonce_commitment", "nonce_commitment_count", "auditor_nonce_commitment_sha256", "auditor_nonce", "author_or_root_choices", "root_choice_count", "reroll_count", "first_containing_merge_sha"],
  "properties": {
    "schema_version": {"const": "phase3_audit_entropy_receipt_v1"},
    "text_free": {"const": true},
    "purpose": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "frozen_universe_sha256": {"$ref": "#/$defs/sha256"},
    "frozen_population_sha256": {"$ref": "#/$defs/sha256"},
    "sampler_plan_sha256": {"$ref": "#/$defs/sha256"},
    "frozen_artifact_path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"},
    "frozen_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "auditor_role_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "auditor_task_id": {"type": "string", "pattern": "^phase3-v2-1-[a-z0-9-]+$"},
    "base_contract_sha256": {"$ref": "#/$defs/sha256"},
    "amendment_sha256": {"$ref": "#/$defs/sha256"},
    "combined_contract_sha256": {"$ref": "#/$defs/sha256"},
    "functional_role_contract_sha256": {"$ref": "#/$defs/sha256"},
    "conflict_graph_sha256": {"$ref": "#/$defs/sha256"},
    "evaluation_cycle_id": {"const": "phase3-v2-1-evaluation-cycle-001"},
    "auditor_only_nonce_commitment": {"const": true},
    "nonce_commitment_count": {"const": 1},
    "auditor_nonce_commitment_sha256": {"$ref": "#/$defs/sha256"},
    "auditor_nonce": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "author_or_root_choices": {"const": false},
    "root_choice_count": {"const": 0},
    "reroll_count": {"const": 0},
    "first_containing_merge_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
