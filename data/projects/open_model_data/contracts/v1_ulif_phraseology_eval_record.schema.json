{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learn-ukrainian.github.io/schemas/open-model-data/v1_ulif_phraseology_eval_record.schema.json",
  "title": "v1_ulif_phraseology_eval_record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eval_id",
    "target_idiom",
    "calqued_counterpart",
    "eval_category",
    "query",
    "reference_reasoning",
    "reference_solution",
    "classical_citation",
    "classical_author",
    "source_metadata"
  ],
  "properties": {
    "eval_id": {
      "type": "string",
      "pattern": "^eval_ulif_phras_[a-f0-9]{8}$"
    },
    "target_idiom": {
      "type": "string",
      "minLength": 2
    },
    "calqued_counterpart": {
      "type": ["string", "null"]
    },
    "eval_category": {
      "type": "string",
      "enum": [
        "authentic_idiom_usage",
        "anti_calque_decolonization",
        "figurative_reasoning",
        "synonymic_register_distinction"
      ]
    },
    "query": {
      "type": "string",
      "minLength": 10
    },
    "reference_reasoning": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "minLength": 5
      }
    },
    "reference_solution": {
      "type": "string",
      "minLength": 15
    },
    "classical_citation": {
      "type": "string",
      "minLength": 5
    },
    "classical_author": {
      "type": "string",
      "minLength": 2
    },
    "source_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_dict",
        "partition",
        "entry_id",
        "char_length"
      ],
      "properties": {
        "source_dict": {
          "type": "string"
        },
        "partition": {
          "type": "string",
          "const": "held_out_eval"
        },
        "entry_id": {
          "type": "string"
        },
        "char_length": {
          "type": "integer",
          "minimum": 5
        }
      }
    }
  }
}
