            "sha256": {"const": "9f3113776f899759dc9d4bdde9cde8e3fd5c85f5b3e6e748bf0ac79fac28a29c"}
          }
        },
        "p2_canonical_contracts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": {"const": "data/projects/open_model_data/evidence/phase3_p2_canonical_contracts_v1.json"},
            "sha256": {"const": "dc8dfdf207728ef386cea14ddb328289b2beee5159afb98bf076e5f117602ea3"}
          }
        },
        "p1_dialect_amendment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": {"const": "data/projects/open_model_data/evidence/phase3_p1_dialect_regional_protection_amendment_v1.json"},
            "sha256": {"const": "5a4b259f764a3d41499f0a989c02fed921c18b62c9831d361d18d19dcc948afa"}
          }
        },
        "p4_v1": {"$ref": "#/$defs/p4Binding"},
        "v2_parent_outcome_sha256": {"const": "890498103f96a7b8f27fd52bc14418d8752e5b73a72ed8774dd0f52eb3160a47"}
      }
    },
    "taxonomyAxis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axis_id", "required", "values", "independent_from"],
      "properties": {
        "axis_id": {"enum": ["language_identity", "identity_candidates", "diachronic_status", "variety_status", "variety_id", "period_id", "region_id", "register_id", "contact_composition", "context_role", "recension_editorial_layer_id"]},
        "required": {"const": true},
        "values": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "independent_from": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    },
    "surfaceLayer": {
      "type": "object",
