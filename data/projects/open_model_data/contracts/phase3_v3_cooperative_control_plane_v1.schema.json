      "required": ["state_id", "counts_toward_coverage", "gold_eligible", "training_eligible", "evaluation_eligible", "teaching_view_eligible", "unsampled_promotion_allowed", "promotion_state", "protected_high_risk_always_human", "high_risk_classes", "critic_unresolved_routes_to_human"],
      "properties": {
        "state_id": {"const": "MODEL_AGREEMENT_QUARANTINED_NOT_GOLD"},
        "counts_toward_coverage": {"const": false},
        "gold_eligible": {"const": false},
        "training_eligible": {"const": false},
        "evaluation_eligible": {"const": false},
        "teaching_view_eligible": {"const": false},
