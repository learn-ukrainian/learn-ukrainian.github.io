    "rights_capabilities": {"$ref": "#/$defs/rightsCapabilities"},
    "roles": {"type": "array", "minItems": 9, "maxItems": 9, "uniqueItems": true, "items": {"$ref": "#/$defs/role"}},
    "visibility_matrix": {"type": "array", "minItems": 9, "maxItems": 9, "uniqueItems": true, "items": {"$ref": "#/$defs/visibilityEntry"}},
    "conflict_contract": {"$ref": "#/$defs/conflictContract"},
    "state_machine": {"$ref": "#/$defs/stateMachine"},
    "agreement_predicate": {"$ref": "#/$defs/agreementPredicate"},
    "quarantine_policy": {"$ref": "#/$defs/quarantinePolicy"},
    "human_work_manifest": {"$ref": "#/$defs/humanWorkManifest"},
    "heldout_firewall": {"$ref": "#/$defs/heldoutFirewall"},
    "compatibility": {"$ref": "#/$defs/compatibility"},
    "child_work_slots": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": {"$ref": "#/$defs/childWorkSlot"}},
    "gates": {"$ref": "#/$defs/gates"},
    "receipt_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_.:/-]+$"},
    "path": {"type": "string", "minLength": 1, "pattern": "^[^/].*"},
    "artifactBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {"path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "outcomeBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v2_parent_outcome_sha256",
        "reviewed_v3_consensus_sha256",
        "amendment_kind",
        "dataset_nonempty_claimed",
        "dataset_ready_claimed",
        "training_validated_claimed",
        "labeling_enabled",
        "training_enabled",
        "mass_provider_work_enabled"
      ],
      "properties": {
        "v2_parent_outcome_sha256": {"const": "890498103f96a7b8f27fd52bc14418d8752e5b73a72ed8774dd0f52eb3160a47"},
        "reviewed_v3_consensus_sha256": {"const": "d3444c126deb91d05129d51c5344aa204b1db9ca0927c246698e0389466d0b1a"},
        "amendment_kind": {"const": "additive_versioned_amendment"},
        "dataset_nonempty_claimed": {"const": false},
        "dataset_ready_claimed": {"const": false},
        "training_validated_claimed": {"const": false},
        "labeling_enabled": {"const": false},
        "training_enabled": {"const": false},
        "mass_provider_work_enabled": {"const": false}
      }
    },
    "p4Binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "admission_file", "admission_receipt_sha256", "status", "denominator"],
      "properties": {
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": {"const": "data/projects/open_model_data/contracts/phase3_p4_pilot_construction_v1.schema.json"},
            "sha256": {"const": "0af9e421a0a734718ff884a2b08286533c8f6f6af24c1be4b9023044719f1e8f"}
          }
        },
        "admission_file": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": {"const": "data/projects/open_model_data/admission/phase3_p4_pilot_construction_v1.json"},
