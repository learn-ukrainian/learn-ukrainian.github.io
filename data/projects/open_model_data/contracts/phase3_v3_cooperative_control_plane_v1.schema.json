          }
        },
        "admission_receipt_sha256": {"const": "9d070d83ab9978d71c0f09249adca4738beb3395215fc603c33e8aeae61e8881"},
        "status": {"const": "BLOCKED_PENDING_SOURCE_QUALIFIED_ADJUDICATION"},
        "denominator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_units", "unknown_rights_blockers", "base_required_cells", "composite_required_cells", "coverage_blocked_cells", "not_applicable_cells", "rule_slots_R"],
          "properties": {
            "source_units": {"const": 57},
            "unknown_rights_blockers": {"const": 39},
            "base_required_cells": {"const": 15},
            "composite_required_cells": {"const": 16},
            "coverage_blocked_cells": {"const": 14},
            "not_applicable_cells": {"const": 2},
            "rule_slots_R": {"const": 0}
          }
        }
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "validator", "v2_compatibility_matrix", "p2_canonical_contracts", "p1_dialect_amendment", "p4_v1", "v2_parent_outcome_sha256"],
      "properties": {
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": {"const": "data/projects/open_model_data/contracts/phase3_v3_cooperative_control_plane_v1.schema.json"},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "validator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": {"const": "scripts/projects/open_model_data/phase3_v3_cooperative_control_plane.py"},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "v2_compatibility_matrix": {
          "type": "object",
