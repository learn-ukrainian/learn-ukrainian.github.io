        "unknown_blocks_only_affected_operation": {"const": true},
        "availability_grants_no_capability": {"const": true},
        "denominator_visibility_preserved": {"const": true}
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route_id", "route_kind", "provider_family", "model", "effort_or_exposure"],
      "properties": {
        "route_id": {"$ref": "#/$defs/id"},
        "route_kind": {"enum": ["deterministic", "model", "human"]},
        "provider_family": {"$ref": "#/$defs/id"},
        "model": {"$ref": "#/$defs/id"},
        "effort_or_exposure": {"$ref": "#/$defs/id"}
      }
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role_id", "preferred_route", "output_contract_id", "may_access_heldout", "may_author_gold", "may_count_toward_coverage"],
      "properties": {
        "role_id": {"enum": ["SOURCE_ADMISSION", "SPLIT_CUSTODY", "IDENTITY_LEAD", "INDEPENDENT_DISSENT", "DISPUTE_CRITIC", "CANDIDATE_BUILDER", "HUMAN_STEWARD", "EVALUATION_STEWARD", "ORCHESTRATOR"]},
        "preferred_route": {"$ref": "#/$defs/route"},
        "output_contract_id": {"$ref": "#/$defs/id"},
        "may_access_heldout": {"type": "boolean"},
        "may_author_gold": {"type": "boolean"},
        "may_count_toward_coverage": {"type": "boolean"}
      }
    },
    "visibilityEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role_id", "allowed_input_classes", "forbidden_input_classes", "output_contract_id", "next_legal_transition_classes", "retry_budget", "substitute_budget", "heldout_access", "coverage_credit", "gold_credit", "training_credit"],
      "properties": {
        "role_id": {"enum": ["SOURCE_ADMISSION", "SPLIT_CUSTODY", "IDENTITY_LEAD", "INDEPENDENT_DISSENT", "DISPUTE_CRITIC", "CANDIDATE_BUILDER", "HUMAN_STEWARD", "EVALUATION_STEWARD", "ORCHESTRATOR"]},
        "allowed_input_classes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "forbidden_input_classes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "output_contract_id": {"$ref": "#/$defs/id"},
        "next_legal_transition_classes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "retry_budget": {"type": "integer", "minimum": 0, "maximum": 1},
        "substitute_budget": {"type": "integer", "minimum": 0, "maximum": 1},
        "heldout_access": {"enum": ["forbidden", "evaluation_runtime_only"]},
        "coverage_credit": {"const": false},
        "gold_credit": {"const": false},
        "training_credit": {"const": false}
      }
    },
    "conflictContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["same_packet_for_identity_roles", "identity_outputs_hidden_from_each_other", "builder_receives_identity_opinions", "builder_receives_candidate_identity_labels", "critic_receives_model_prestige_or_order", "model_may_vote_on_own_output", "independent_family_required", "operations"],
      "properties": {
        "same_packet_for_identity_roles": {"const": true},
        "identity_outputs_hidden_from_each_other": {"const": true},
        "builder_receives_identity_opinions": {"const": false},
        "builder_receives_candidate_identity_labels": {"const": false},
        "critic_receives_model_prestige_or_order": {"const": false},
        "model_may_vote_on_own_output": {"const": false},
        "independent_family_required": {"const": true},
        "operations": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"$ref": "#/$defs/conflictOperation"}}
      }
    },
    "conflictOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["producer_role", "consumer_role", "shared_input_classes_forbidden", "output_visibility"],
      "properties": {
        "producer_role": {"enum": ["IDENTITY_LEAD", "INDEPENDENT_DISSENT", "DISPUTE_CRITIC", "CANDIDATE_BUILDER"]},
        "consumer_role": {"enum": ["IDENTITY_LEAD", "INDEPENDENT_DISSENT", "DISPUTE_CRITIC", "CANDIDATE_BUILDER"]},
        "shared_input_classes_forbidden": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "output_visibility": {"enum": ["locked_disagreement_only", "identity_join_without_opinions", "never_shared"]}
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state_id", "terminal", "resumable", "legal_next_states", "resume_to_state", "counts_toward_coverage", "gold_eligible", "training_eligible"],
      "properties": {
        "state_id": {"$ref": "#/$defs/stateId"},
        "terminal": {"type": "boolean"},
        "resumable": {"type": "boolean"},
        "legal_next_states": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/stateId"}},
        "resume_to_state": {"anyOf": [{"$ref": "#/$defs/stateId"}, {"type": "null"}]},
        "counts_toward_coverage": {"type": "boolean"},
        "gold_eligible": {"type": "boolean"},
        "training_eligible": {"type": "boolean"}
      }
    },
    "stateId": {
      "enum": [
        "SOURCE_INVENTORIED",
        "SOURCE_ADMITTED",
        "SOURCE_BLOCKED",
        "SPLIT_SEALED",
        "IDENTITY_REVIEWS_PENDING",
        "IDENTITY_AGREEMENT_QC",
        "IDENTITY_DISPUTED",
        "IDENTITY_PROVIDER_FAILURE",
        "IDENTITY_HUMAN_QUEUE",
        "DISPUTE_CRITIC_PENDING",
        "DISPUTE_CRITIQUED",
        "IDENTITY_HUMAN_ADJUDICATED",
        "IDENTITY_HUMAN_ABSTAINED",
        "IDENTITY_EVIDENCE_INSUFFICIENT",
        "MODEL_AGREEMENT_QUARANTINED_NOT_GOLD",
        "CASE_CANDIDATE_PENDING",
        "CASE_CANDIDATE_PROPOSED",
        "CANDIDATE_PROVIDER_FAILURE",
        "CASE_HUMAN_QUEUE",
        "CASE_HUMAN_ADJUDICATED",
        "CASE_HUMAN_ABSTAINED",
        "CASE_EVIDENCE_INSUFFICIENT",
        "GOLD_ELIGIBLE",
        "TRAINING_ELIGIBLE"
      ]
