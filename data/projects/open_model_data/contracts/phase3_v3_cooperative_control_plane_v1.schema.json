{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learn-ukrainian.github.io/schemas/open-model-data/phase3_v3_cooperative_control_plane_v1.schema.json",
  "title": "Phase 3 V3 cooperative control-plane contract v1",
  "description": "Reviewed, text-free contract for the additive V3 bridge. It records roles, visibility, transitions, rights, taxonomy, compatibility, custody, and gates; it contains no source or model output.",
