    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from_state", "to_state", "condition_code", "retry_or_substitute_allowed", "human_fallback"],
      "properties": {
        "from_state": {"$ref": "#/$defs/stateId"},
        "to_state": {"$ref": "#/$defs/stateId"},
        "condition_code": {"$ref": "#/$defs/id"},
        "retry_or_substitute_allowed": {"type": "boolean"},
        "human_fallback": {"type": "boolean"}
      }
