    "status",
    "text_free",
    "metadata_only",
    "provider_calls",
    "outcome_boundary",
    "bindings",
    "taxonomy",
    "rights_capabilities",
    "roles",
    "visibility_matrix",
    "conflict_contract",
    "state_machine",
    "agreement_predicate",
    "quarantine_policy",
    "human_work_manifest",
    "heldout_firewall",
    "compatibility",
    "child_work_slots",
    "gates",
    "receipt_sha256"
  ],
  "properties": {
    "schema_version": {"const": "phase3_v3_cooperative_control_plane_v1"},
    "status": {"const": "FROZEN_REVIEWED_METADATA_ONLY"},
    "text_free": {"const": true},
    "metadata_only": {"const": true},
    "provider_calls": {"const": false},
    "outcome_boundary": {"$ref": "#/$defs/outcomeBoundary"},
    "bindings": {"$ref": "#/$defs/bindings"},
