    "stateMachine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initial_state", "states", "transitions", "format_retry_limit", "failure_denominator_policy", "no_dead_end_invariant"],
      "properties": {
        "initial_state": {"const": "SOURCE_INVENTORIED"},
        "states": {"type": "array", "minItems": 24, "maxItems": 24, "uniqueItems": true, "items": {"$ref": "#/$defs/state"}},
