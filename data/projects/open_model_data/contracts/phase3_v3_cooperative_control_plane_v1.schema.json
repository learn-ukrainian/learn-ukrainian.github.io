            "archaic_forms_protected": {"const": true},
            "dialect_forms_protected": {"const": true},
            "modern_correction_eligible_when_protected": {"const": false},
            "automatic_standard_normalization": {"const": false},
            "automatic_national_successor_mapping": {"const": false}
          }
        },
        "dialect_parent_partition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["parent_cell_id", "parent_artifact", "partition_complete", "membership_frozen", "parent_denominator_visible", "parent_direct_coverage_credit", "partition_dimensions", "child_strata"],
          "properties": {
            "parent_cell_id": {"const": "protection.source_attested_ukrainian_dialect_or_regional_form.dialect_or_regional_form.protected_dialect_or_regional"},
            "parent_artifact": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "sha256"],
              "properties": {
                "path": {"const": "data/projects/open_model_data/evidence/phase3_p1_dialect_regional_protection_amendment_v1.json"},
                "sha256": {"const": "5a4b259f764a3d41499f0a989c02fed921c18b62c9831d361d18d19dcc948afa"}
              }
            },
            "partition_complete": {"const": false},
            "membership_frozen": {"const": false},
            "parent_denominator_visible": {"const": true},
            "parent_direct_coverage_credit": {"const": false},
            "partition_dimensions": {"const": ["source", "region", "period", "register"]},
            "child_strata": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["stratum_id", "parent_cell_id", "dimensions", "source_membership_frozen"],
                "properties": {
                  "stratum_id": {"$ref": "#/$defs/id"},
                  "parent_cell_id": {"const": "protection.source_attested_ukrainian_dialect_or_regional_form.dialect_or_regional_form.protected_dialect_or_regional"},
                  "dimensions": {"const": ["source", "region", "period", "register"]},
                  "source_membership_frozen": {"const": false}
                }
              }
            }
          }
        },
        "identity_boundaries": {
          "type": "object",
          "additionalProperties": false,
          "required": ["dialect_is_protected_ukrainian_variety", "archaic_modern_is_distinct_from_historical_stage", "surzhyk_is_contact_composition", "literary_eye_dialect_is_context_editorial", "rusyn_is_source_attested_identity", "script_does_not_decide_identity", "undecided_evidence_preserves_candidates"],
          "properties": {
            "dialect_is_protected_ukrainian_variety": {"const": true},
            "archaic_modern_is_distinct_from_historical_stage": {"const": true},
            "surzhyk_is_contact_composition": {"const": true},
            "literary_eye_dialect_is_context_editorial": {"const": true},
            "rusyn_is_source_attested_identity": {"const": true},
            "script_does_not_decide_identity": {"const": true},
