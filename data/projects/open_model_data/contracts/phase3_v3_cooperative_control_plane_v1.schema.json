        "tuple_fields": {"const": ["span_offsets", "language_identity", "identity_candidates", "diachronic_status", "variety_status", "variety_id", "period_id", "region_id", "register_id", "contact_composition", "context_role", "recension_editorial_layer_id", "original_surface", "editorial_surface", "normalized_surface"]},
        "axes": {"type": "array", "minItems": 11, "maxItems": 11, "uniqueItems": true, "items": {"$ref": "#/$defs/taxonomyAxis"}},
        "surface_layers": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": {"$ref": "#/$defs/surfaceLayer"}},
        "protected_invariants": {
          "type": "object",
          "additionalProperties": false,
          "required": ["original_surface_preserved", "historical_forms_protected", "archaic_forms_protected", "dialect_forms_protected", "modern_correction_eligible_when_protected", "automatic_standard_normalization", "automatic_national_successor_mapping"],
          "properties": {
