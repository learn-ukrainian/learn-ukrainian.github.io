{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learn-ukrainian.github.io/schemas/open-model-data/dataset_v4_a7_review_receipt_v1.schema.json",
  "title": "Dataset V4 A7 review-of-record receipt v1",
  "description": "Private receipt (never a public artifact) recording the independent, cross-family reviewer of record for a candidate row, and their verdict. Never carries row text, source text, or a source_unit_id.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_id",
    "role",
    "model_family",
    "exact_model",
    "harness",
    "session_id",
    "prompt_sha256",
    "packet_sha256",
    "row_content_sha256",
    "saw_source_text",
    "saw_heldout",
    "saw_eligible_unit_ids",
    "verification_tool_ids",
    "verdict",
    "rubric_sha256",
    "execution_receipt"
  ],
  "properties": {
    "receipt_id": { "type": "string", "minLength": 1 },
    "role": { "const": "reviewer" },
    "model_family": { "type": "string", "minLength": 1 },
    "exact_model": { "type": "string", "minLength": 1 },
    "harness": { "type": "string", "minLength": 1 },
    "session_id": { "type": "string", "minLength": 1 },
    "prompt_sha256": { "$ref": "#/$defs/sha256" },
    "packet_sha256": { "$ref": "#/$defs/sha256" },
    "row_content_sha256": { "$ref": "#/$defs/sha256" },
    "saw_source_text": { "const": false },
    "saw_heldout": { "const": false },
    "saw_eligible_unit_ids": { "const": false },
    "verification_tool_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "verdict": { "enum": ["PASS", "FAIL"] },
    "rubric_sha256": { "$ref": "#/$defs/sha256" },
    "execution_receipt": {
      "type": "object",
      "description": "The signed fleet-execution receipt this review receipt was derived from (see v4_fleet_execution_authority.py). Never a public artifact.",
      "required": ["schema_version", "domain", "signature_hex", "signer_key_id", "task_id", "run_nonce"],
      "properties": {
        "schema_version": { "type": "string", "minLength": 1 },
        "domain": { "const": "reviewer" },
        "signature_hex": { "type": "string", "minLength": 1 },
        "signer_key_id": { "type": "string", "minLength": 1 },
        "task_id": { "type": "string", "minLength": 1 },
        "run_nonce": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
