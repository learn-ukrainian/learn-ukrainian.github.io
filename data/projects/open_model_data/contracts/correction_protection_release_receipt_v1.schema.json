  "properties": {
    "schema_version": {"const": "correction_protection_release_receipt_v1"},
    "inputs": {"$ref": "#/$defs/artifactMap"}, "schemas": {"$ref": "#/$defs/hashMap"}, "config": {"$ref": "#/$defs/hashMap"}, "output": {"$ref": "#/$defs/artifact"}, "counts": {"$ref": "#/$defs/countMap"},
    "category_gates": {"type": "object", "additionalProperties": false, "required": ["russian_lexical_inflectional_intrusion", "contextual_calque_government_valency", "modern_literary_ukrainian_control", "marked_russian_quotation_code_switch", "phonetic_russian_in_literature", "historical_archaic_ukrainian", "dialect_regional_heritage_folklore", "surzhyk_contested_contact"], "properties": {"russian_lexical_inflectional_intrusion": {"$ref": "#/$defs/categoryGate"}, "contextual_calque_government_valency": {"$ref": "#/$defs/categoryGate"}, "modern_literary_ukrainian_control": {"$ref": "#/$defs/categoryGate"}, "marked_russian_quotation_code_switch": {"$ref": "#/$defs/categoryGate"}, "phonetic_russian_in_literature": {"$ref": "#/$defs/categoryGate"}, "historical_archaic_ukrainian": {"$ref": "#/$defs/categoryGate"}, "dialect_regional_heritage_folklore": {"$ref": "#/$defs/categoryGate"}, "surzhyk_contested_contact": {"$ref": "#/$defs/categoryGate"}}},
    "axes_coverage": {"type": "object", "additionalProperties": false, "required": ["source_family", "period", "genre", "register"], "properties": {"source_family": {"$ref": "#/$defs/countMap"}, "period": {"$ref": "#/$defs/countMap"}, "genre": {"$ref": "#/$defs/countMap"}, "register": {"$ref": "#/$defs/countMap"}}},
    "dispositions": {"type": "object", "additionalProperties": false, "required": ["correct", "correction", "protected", "excluded", "unresolved"], "properties": {"correct": {"$ref": "#/$defs/count"}, "correction": {"$ref": "#/$defs/count"}, "protected": {"$ref": "#/$defs/count"}, "excluded": {"$ref": "#/$defs/count"}, "unresolved": {"$ref": "#/$defs/count"}}},
    "evidence_grades": {"$ref": "#/$defs/countMap"}, "disagreement": {"$ref": "#/$defs/artifact"},
    "rights_and_publication": {"type": "object", "additionalProperties": false, "required": ["rights_decision_refs", "publication_decision_refs", "raw_payloads_published"], "properties": {"rights_decision_refs": {"$ref": "#/$defs/refs"}, "publication_decision_refs": {"$ref": "#/$defs/refs"}, "raw_payloads_published": {"const": false}}},
    "contamination_registry": {"$ref": "#/$defs/artifact"},
    "determinism": {"type": "object", "additionalProperties": false, "required": ["algorithm", "algorithm_sha256", "serialization", "timestamps_omitted"], "properties": {"algorithm": {"type": "string", "minLength": 1}, "algorithm_sha256": {"$ref": "#/$defs/sha256"}, "serialization": {"const": "UTF-8 canonical JSON with sorted keys and LF"}, "timestamps_omitted": {"const": true}}},
    "held_back_strategy": {"type": "object", "additionalProperties": false, "required": ["locator", "public_repo_copy"], "properties": {"locator": {"type": "string", "minLength": 1}, "public_repo_copy": {"const": false}}},
    "safety": {"type": "object", "additionalProperties": false, "required": ["project_model_training", "local_model_inference", "external_advisory_model_evidence_used", "upload", "accelerator", "human_gold", "authoritative"], "properties": {"project_model_training": {"const": false}, "local_model_inference": {"const": false}, "external_advisory_model_evidence_used": {"type": "boolean"}, "upload": {"const": false}, "accelerator": {"const": false}, "human_gold": {"const": false}, "authoritative": {"const": false}}}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "count": {"type": "integer", "minimum": 0}, "refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "countMap": {"type": "object", "propertyNames": {"minLength": 1}, "additionalProperties": {"$ref": "#/$defs/count"}}, "hashMap": {"type": "object", "minProperties": 1, "propertyNames": {"minLength": 1}, "additionalProperties": {"$ref": "#/$defs/sha256"}}, "artifact": {"type": "object", "additionalProperties": false, "required": ["logical_path", "records", "sha256"], "properties": {"logical_path": {"type": "string", "minLength": 1}, "records": {"$ref": "#/$defs/count"}, "sha256": {"$ref": "#/$defs/sha256"}}}, "artifactMap": {"type": "object", "minProperties": 1, "propertyNames": {"minLength": 1}, "additionalProperties": {"$ref": "#/$defs/artifact"}}, "categoryGate": {"type": "object", "additionalProperties": false, "required": ["state", "research_only", "correction_release_allowed", "positive", "acceptable_control", "protected", "protected_false_corrections", "control_false_corrections", "false_corrections", "threshold_config_sha256", "reasons"], "properties": {"state": {"enum": ["passed", "research_only"]}, "research_only": {"type": "boolean"}, "correction_release_allowed": {"type": "boolean"}, "positive": {"$ref": "#/$defs/count"}, "acceptable_control": {"$ref": "#/$defs/count"}, "protected": {"$ref": "#/$defs/count"}, "protected_false_corrections": {"$ref": "#/$defs/count"}, "control_false_corrections": {"$ref": "#/$defs/count"}, "false_corrections": {"$ref": "#/$defs/count"}, "threshold_config_sha256": {"$ref": "#/$defs/sha256"}, "reasons": {"type": "array", "items": {"type": "string", "minLength": 1}}}, "allOf": [{"if": {"properties": {"state": {"const": "research_only"}}}, "then": {"properties": {"research_only": {"const": true}, "correction_release_allowed": {"const": false}}}, "else": {"properties": {"research_only": {"const": false}}}}]}}
}
