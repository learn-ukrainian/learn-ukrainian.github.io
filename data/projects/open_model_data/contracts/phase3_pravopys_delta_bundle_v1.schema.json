{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learn-ukrainian.github.io/schemas/open-model-data/phase3_pravopys_delta_bundle_v1.schema.json",
  "title": "Text-free Phase 3 Pravopys delta bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "text_free", "source_freeze", "units_2019", "units_2026", "candidate_alignment", "delta_ledger", "population_freeze", "auditor_seed", "audit_sample", "audit_results"],
  "properties": {
    "schema_version": {"const": "phase3_pravopys_delta_bundle_v1"},
    "text_free": {"const": true},
    "source_freeze": {"$ref": "#/$defs/source_freeze"},
    "units_2019": {"type": "array", "minItems": 1090, "maxItems": 1090, "items": {"$ref": "#/$defs/unit_2019"}},
    "units_2026": {"type": "array", "minItems": 1466, "maxItems": 1466, "items": {"$ref": "#/$defs/unit_2026"}},
    "candidate_alignment": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/candidate"}},
    "delta_ledger": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/delta"}},
    "population_freeze": {"$ref": "#/$defs/population"},
    "auditor_seed": {"$ref": "#/$defs/seed"},
    "audit_sample": {"$ref": "#/$defs/sample"},
    "audit_results": {"type": "array", "items": {"$ref": "#/$defs/result"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "opaque_id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$"},
    "section_path": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "unit_base": {"type": "object", "additionalProperties": false, "required": ["family_id", "unit_id", "unit_sha256", "normalized_text_sha256", "ordinal", "locator", "duplicate_group_id", "parse_status", "rights", "provenance"], "properties": {"family_id": {"type": "string"}, "unit_id": {"$ref": "#/$defs/opaque_id"}, "unit_sha256": {"$ref": "#/$defs/sha256"}, "normalized_text_sha256": {"$ref": "#/$defs/sha256"}, "ordinal": {"type": "integer", "minimum": 1}, "locator": {"type": "object", "additionalProperties": false, "required": ["kind", "edition_sha256", "page", "line", "end_page", "end_line", "section_path"], "properties": {"kind": {"const": "pdf_numbered_hierarchy"}, "edition_sha256": {"$ref": "#/$defs/sha256"}, "page": {"type": "integer", "minimum": 1}, "line": {"type": "integer", "minimum": 1}, "end_page": {"type": "integer", "minimum": 1}, "end_line": {"type": "integer", "minimum": 1}, "section_path": {"$ref": "#/$defs/section_path"}}}, "duplicate_group_id": {"$ref": "#/$defs/opaque_id"}, "parse_status": {"const": "numbered_hierarchy_parsed"}, "rights": {"type": "object", "additionalProperties": false, "required": ["source_text_committed", "locator_only_allowed", "rights_limited_disposition"], "properties": {"source_text_committed": {"const": false}, "locator_only_allowed": {"const": true}, "rights_limited_disposition": {"const": "rights_limited_locator_only"}}}, "provenance": {"type": "object", "additionalProperties": false, "required": ["input_sha256", "unit_grain"], "properties": {"input_sha256": {"$ref": "#/$defs/sha256"}, "unit_grain": {"const": "pdf_numbered_hierarchy"}}}}},
    "unit_2019": {"allOf": [{"$ref": "#/$defs/unit_base"}, {"properties": {"family_id": {"const": "pravopys_2019_complete"}, "locator": {"properties": {"edition_sha256": {"const": "9adcb3e7e6b68db62719a4e8b0c34d7b1f4abde2986c694ab77662f2791ad24c"}}}}}]},
    "unit_2026": {"allOf": [{"$ref": "#/$defs/unit_base"}, {"properties": {"family_id": {"const": "pravopys_2026_complete"}, "locator": {"properties": {"edition_sha256": {"const": "e593956bfba6737d991a76fa86970db9c10a5cd7fd8895bae67f2b9a950c3a92"}}}}}]},
    "source_freeze": {"type": "object", "additionalProperties": false, "required": ["receipt_path", "receipt_sha256", "ledger_sha256"], "properties": {"receipt_path": {"const": "data/projects/open_model_data/evidence/source_universe_v1/source-universe-freeze-receipt.json"}, "receipt_sha256": {"const": "39061cc9c76d3cc510497dfb1df19639c07f76eb933599a3930137bf60ee31a0"}, "ledger_sha256": {"type": "object", "additionalProperties": false, "required": ["pravopys_2019_complete", "pravopys_2026_complete"], "properties": {"pravopys_2019_complete": {"const": "fdb02b99bd284813e035687ae64ad41693f9d995b0e1d6666d5b5dfbf1dc9080"}, "pravopys_2026_complete": {"const": "dbf53af0f5f1c70790bad4e8e5943f700ea8f0a5d4b1311723cc1ce0fbb22006"}}}}},
    "candidate": {"type": "object", "additionalProperties": false, "required": ["candidate_id", "candidate_basis", "candidate_kind", "unit_ids_2019", "unit_ids_2026"], "properties": {"candidate_id": {"$ref": "#/$defs/opaque_id"}, "candidate_basis": {"enum": ["normalized_text_sha256_exact", "section_path_exact", "unmatched"]}, "candidate_kind": {"enum": ["candidate_pair", "unmatched_2019", "unmatched_2026"]}, "unit_ids_2019": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/opaque_id"}}, "unit_ids_2026": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/opaque_id"}}}},
    "review": {"type": "object", "additionalProperties": false, "required": ["role_contract_sha256", "seat_id", "role_id", "review_task_id", "reviewer_controller_identity", "review_receipt_locator", "review_receipt_sha256", "evidence_locator", "evidence_sha256", "adjudication_state", "semantic_review"], "properties": {"role_contract_sha256": {"const": "05679fb356fd29fb9a14102a87020b8d06940edd43b3538a05d811bf845260cf"}, "seat_id": {"const": "seat_ukrainian_source_reviewer"}, "role_id": {"const": "ukrainian_source_reviewer"}, "review_task_id": {"const": "review-phase3-recovery-contract-domain-v8"}, "reviewer_controller_identity": {"const": "controller_phase3_ukrainian_reviewer_01"}, "review_receipt_locator": {"type": "string", "pattern": "^immutable://[^\\s]+$"}, "review_receipt_sha256": {"$ref": "#/$defs/sha256"}, "evidence_locator": {"type": "string", "pattern": "^immutable://[^\\s]+$"}, "evidence_sha256": {"$ref": "#/$defs/sha256"}, "adjudication_state": {"const": "externally_reviewed"}, "semantic_review": {"type": "boolean"}}},
    "delta": {"type": "object", "additionalProperties": false, "required": ["delta_id", "delta_disposition", "candidate_ids", "unit_ids_2019", "unit_ids_2026", "edition_section_identity", "ukrainian_review"], "properties": {"delta_id": {"$ref": "#/$defs/opaque_id"}, "delta_disposition": {"enum": ["unchanged", "editorial_technical_only", "illustration_removed_or_changed", "stress_or_formulation_clarified", "new_structural_wrapper_or_alphabet_material", "added_rule_bearing_unit", "removed_rule_bearing_unit", "normative_conflict"]}, "candidate_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/opaque_id"}}, "unit_ids_2019": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/opaque_id"}}, "unit_ids_2026": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/opaque_id"}}, "edition_section_identity": {"type": "string", "minLength": 1}, "ukrainian_review": {"$ref": "#/$defs/review"}}},
    "population": {"type": "object", "additionalProperties": false, "required": ["population_frozen", "delta_total", "population_sha256", "sample_size"], "properties": {"population_frozen": {"const": true}, "delta_total": {"type": "integer", "minimum": 1}, "population_sha256": {"$ref": "#/$defs/sha256"}, "sample_size": {"type": "integer", "minimum": 1}}},
    "seed": {"type": "object", "additionalProperties": false, "required": ["population_sha256", "seed_owner_role_id", "auditor_attests_only", "author_or_root_choices", "reroll_count", "audit_id", "family_id", "first_containing_origin_main_squash_merge_sha", "universe_sha256"], "properties": {"population_sha256": {"$ref": "#/$defs/sha256"}, "seed_owner_role_id": {"const": "disposition_auditor"}, "auditor_attests_only": {"const": true}, "author_or_root_choices": {"const": false}, "reroll_count": {"const": 0}, "audit_id": {"const": "pravopys_delta"}, "family_id": {"const": "pravopys_2019_2026_delta"}, "first_containing_origin_main_squash_merge_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"}, "universe_sha256": {"$ref": "#/$defs/sha256"}}},
    "sample": {"type": "object", "additionalProperties": false, "required": ["population_sha256", "sample_size", "sample_delta_ids", "stratum_allocation"], "properties": {"population_sha256": {"$ref": "#/$defs/sha256"}, "sample_size": {"type": "integer", "minimum": 1}, "sample_delta_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/opaque_id"}}, "stratum_allocation": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["delta_disposition", "edition_section_identity", "sample_count"], "properties": {"delta_disposition": {"type": "string"}, "edition_section_identity": {"type": "string"}, "sample_count": {"type": "integer", "minimum": 0}}}}}},
    "result": {"type": "object", "additionalProperties": false, "required": ["delta_id", "decision", "repair_applied"], "properties": {"delta_id": {"$ref": "#/$defs/opaque_id"}, "decision": {"enum": ["agree", "disagree_wrong_delta_disposition", "disagree_missed_normative_conflict", "insufficient_locator_evidence"]}, "repair_applied": {"type": "boolean"}}}
  }
}
