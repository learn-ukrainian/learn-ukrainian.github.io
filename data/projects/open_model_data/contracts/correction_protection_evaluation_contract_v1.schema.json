    "gate": {"type": "object", "additionalProperties": false, "required": ["positive_per_phenomenon", "acceptable_control_per_phenomenon", "protected_per_phenomenon", "distinct_documents_per_stratum", "precision_minimum", "recall_minimum", "protected_destructive_changes_maximum", "control_false_corrections_maximum", "metrics", "pooling_forbidden"], "properties": {"positive_per_phenomenon": {"const": 30}, "acceptable_control_per_phenomenon": {"const": 30}, "protected_per_phenomenon": {"const": 30}, "distinct_documents_per_stratum": {"const": 3}, "precision_minimum": {"const": 0.98}, "recall_minimum": {"const": 0.8}, "protected_destructive_changes_maximum": {"const": 0}, "control_false_corrections_maximum": {"const": 0}, "metrics": {"const": ["tp", "fp", "fn", "tn", "precision", "recall", "coverage", "abstention", "disagreement", "protected_false_correction_rate", "acceptable_control_false_correction_rate"]}, "pooling_forbidden": {"const": true}}},
