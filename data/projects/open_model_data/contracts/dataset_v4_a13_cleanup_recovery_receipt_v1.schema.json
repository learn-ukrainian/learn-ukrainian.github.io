            "schema_version": {"const": "dataset_v4_a9_evaluation_package_receipt_v1"}
          }
        },
        "a10_pilot_review_gate": {
          "allOf": [{"$ref": "#/$defs/artifact_binding"}],
          "properties": {
            "path": {"const": "data/projects/open_model_data/admission/dataset_v4_a10_pilot_review_gate_receipt_v1.json"},
            "schema_version": {"const": "dataset_v4_a10_pilot_review_gate_receipt_v1"}
          }
        },
        "a11_silver_release_gate": {
          "allOf": [{"$ref": "#/$defs/artifact_binding"}],
          "properties": {
            "path": {"const": "data/projects/open_model_data/admission/dataset_v4_a11_silver_release_gate_receipt_v1.json"},
            "schema_version": {"const": "dataset_v4_a11_silver_release_gate_receipt_v1"}
          }
        },
        "a12_gold_overlay_gate": {
          "allOf": [{"$ref": "#/$defs/artifact_binding"}],
