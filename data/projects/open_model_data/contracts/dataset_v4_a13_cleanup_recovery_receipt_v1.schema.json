    "role_map": {
      "type": "object",
      "additionalProperties": false,
      "required": ["A0", "A1", "A2", "A3", "A4", "A5", "A6", "A7", "A8", "A9", "A10", "A11", "A12", "A13"],
      "properties": {
        "A0": {"const": "scope_lead"},
        "A1": {"const": "custody"},
        "A2": {"const": "source_inventory_admission"},
        "A3": {"const": "heldout"},
        "A4": {"const": "deterministic_extraction"},
        "A5": {"const": "evidence_enrichment"},
        "A6": {"const": "safe_arena"},
        "A7": {"const": "original_row_factory"},
        "A8": {"const": "admission_assembly"},
        "A9": {"const": "evaluation_package"},
        "A10": {"const": "pilot_review"},
        "A11": {"const": "training_ready_release"},
        "A12": {"const": "later_gold_overlay"},
        "A13": {"const": "cleanup_recovery"}
      }
    },
    "frozen_slot_denominator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total_slots", "strata"],
      "properties": {
        "total_slots": {"const": 100},
        "strata": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["stratum", "id_prefix", "count", "assignment_state", "slot_ids"],
            "properties": {
              "stratum": {"type": "string", "minLength": 1},
              "id_prefix": {"type": "string", "pattern": "^v4p-[a-z-]+$"},
              "count": {"type": "integer", "minimum": 1},
              "assignment_state": {"type": "string", "minLength": 1},
              "slot_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"type": "string", "pattern": "^v4p-[a-z-]+-[0-9]{3}$"}
              }
            }
          }
        }
      }
    },
    "recovery_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state_id", "a12_receipt_valid", "model_agreement_exclusion_confirmed",
        "a2_rights_resolved", "all_slots_assigned", "denominator_stable",
        "epic_closed", "owner_role", "blocked_reason_code"
      ],
      "properties": {
        "state_id": {"const": "v4-a13-cleanup-recovery-v1"},
        "a12_receipt_valid": {"type": "boolean"},
        "model_agreement_exclusion_confirmed": {"type": "boolean"},
        "a2_rights_resolved": {"type": "boolean"},
        "all_slots_assigned": {"type": "boolean"},
        "denominator_stable": {"type": "boolean"},
        "epic_closed": {"const": false},
        "owner_role": {"type": "string", "minLength": 1},
        "blocked_reason_code": {"type": ["string", "null"]}
      }
    },
    "named_residual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["residual_id", "reason_code", "owner_role", "next_action", "retryability"],
      "properties": {
        "residual_id": {"const": "a13-residual-rights-unresolved-and-slots-unassigned"},
        "reason_code": {
          "enum": [
            "rights_unresolved_and_slots_unassigned",
            "rights_unresolved",
            "slot_assignment_pending_a2_a3",
            "resolved_upstream_epic_not_closed",
            "model_agreement_exclusion_engine_drifted",
            "a12_receipt_invalid",
            "frozen_slot_denominator_unstable",
            "required_public_artifact_missing:slot_manifest",
            "required_public_artifact_missing:a2_receipt",
            "required_public_artifact_missing:a12_receipt"
          ]
        },
        "owner_role": {"const": "A2_A3_PRIVATE_ARTIFACT"},
        "next_action": {"type": "string", "minLength": 1},
        "retryability": {"const": "retryable"}
      }
    },
    "cleanup_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id", "approved_temp_output_classes", "forbidden_paths",
        "forbidden_actions", "next_owner_for_named_residual"
      ],
      "properties": {
        "policy_id": {"const": "v4-a13-cleanup-policy-v1"},
        "approved_temp_output_classes": {
          "const": [
            {
              "class_id": "dispatch_worktree_after_merged",
              "description": "A per-dispatch git worktree under .worktrees/dispatch/ may be reaped only after its PR has merged -- never a worktree still holding unmerged, unreviewed, or in-flight work.",
              "condition": "pr_status_is_merged"
            },
            {
              "class_id": "pytest_cache",
              "description": "Ephemeral pytest cache directories (.pytest_cache/, __pycache__/) carry no dataset content and may be reaped at any time.",
              "condition": "always"
            }
          ]
        },
        "forbidden_paths": {
          "const": [
            "data/sources.db",
            "batch_state/open-model-data/v4-a3-heldout/",
            "batch_state/open-model-data/v4-a4-extraction/"
          ]
        },
        "forbidden_actions": {
          "const": [
            "delete_source_evidence",
            "delete_private_a4_jsonl",
            "open_a3_heldout_membership",
            "delete_heldout_membership_to_save_disk",
            "reassign_or_delete_a_frozen_slot_to_close_a_residual"
          ]
        },
        "next_owner_for_named_residual": {"const": "A2_A3_PRIVATE_ARTIFACT"}
      }
    },
    "engine_wiring": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine_schema_version", "engine_input_schema_version", "model_only_bases_blocked", "admission_receipt"],
      "properties": {
        "engine_schema_version": {"const": "v4-original-row-admission-v1"},
        "engine_input_schema_version": {"const": "v4-original-row-admission-input-v1"},
        "model_only_bases_blocked": {"const": ["arena_vote", "model_agreement", "model_vote"]},
        "admission_receipt": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema_version", "visibility", "outcome_sha256", "rows", "counts", "receipt_sha256"],
          "properties": {
            "schema_version": {"const": "v4-original-row-admission-v1"},
            "visibility": {"const": "machine_receipt_text_free"},
            "outcome_sha256": {"const": "78a1edad36f7bab31f77470fcbf95e1542adbcd9ff5701a6c539a2cfdc49ff20"},
            "rows": {"const": []},
            "counts": {"const": {"input_rows": 0, "admitted_rows": 0, "rejected_rows": 0}},
            "receipt_sha256": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    },
    "a2_residuals_carried_forward": {
      "type": "array",
