{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learn-ukrainian.github.io/schemas/open-model-data/phase3_p2_canonical_contracts_v1.schema.json",
  "title": "Phase 3 P2 canonical metadata contracts v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "text_free", "status", "controlling_outcome_sha256", "p1_binding", "rule_slot_universe", "evidence_contract", "case_state_contract", "proposal_contract", "fail_closed_invariants", "generator"],
  "properties": {
    "schema_version": {"const": "phase3_p2_canonical_contracts_v1"},
    "text_free": {"const": true},
    "status": {"const": "FROZEN_METADATA_ONLY"},
    "controlling_outcome_sha256": {"$ref": "#/$defs/sha256"},
    "p1_binding": {"$ref": "#/$defs/p1_binding"},
    "rule_slot_universe": {"$ref": "#/$defs/rule_slot_universe"},
    "evidence_contract": {"$ref": "#/$defs/evidence_contract"},
    "case_state_contract": {"$ref": "#/$defs/case_state_contract"},
    "proposal_contract": {"$ref": "#/$defs/proposal_contract"},
    "fail_closed_invariants": {"$ref": "#/$defs/fail_closed"},
    "generator": {"$ref": "#/$defs/artifact"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "p1_binding": {"type": "object", "additionalProperties": false, "required": ["p1_manifest", "source_unit_count", "unknown_rights_blocker_count", "required_cell_count", "required_cell_statuses"], "properties": {"p1_manifest": {"$ref": "#/$defs/artifact"}, "source_unit_count": {"const": 57}, "unknown_rights_blocker_count": {"const": 39}, "required_cell_count": {"const": 15}, "required_cell_statuses": {"type": "array", "minItems": 15, "maxItems": 15, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["cell_id", "status"], "properties": {"cell_id": {"type": "string", "minLength": 1}, "status": {"enum": ["coverage_blocked", "not_applicable_with_evidence"]}}}}}},
    "rule_slot_universe": {"type": "object", "additionalProperties": false, "required": ["symbol", "algorithm", "slot_count", "slots", "merge_criteria", "split_criteria", "substantive_rule_claims"], "properties": {"symbol": {"const": "R"}, "algorithm": {"type": "object", "additionalProperties": false, "required": ["algorithm_version", "derivation", "input_p1_manifest_sha256", "algorithm_sha256"], "properties": {"algorithm_version": {"const": "phase3_p2_atomic_rule_slot_derivation_v1"}, "derivation": {"type": "string", "minLength": 1}, "input_p1_manifest_sha256": {"$ref": "#/$defs/sha256"}, "algorithm_sha256": {"$ref": "#/$defs/sha256"}}}, "slot_count": {"const": 15}, "slots": {"type": "array", "minItems": 15, "maxItems": 15, "uniqueItems": true, "items": {"$ref": "#/$defs/slot"}}, "merge_criteria": {"type": "string", "minLength": 1}, "split_criteria": {"type": "string", "minLength": 1}, "substantive_rule_claims": {"const": "not_frozen"}}},
    "slot": {"type": "object", "additionalProperties": false, "required": ["rule_slot_id", "p1_cell_id", "p1_cell_identity_sha256", "required_case_state", "p1_status", "protection_required", "substantive_rule_claim_frozen", "metadata_only"], "properties": {"rule_slot_id": {"type": "string", "pattern": "^p2_rule_slot:[a-f0-9]{64}$"}, "p1_cell_id": {"type": "string", "minLength": 1}, "p1_cell_identity_sha256": {"$ref": "#/$defs/sha256"}, "required_case_state": {"enum": ["correction", "protected_historical_context", "abstention", "not_applicable_with_evidence", "coverage_blocked"]}, "p1_status": {"enum": ["coverage_blocked", "not_applicable_with_evidence"]}, "protection_required": {"type": "boolean"}, "substantive_rule_claim_frozen": {"const": false}, "metadata_only": {"const": true}}},
    "evidence_contract": {"type": "object", "additionalProperties": false, "required": ["claim_typed_roles", "role_assignment", "evidence_body_in_contract", "source_qualified_human_adjudication_required", "adjudication_may_not_be_replaced_by_model_output"], "properties": {"claim_typed_roles": {"type": "array", "minItems": 7, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "role_assignment": {"type": "string", "minLength": 1}, "evidence_body_in_contract": {"const": false}, "source_qualified_human_adjudication_required": {"const": true}, "adjudication_may_not_be_replaced_by_model_output": {"const": true}}},
    "case_state_contract": {"type": "object", "additionalProperties": false, "required": ["structurally_distinct_states", "exactly_one_primary_state_per_case", "coverage_blocked_emits_case", "protected_historical_is_not_modern_correction"], "properties": {"structurally_distinct_states": {"const": ["correct_modern_production", "source_backed_correction", "minimal_contrast", "protected_historical_context", "abstention", "not_applicable_with_evidence", "coverage_blocked"]}, "exactly_one_primary_state_per_case": {"const": true}, "coverage_blocked_emits_case": {"const": false}, "protected_historical_is_not_modern_correction": {"const": true}}},
    "proposal_contract": {"type": "object", "additionalProperties": false, "required": ["model_or_tool_proposals_permitted", "proposal_provenance_required", "proposal_may_promote_to_gold", "proposal_may_replace_human_adjudication", "gold_authorship_by_models"], "properties": {"model_or_tool_proposals_permitted": {"const": true}, "proposal_provenance_required": {"const": true}, "proposal_may_promote_to_gold": {"const": false}, "proposal_may_replace_human_adjudication": {"const": false}, "gold_authorship_by_models": {"const": false}}},
    "fail_closed": {"type": "object", "additionalProperties": false, "required": ["rights_or_provenance_unknown_blocks_admission", "historical_non_erasure", "historical_auto_normalization_forbidden", "unresolved_identity_routes_to_abstention_or_protection", "missing_claim_typed_evidence_blocks_promotion", "provider_calls", "labels_created", "gold_created", "training_performed"], "properties": {"rights_or_provenance_unknown_blocks_admission": {"const": true}, "historical_non_erasure": {"const": true}, "historical_auto_normalization_forbidden": {"const": true}, "unresolved_identity_routes_to_abstention_or_protection": {"const": true}, "missing_claim_typed_evidence_blocks_promotion": {"const": true}, "provider_calls": {"const": false}, "labels_created": {"const": false}, "gold_created": {"const": false}, "training_performed": {"const": false}}}
  }
}
