    "evolution":{"type":"object","additionalProperties":false,"required":["permitted","requires","preserves","version_effect"],"properties":{"permitted":{"const":true},"requires":{"type":"array","minItems":3,"uniqueItems":true,"items":{"type":"string","minLength":1}},"preserves":{"const":["p1_cell_id","case_denominator"]},"version_effect":{"type":"string","minLength":1}}},
    "evidence":{"type":"object","additionalProperties":false,"required":["claim_typed_roles","role_assignment","evidence_body_in_contract","source_qualified_human_adjudication_required","adjudication_may_not_be_replaced_by_model_output","record_schema_ids","validator_functions"],"properties":{"claim_typed_roles":{"type":"array","minItems":7,"uniqueItems":true,"items":{"type":"string","minLength":1}},"role_assignment":{"type":"string","minLength":1},"evidence_body_in_contract":{"const":false},"source_qualified_human_adjudication_required":{"const":true},"adjudication_may_not_be_replaced_by_model_output":{"const":true},"record_schema_ids":{"const":["phase3_p2_case_record_v1","phase3_p2_proposal_record_v1","phase3_p2_promotion_decision_v1"]},"validator_functions":{"const":["validate_contract_integrity","validate_case_record","validate_promotion"]}}},
    "cases":{"type":"object","additionalProperties":false,"required":["structurally_distinct_states","exactly_one_primary_state_per_case","coverage_blocked_emits_case","coverage_blocked_record_kind","protected_historical_is_not_modern_correction"],"properties":{"structurally_distinct_states":{"const":["correct_modern_production","source_backed_correction","minimal_contrast","protected_historical_context","abstention","not_applicable_with_evidence","coverage_blocked"]},"exactly_one_primary_state_per_case":{"const":true},"coverage_blocked_emits_case":{"const":false},"coverage_blocked_record_kind":{"const":"coverage_blocked"},"protected_historical_is_not_modern_correction":{"const":true}}},
    "proposals":{"type":"object","additionalProperties":false,"required":["model_or_tool_proposals_permitted","proposal_provenance_required","proposal_may_promote_to_gold","proposal_may_replace_human_adjudication","gold_authorship_by_models","proposal_fingerprint","current_rule_manifest_allows_promotion"],"properties":{"model_or_tool_proposals_permitted":{"const":true},"proposal_provenance_required":{"const":true},"proposal_may_promote_to_gold":{"const":false},"proposal_may_replace_human_adjudication":{"const":false},"gold_authorship_by_models":{"const":false},"proposal_fingerprint":{"const":"sha256_canonical_metadata_without_proposal_sha256"},"current_rule_manifest_allows_promotion":{"const":false}}},
    "invariants":{"type":"object","additionalProperties":false,"required":["rights_or_provenance_unknown_blocks_admission","historical_non_erasure","historical_auto_normalization_forbidden","historical_protection_invariants","unresolved_identity_routes_to_abstention_or_protection","missing_claim_typed_evidence_blocks_promotion","provider_calls","labels_created","gold_created","training_performed"],"properties":{"rights_or_provenance_unknown_blocks_admission":{"const":true},"historical_non_erasure":{"type":"string","minLength":1},"historical_auto_normalization_forbidden":{"type":"string","minLength":1},"historical_protection_invariants":{"type":"object","additionalProperties":false,"required":["historical_forms_protected","modern_correction_eligible","old_east_slavic_is_modern_russian","historical_ruskyi_auto_mapped_to_modern_russian","automatic_mapping_to_modern_national_successor","recension_and_editorial_layer_required"],"properties":{"historical_forms_protected":{"const":true},"modern_correction_eligible":{"const":false},"old_east_slavic_is_modern_russian":{"const":false},"historical_ruskyi_auto_mapped_to_modern_russian":{"const":false},"automatic_mapping_to_modern_national_successor":{"const":false},"recension_and_editorial_layer_required":{"const":true}}},"unresolved_identity_routes_to_abstention_or_protection":{"const":true},"missing_claim_typed_evidence_blocks_promotion":{"const":true},"provider_calls":{"const":false},"labels_created":{"const":false},"gold_created":{"const":false},"training_performed":{"const":false}}},
    "case_record":{"oneOf":[{"type":"object","additionalProperties":false,"required":["record_kind","coverage_stratum_id","blocker_code"],"properties":{"record_kind":{"const":"coverage_blocked"},"coverage_stratum_id":{"type":"string"},"blocker_code":{"type":"string"}}},{"type":"object","additionalProperties":false,"required":["record_kind","record_id","coverage_stratum_id","evidence_refs","authority"],"properties":{"record_kind":{"enum":["correct_modern_production","source_backed_correction","minimal_contrast","protected_historical_context","abstention","not_applicable_with_evidence"]},"record_id":{"type":"string"},"coverage_stratum_id":{"type":"string"},"evidence_refs":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/evidence_ref"}},"authority":{"$ref":"#/$defs/authority"}}}]},
    "evidence_ref":{"type":"object","additionalProperties":false,"required":["evidence_ref_id","claim_role","source_unit_id","source_unit_identity_sha256","source_artifact_sha256","provenance_sha256"],"properties":{"evidence_ref_id":{"type":"string"},"claim_role":{"type":"string"},"source_unit_id":{"type":"string"},"source_unit_identity_sha256":{"$ref":"#/$defs/sha"},"source_artifact_sha256":{"$ref":"#/$defs/sha"},"provenance_sha256":{"$ref":"#/$defs/sha"}}},
