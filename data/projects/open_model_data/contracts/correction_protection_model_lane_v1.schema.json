{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learn-ukrainian.github.io/schemas/open-model-data/correction_protection_model_lane_v1.schema.json",
  "title": "Attributed non-gold model proposal and dissent lane v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "prompt_sha256", "lanes", "claim_boundary"],
  "properties": {
    "schema_version": {"const": "correction_protection_model_lane_v1"},
    "prompt_sha256": {"$ref": "#/$defs/sha256"},
    "lanes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/lane"}},
    "claim_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["human_gold", "human_reviewed", "authoritative", "consensus_authoritative"],
      "properties": {
        "human_gold": {"const": false},
        "human_reviewed": {"const": false},
        "authoritative": {"const": false},
        "consensus_authoritative": {"const": false}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_key", "proposal", "proposal_sha256", "dissent", "source_keys"],
      "properties": {
        "case_key": {"type": "string", "minLength": 1},
        "proposal": {"type": "string", "minLength": 1},
        "proposal_sha256": {"$ref": "#/$defs/sha256"},
        "dissent": {"type": "string", "minLength": 1},
        "source_keys": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "lane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "family", "harness", "exact_model_id", "task_id", "raw_response_sha256", "parser_status", "gate_strengthening_allowed", "proposals", "limitations"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "family": {"type": "string", "minLength": 1},
        "harness": {"type": "string", "minLength": 1},
        "exact_model_id": {"type": "string", "minLength": 1},
        "task_id": {"type": "string", "minLength": 1},
        "raw_response_sha256": {"$ref": "#/$defs/sha256"},
        "parser_status": {"enum": ["passed", "failed"]},
        "gate_strengthening_allowed": {"type": "boolean"},
        "proposals": {"type": "array", "items": {"$ref": "#/$defs/proposal"}},
        "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      },
      "allOf": [
        {"if": {"properties": {"parser_status": {"const": "failed"}}}, "then": {"properties": {"gate_strengthening_allowed": {"const": false}, "proposals": {"maxItems": 0}}}}
      ]
    }
  }
}
