{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learn-ukrainian.github.io/schemas/open-model-data/phase3_rule_author_packet_bundle_v1.schema.json",
  "title": "Phase 3 private rule-author packet bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bundle_id", "clearance", "source_freeze", "evaluation_contract_sha256", "coverage_contract_sha256", "role_contract_sha256", "near_duplicate_policy_fingerprint_sha256", "compiler", "packets"],
  "properties": {
    "schema_version": {"const": "phase3_rule_author_packet_bundle_v1"},
    "bundle_id": {"type": "string", "pattern": "^rule_author_bundle:[a-f0-9]{64}$"},
    "clearance": {"type": "object", "additionalProperties": false, "required": ["receipt_sha256", "file_sha256"], "properties": {"receipt_sha256": {"$ref": "#/$defs/sha256"}, "file_sha256": {"$ref": "#/$defs/sha256"}}},
    "source_freeze": {"type": "object", "additionalProperties": false, "required": ["receipt_sha256", "merged_main_sha"], "properties": {"receipt_sha256": {"$ref": "#/$defs/sha256"}, "merged_main_sha": {"$ref": "#/$defs/gitSha"}}},
    "evaluation_contract_sha256": {"$ref": "#/$defs/sha256"},
    "coverage_contract_sha256": {"$ref": "#/$defs/sha256"},
    "role_contract_sha256": {"$ref": "#/$defs/sha256"},
    "near_duplicate_policy_fingerprint_sha256": {"$ref": "#/$defs/sha256"},
    "compiler": {"$ref": "#/$defs/compiler"},
    "packets": {"type": "array", "items": {"$ref": "#/$defs/packet"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "gitSha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "packetFrozenUnit": {"type": "object", "additionalProperties": false, "required": ["family_id", "unit_id", "unit_sha256"], "properties": {"family_id": {"enum": ["ua_gec", "antonenko_style_guide", "calque_inventory", "school_textbooks"]}, "unit_id": {"type": "string", "minLength": 1}, "unit_sha256": {"$ref": "#/$defs/sha256"}}},
    "compiler": {"type": "object", "additionalProperties": false, "required": ["implementation_version", "script_sha256", "query_plan_sha256", "max_items", "max_utf8_bytes"], "properties": {"implementation_version": {"const": "phase3_rule_author_packet_compiler_v1"}, "script_sha256": {"$ref": "#/$defs/sha256"}, "query_plan_sha256": {"$ref": "#/$defs/sha256"}, "max_items": {"const": 24}, "max_utf8_bytes": {"const": 196608}}},
    "packet": {
      "$id": "https://learn-ukrainian.github.io/schemas/open-model-data/phase3_rule_author_packet_v1.schema.json",
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "packet_id", "ordinal", "clearance_sha256", "near_duplicate_policy_fingerprint_sha256", "query_plan_sha256", "byte_count", "oversize_singleton", "items"],
      "properties": {"schema_version": {"const": "phase3_rule_author_packet_v1"}, "packet_id": {"type": "string", "pattern": "^rule_author_packet:[a-f0-9]{64}$"}, "ordinal": {"type": "integer", "minimum": 1}, "clearance_sha256": {"$ref": "#/$defs/sha256"}, "near_duplicate_policy_fingerprint_sha256": {"$ref": "#/$defs/sha256"}, "query_plan_sha256": {"$ref": "#/$defs/sha256"}, "byte_count": {"type": "integer", "minimum": 1}, "oversize_singleton": {"type": "boolean"}, "items": {"type": "array", "minItems": 1, "maxItems": 24, "items": {"$ref": "#/$defs/sourceItem"}}}
    },
    "sourceItem": {
      "$id": "https://learn-ukrainian.github.io/schemas/open-model-data/phase3_rule_author_source_item_v1.schema.json",
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "source_item_id", "family_id", "frozen_unit", "source_document_identity", "locator", "source_span", "source_sha256", "source_text", "corrected_text", "metadata", "candidate_signals", "clearance_sha256", "near_duplicate_policy_fingerprint_sha256"],
      "properties": {"schema_version": {"const": "phase3_rule_author_source_item_v1"}, "source_item_id": {"type": "string", "pattern": "^rule_author_source:[a-f0-9]{64}$"}, "family_id": {"enum": ["ua_gec", "antonenko_style_guide", "calque_inventory", "school_textbooks"]}, "frozen_unit": {"$ref": "#/$defs/packetFrozenUnit"}, "source_document_identity": {"type": "string", "pattern": "^[a-z_]+:[a-f0-9]{64}$"}, "locator": {"type": "object", "additionalProperties": false, "required": ["kind", "opaque_locator_sha256"], "properties": {"kind": {"type": "string", "minLength": 1}, "opaque_locator_sha256": {"$ref": "#/$defs/sha256"}}}, "source_span": {"type": "object", "additionalProperties": false, "required": ["start", "end"], "properties": {"start": {"type": "integer", "minimum": 0}, "end": {"type": "integer", "minimum": 1}}}, "source_sha256": {"$ref": "#/$defs/sha256"}, "source_text": {"type": "string", "minLength": 1}, "corrected_text": {"type": "string"}, "metadata": {"type": "object", "additionalProperties": false, "required": ["annotation_layer", "partition", "annotator_identity_sha256", "is_native", "source_lang"], "properties": {"annotation_layer": {"type": "string", "minLength": 1}, "partition": {"type": "string", "minLength": 1}, "annotator_identity_sha256": {"$ref": "#/$defs/sha256"}, "is_native": {"type": "integer"}, "source_lang": {"type": "string", "minLength": 1}}}, "candidate_signals": {"type": "array", "items": {"type": "string", "minLength": 1}}, "clearance_sha256": {"$ref": "#/$defs/sha256"}, "near_duplicate_policy_fingerprint_sha256": {"$ref": "#/$defs/sha256"}}
    },
    "ruleAuthorResponse": {
      "$id": "https://learn-ukrainian.github.io/schemas/open-model-data/phase3_rule_author_response_v1.schema.json",
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "authority_state", "author", "packet_sha256", "prompt_sha256", "raw_response_sha256", "parse_state", "limitations", "proposals", "abstentions"],
      "properties": {"schema_version": {"const": "phase3_rule_author_response_v1"}, "authority_state": {"const": "non_authoritative_model_proposal"}, "author": {"$ref": "#/$defs/authorRun"}, "packet_sha256": {"$ref": "#/$defs/sha256"}, "prompt_sha256": {"$ref": "#/$defs/sha256"}, "raw_response_sha256": {"$ref": "#/$defs/sha256"}, "parse_state": {"enum": ["parsed", "partial", "unparsed"]}, "limitations": {"type": "array", "items": {"type": "string"}}, "proposals": {"type": "array", "items": {"$ref": "#/$defs/proposal"}}, "abstentions": {"type": "array", "items": {"type": "string"}}}
    },
    "authorRun": {"type": "object", "additionalProperties": false, "required": ["role_id", "controller_identity_id", "provider", "model_family", "harness", "exact_model", "task_id"], "properties": {"role_id": {"const": "rule_author_extractor"}, "controller_identity_id": {"type": "string", "pattern": "^controller_[a-z0-9_]+$"}, "provider": {"type": "string", "minLength": 1}, "model_family": {"type": "string", "minLength": 1}, "harness": {"type": "string", "minLength": 1}, "exact_model": {"type": "string", "minLength": 1}, "task_id": {"type": "string", "minLength": 1}}},
    "proposal": {"type": "object", "additionalProperties": false, "required": ["proposal_id", "source_item_id", "source_span", "primary_source_role", "secondary_source_roles", "claim_type", "phenomenon", "mechanism", "matcher", "incorrect_pattern", "replacements", "scope", "exceptions", "controls", "protections", "abstentions", "evidence_refs", "consumer_views", "dissent_or_alternatives"], "properties": {"proposal_id": {"type": "string", "minLength": 1}, "source_item_id": {"type": "string", "pattern": "^rule_author_source:[a-f0-9]{64}$"}, "source_span": {"$ref": "#/$defs/span"}, "primary_source_role": {"type": "string", "minLength": 1}, "secondary_source_roles": {"type": "array", "items": {"type": "string"}}, "claim_type": {"type": "string", "minLength": 1}, "phenomenon": {"type": "string", "minLength": 1}, "mechanism": {"enum": ["literal", "lemma_morphology", "phrase_collocation", "government_valency", "syntax", "semantic_contextual", "orthography", "punctuation"]}, "matcher": {"$ref": "#/$defs/matcher"}, "incorrect_pattern": {"type": "string", "minLength": 1}, "replacements": {"type": "array", "items": {"type": "string"}}, "scope": {"type": "string", "minLength": 1}, "exceptions": {"type": "array", "items": {"type": "string"}}, "controls": {"type": "array", "items": {"type": "string"}}, "protections": {"type": "array", "items": {"type": "string"}}, "abstentions": {"type": "array", "items": {"type": "string"}}, "evidence_refs": {"type": "array", "items": {"type": "string"}}, "consumer_views": {"type": "array", "items": {"type": "string"}}, "dissent_or_alternatives": {"type": "array", "items": {"type": "string"}}}},
    "span": {"type": "object", "additionalProperties": false, "required": ["start", "end"], "properties": {"start": {"type": "integer", "minimum": 0}, "end": {"type": "integer", "minimum": 1}}},
    "matcher": {"oneOf": [{"$ref": "#/$defs/literalMatcher"}, {"$ref": "#/$defs/structuredMatcher"}]},
    "literalMatcher": {"type": "object", "additionalProperties": false, "required": ["kind", "pattern", "abstention"], "properties": {"kind": {"enum": ["literal", "phrase_collocation", "semantic_contextual", "orthography", "punctuation"]}, "pattern": {"type": "string", "minLength": 1}, "abstention": {"type": "array", "minItems": 1, "items": {"type": "string"}}}},
    "structuredMatcher": {"type": "object", "additionalProperties": false, "required": ["kind", "tokens", "dependency_constraints", "abstention"], "properties": {"kind": {"enum": ["lemma_morphology", "government_valency", "syntax"]}, "tokens": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["pos", "features"], "properties": {"lemma": {"type": "string"}, "pos": {"type": "string", "minLength": 1}, "features": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}}}}}, "dependency_constraints": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["head", "dependent", "relation"], "properties": {"head": {"type": "integer", "minimum": 0}, "dependent": {"type": "integer", "minimum": 0}, "relation": {"type": "string", "minLength": 1}}}}, "abstention": {"type": "array", "minItems": 1, "items": {"type": "string"}}}},
    "reviewDecision": {"$id": "https://learn-ukrainian.github.io/schemas/open-model-data/phase3_ukrainian_rule_review_decision_v1.schema.json", "type": "object", "additionalProperties": false, "required": ["schema_version", "reviewer", "reviewed_payload_sha256", "canonical_reviewed_payload_sha256", "decision", "proposal_decisions", "reasons"], "properties": {"schema_version": {"const": "phase3_ukrainian_rule_review_decision_v1"}, "reviewer": {"$ref": "#/$defs/reviewer"}, "reviewed_payload_sha256": {"$ref": "#/$defs/sha256"}, "canonical_reviewed_payload_sha256": {"$ref": "#/$defs/sha256"}, "decision": {"enum": ["accepted", "rejected", "revise"]}, "proposal_decisions": {"type": "array", "items": {"$ref": "#/$defs/proposalReviewDecision"}}, "reasons": {"type": "array", "minItems": 1, "items": {"type": "string"}}}},
    "proposalReviewDecision": {"type": "object", "additionalProperties": false, "required": ["proposal_id", "decision", "source_role_decision", "claim_type_decision", "phenomenon_decision", "mechanism_decision", "support_decision", "locator_decision", "reasons"], "properties": {"proposal_id": {"type": "string", "minLength": 1}, "decision": {"enum": ["accepted", "rejected", "revise"]}, "source_role_decision": {"type": "object", "additionalProperties": false, "required": ["primary", "secondary"], "properties": {"primary": {"type": "string", "minLength": 1}, "secondary": {"type": "array", "items": {"type": "string"}}}}, "claim_type_decision": {"type": "string", "minLength": 1}, "phenomenon_decision": {"type": "string", "minLength": 1}, "mechanism_decision": {"enum": ["literal", "lemma_morphology", "phrase_collocation", "government_valency", "syntax", "semantic_contextual", "orthography", "punctuation"]}, "support_decision": {"enum": ["source_supported", "insufficient_support", "conflicting_support", "unresolved"]}, "locator_decision": {"enum": ["exact_sufficient", "insufficient", "mismatch"]}, "canonical_reviewed_rule": {"$ref": "#/$defs/proposal"}, "canonical_reviewed_rule_sha256": {"$ref": "#/$defs/sha256"}, "reasons": {"type": "array", "minItems": 1, "items": {"type": "string"}}}, "allOf": [{"if": {"properties": {"decision": {"enum": ["accepted", "revise"]}}, "required": ["decision"]}, "then": {"required": ["canonical_reviewed_rule", "canonical_reviewed_rule_sha256"]}, "else": {"not": {"anyOf": [{"required": ["canonical_reviewed_rule"]}, {"required": ["canonical_reviewed_rule_sha256"]}]}}}]},
    "reviewer": {"type": "object", "additionalProperties": false, "required": ["role_id", "controller_identity_id", "task_id"], "properties": {"role_id": {"const": "ukrainian_source_reviewer"}, "controller_identity_id": {"type": "string", "pattern": "^controller_[a-z0-9_]+$"}, "task_id": {"type": "string", "minLength": 1}}}
  }
}
