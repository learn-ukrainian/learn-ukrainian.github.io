{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learn-ukrainian.github.io/contracts/phase3_historical_document_chronology_receipt_v2.schema.json",
  "title": "Phase 3 historical document chronology receipt v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "text_free",
    "status",
    "supersedes",
    "bindings",
    "denominators",
    "output",
    "coverage",
    "safeguards",
    "phase_boundaries",
    "receipt_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "phase3_historical_document_chronology_receipt_v2"
    },
    "text_free": {"const": true},
    "status": {"const": "DOCUMENT_SOURCE_DATES_PROJECTED_NO_UNDATED_DOCUMENTS"},
    "supersedes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v1_output_sha256",
        "v1_receipt_file_sha256",
        "v1_receipt_sha256",
        "reason"
      ],
      "properties": {
        "v1_output_sha256": {"$ref": "#/$defs/sha256"},
        "v1_receipt_file_sha256": {"$ref": "#/$defs/sha256"},
        "v1_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "reason": {"const": "v1_parser_omitted_explicit_ud_date_comments"}
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chronology_v1_implementation_sha256",
        "historical_periodization_freeze_file_sha256",
        "ud_file_sha256",
        "plug2_metadata_sha256",
        "ratushna_official_catalogue_sha256",
        "ratushna_official_pdf_sha256"
      ],
      "properties": {
        "chronology_v1_implementation_sha256": {"$ref": "#/$defs/sha256"},
        "historical_periodization_freeze_file_sha256": {"$ref": "#/$defs/sha256"},
        "ud_file_sha256": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/sha256"},
          "minProperties": 3
        },
        "plug2_metadata_sha256": {"$ref": "#/$defs/sha256"},
        "ratushna_official_catalogue_sha256": {"$ref": "#/$defs/sha256"},
        "ratushna_official_pdf_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "denominators": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ud", "plug2", "total_documents", "total_exact_year", "total_bounded_interval"],
      "properties": {
        "ud": {"$ref": "#/$defs/dateDenominator"},
        "plug2": {"$ref": "#/$defs/dateDenominator"},
        "total_documents": {"type": "integer", "minimum": 1},
        "total_exact_year": {"type": "integer", "minimum": 0},
        "total_bounded_interval": {"type": "integer", "minimum": 0}
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "records", "bytes", "sha256", "record_identity_sha256"],
      "properties": {
        "filename": {"const": "historical-document-chronology-v2.jsonl.gz"},
        "records": {"type": "integer", "minimum": 1},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "record_identity_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_document_denominator_equal",
        "source_date_present_for_every_document",
        "undated_documents",
        "bounded_intervals_preserved",
        "all_intervals_stable_within_each_framework",
        "qualified_historical_semantic_review_complete"
      ],
      "properties": {
        "source_document_denominator_equal": {"const": true},
        "source_date_present_for_every_document": {"const": true},
        "undated_documents": {"const": 0},
        "bounded_intervals_preserved": {"const": true},
        "all_intervals_stable_within_each_framework": {"const": true},
        "qualified_historical_semantic_review_complete": {"const": false}
      }
    },
    "safeguards": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chronology_is_not_linguistic_stage_gold",
        "frameworks_preserved_without_collapse",
        "no_title_or_filename_date_inference",
        "historical_forms_protected",
        "modern_correction_eligible",
        "provider_calls"
      ],
      "properties": {
        "chronology_is_not_linguistic_stage_gold": {"const": true},
        "frameworks_preserved_without_collapse": {"const": true},
        "no_title_or_filename_date_inference": {"const": true},
        "historical_forms_protected": {"const": true},
        "modern_correction_eligible": {"const": false},
        "provider_calls": {"const": false}
      }
    },
    "phase_boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_freeze_ready", "source_coverage_ready", "phase3_complete", "phase4_blocked"],
      "properties": {
        "source_freeze_ready": {"const": false},
        "source_coverage_ready": {"const": false},
        "phase3_complete": {"const": false},
        "phase4_blocked": {"const": true}
      }
    },
    "receipt_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "dateDenominator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eligible_documents", "exact_year_documents", "bounded_interval_documents", "undated_documents"],
      "properties": {
        "eligible_documents": {"type": "integer", "minimum": 1},
        "exact_year_documents": {"type": "integer", "minimum": 0},
        "bounded_interval_documents": {"type": "integer", "minimum": 0},
        "undated_documents": {"const": 0}
      }
    }
  }
}
