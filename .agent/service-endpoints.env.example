# Copy to .agent/service-endpoints.env (gitignored) and set MONITOR_INSTANCE_ID
# when multiple loopback hosts are reachable through SSH tunnels.
# All URLs are loopback-only; expose via SSH tunnel from your workstation.

MONITOR_INSTANCE_ID=
MONITOR_API_URL=http://127.0.0.1:8765
MONITOR_HEALTH_URL=http://127.0.0.1:8765/api/health
SOURCES_MCP_URL=http://127.0.0.1:8766/mcp
SOURCES_HEALTH_URL=http://127.0.0.1:8766/health
WORK_PROJECTION_URL=http://127.0.0.1:8769/v1/projection
ASTRO_DEV_URL=http://127.0.0.1:4321/
