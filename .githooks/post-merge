#!/usr/bin/env bash
set -euo pipefail

source "$(dirname "$0")/_lib.sh"

lfs_status=0
if command -v git-lfs >/dev/null 2>&1; then
  git lfs post-merge "$@" || lfs_status=$?
else
  echo "Git hook error: this repository uses Git LFS, but git-lfs is not installed." >&2
  lfs_status=2
fi

# The guard is the installed lu-machinery release; it protects the product checkout it is given,
# here the primary one unless the caller already selected a product checkout.
guard_status=0
LU_PRODUCT_ROOT="${LU_PRODUCT_ROOT:-$main_root}" run_project_python -P -m lu_machinery.guardrails.primary_write_guard apply --hook || guard_status=$?
if [[ "$guard_status" -ne 0 ]]; then
  exit "$guard_status"
fi
exit "$lfs_status"
