#!/usr/bin/env bash
set -euo pipefail

source "$(dirname "$0")/_lib.sh"

tmp_root="${TMPDIR:-/tmp}"
if [[ "$tmp_root" != /* ]]; then
  tmp_root="/tmp"
fi
updates_file="$(mktemp "$tmp_root/learn-uk-pre-push.XXXXXX")"
trap 'rm -f "$updates_file"' EXIT
tee "$updates_file" >/dev/null

run_project_python "$hook_dir/check-pytest-stamp.py" "$@" <"$updates_file"
# The gate runs the pre-commit pre-push stage over the explicit outgoing range,
# with the per-commit OPSEC and internal-ID scans (#10033). It runs no tests of
# its own (#11276): CI runs the full suite and remains the merge gate.
run_project_python "$hook_dir/pre_push_gate.py" \
  --launcher "$project_python" --config "$source_root/.pre-commit-config.yaml" "$@" <"$updates_file"
require_git_lfs
git lfs pre-push "$@" <"$updates_file"
