{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learn-ukrainian.github.io/schemas/word-card-identity-registry-v1.schema.json",
  "title": "Word-card identity registry v1 (#8978 / #8334)",
  "description": "Frozen build input I (schema.md §5, §13): every card, sense and source-record id ever minted, its matching evidence at creation, and the lineage events (mint, split, merge, retire, source_record_mint). Allocation is a separate committed step (`allocate`); assembly (`build`) reads this registry, never writes it, and fails on any id it does not allocate; ids are never reused.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_version",
    "entries",
    "source_records",
    "events"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "registry_version": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonic; bumped by every committed allocation step."
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "source_records": {
      "type": "array",
      "description": "Persistent source-record identities (schema.md §12.1): the identity is the minted `sr_` id; the keys used to find the record again in a new snapshot are aliases with a kind and the snapshot they were observed in (every historical key is kept: a corrected header appends an alias); correspondence per snapshot is unique, an explicit ambiguous hold, a held decision (conflicting evidence, or a row that only the register position singles out), or missing.",
      "items": {
        "$ref": "#/$defs/source_record"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    }
  },
  "$defs": {
    "card_id": {
      "type": "string",
      "pattern": "^wc_[0-9a-hjkmnp-tv-z]{12}$"
    },
    "sense_id": {
      "type": "string",
      "pattern": "^ws_[0-9a-hjkmnp-tv-z]{12}$"
    },
    "assertion_id": {
      "type": "string",
      "pattern": "^wa_[0-9a-f]{24}$"
    },
    "source_record_id": {
      "type": "string",
      "pattern": "^sr_[0-9a-hjkmnp-tv-z]{12}$"
    },
    "source_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_record_id",
        "source_id",
        "aliases",
        "correspondence"
      ],
      "properties": {
        "source_record_id": {
          "$ref": "#/$defs/source_record_id"
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "key",
              "snapshot_id"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "uid",
                  "register_position",
                  "content",
                  "query_headword_label",
                  "vesum_entry_form",
                  "table_row"
                ],
                "description": "Tried from strongest to weakest at correspondence time: the source's own id (ULIF uid, once extracted), the ULIF register position (page:row; unique over all 262,788 checked rows on 2026-09-28), the row content digest (not unique: 257,539 distinct over 262,788), the query#headword#label key (collides in 4,276 groups / 8,814 rows; e.g. ULIF rows 3 and 98008 ключ), the VESUM lemma/pos/lemma-form-tags key, a canonical table-row key."
              },
              "key": {
                "type": "string",
                "minLength": 1
              },
              "snapshot_id": {
                "type": "string",
                "minLength": 1
              },
              "note": {
                "type": "string"
              }
            }
          }
        },
        "correspondence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "snapshot_id",
              "status"
            ],
            "properties": {
              "snapshot_id": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "unique",
                  "ambiguous",
                  "held",
                  "missing"
                ],
                "description": "unique: exactly one row is consistent with every alias kind that hits and a content-side alias (or direct observation in this snapshot) singles it out. ambiguous: several rows are consistent with every hitting kind. held: the hitting kinds point at different rows (conflicting identity evidence), or only the register position singles a row out and its continuity across harvests is unproven (Q-I6). Every hold suppresses every candidate until an overlay identity entry settles it."
              },
              "locator": {
                "type": "string"
              },
              "matched_by": {
                "type": "string"
              },
              "candidates": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "hold": {
                "type": "string"
              },
              "settled_by": {
                "type": "string",
                "description": "overlay identity entry that settled an ambiguous or held correspondence."
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "unique"
                    }
                  }
                },
                "then": {
                  "required": [
                    "locator"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "ambiguous"
                    }
                  }
                },
                "then": {
                  "required": [
                    "candidates",
                    "hold"
                  ],
                  "properties": {
                    "candidates": {
                      "minItems": 2
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "held"
                    }
                  }
                },
                "then": {
                  "required": [
                    "candidates",
                    "hold"
                  ]
                }
              }
            ]
          }
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "card_id",
        "card_kind",
        "state",
        "key_at_creation",
        "created_in_build",
        "senses"
      ],
      "properties": {
        "card_id": {
          "$ref": "#/$defs/card_id"
        },
        "card_kind": {
          "enum": [
            "lexeme",
            "mwe",
            "proper_name"
          ]
        },
        "state": {
          "enum": [
            "active",
            "redirected",
            "split",
            "suppressed",
            "retired"
          ]
        },
        "key_at_creation": {
          "type": "object",
          "description": "Matching evidence, same shape as the card's key_at_creation."
        },
        "created_in_build": {
          "type": "string"
        },
        "senses": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sense_id",
              "order"
            ],
            "properties": {
              "sense_id": {
                "$ref": "#/$defs/sense_id"
              },
              "order": {
                "type": "integer",
                "minimum": 1
              },
              "state": {
                "enum": [
                  "active",
                  "redirected",
                  "suppressed",
                  "unsplit",
                  "retired"
                ]
              },
              "merged_into": {
                "$ref": "#/$defs/sense_id"
              }
            }
          }
        },
        "merged_into": {
          "$ref": "#/$defs/card_id"
        },
        "split_into": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/card_id"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "redirected"
              }
            }
          },
          "then": {
            "required": [
              "merged_into"
            ],
            "not": {
              "required": [
                "split_into"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "split"
              }
            }
          },
          "then": {
            "required": [
              "split_into"
            ],
            "not": {
              "required": [
                "merged_into"
              ]
            }
          }
        }
      ]
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "kind",
        "build_id",
        "evidence"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "^ie_[0-9]{4,}$"
        },
        "kind": {
          "enum": [
            "mint",
            "split",
            "merge",
            "retire",
            "sense_mint",
            "sense_merge",
            "sense_split",
            "source_record_mint"
          ]
        },
        "build_id": {
          "type": "string"
        },
        "overlay_id": {
          "type": "string"
        },
        "cards": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/card_id"
          }
        },
        "from": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "to": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "type": "string"
        }
      }
    }
  }
}
