{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence-words-request-v1.schema.json",
  "type": "object",
  "properties": {
    "request_schema": {
      "const": 1
    },
    "level": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "words": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/word"
      }
    }
  },
  "required": [
    "request_schema",
    "level",
    "words"
  ],
  "additionalProperties": false,
  "$defs": {
    "word": {
      "oneOf": [
        {
          "$ref": "#/$defs/lexical"
        },
        {
          "$ref": "#/$defs/formula"
        }
      ]
    },
    "lexical": {
      "type": "object",
      "properties": {
        "lemma": {
          "type": "string",
          "minLength": 1
        },
        "pos": {
          "type": "string",
          "minLength": 1
        },
        "entry": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "source": {
                  "const": "vesum"
                },
                "entry_id": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "source",
                "entry_id"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "source": {
                  "const": "ulif"
                },
                "homonym_index": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "source",
                "homonym_index"
              ],
              "additionalProperties": false
            }
          ]
        },
        "want": {
          "oneOf": [
            {
              "const": "new"
            },
            {
              "type": "string",
              "pattern": "^W-[0-9]*[1-9][0-9]*$"
            }
          ]
        },
        "note": {
          "type": "string"
        },
        "meaning": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "The lesson's sense as a short English learner gloss (at most 8 words, 60 characters), checked against ULIF/VESUM before it is written. It precedes every other gloss source; an open-dictionary candidate spelled the same is cited, otherwise the meaning itself is the gloss."
        }
      },
      "required": [
        "lemma",
        "pos",
        "want"
      ],
      "additionalProperties": false
    },
    "formula": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "formula"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "parts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "lemma": {
                "type": "string",
                "minLength": 1
              },
              "pos": {
                "type": "string",
                "minLength": 1
              },
              "entry": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "source": {
                        "const": "vesum"
                      },
                      "entry_id": {
                        "type": "integer",
                        "minimum": 1
                      }
                    },
                    "required": [
                      "source",
                      "entry_id"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "source": {
                        "const": "ulif"
                      },
                      "homonym_index": {
                        "type": "integer",
                        "minimum": 1
                      }
                    },
                    "required": [
                      "source",
                      "homonym_index"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "required": [
              "lemma",
              "pos"
            ],
            "additionalProperties": false
          }
        },
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "want": {
          "oneOf": [
            {
              "const": "new"
            },
            {
              "type": "string",
              "pattern": "^W-[0-9]*[1-9][0-9]*$"
            }
          ]
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "text",
        "parts",
        "want"
      ],
      "additionalProperties": false
    }
  }
}
