{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence-sense-bindings-v1.schema.json",
  "type": "object",
  "properties": {
    "bindings_schema": {
      "const": 1
    },
    "matcher": {
      "const": "reference_sense_v1"
    },
    "level": {
      "type": "string",
      "minLength": 1
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "word": {
            "type": "string",
            "pattern": "^W-[0-9]*[1-9][0-9]*$"
          },
          "method": {
            "enum": [
              "a1_reference_meaning.v1",
              "reviewed.v1"
            ]
          },
          "table": {
            "const": "dmklinger_uk_en"
          },
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "row_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "span_index": {
            "type": "integer",
            "minimum": 0
          },
          "span": {
            "type": "string",
            "minLength": 1
          },
          "inventory": {
            "const": "registry/lexicon/source-inventory/ohoiko-oho-a1-reference.yaml"
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "commitment": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "key_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+$"
          },
          "reviewer": {
            "type": "object",
            "properties": {
              "task_id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]+$"
              },
              "model": {
                "type": "string",
                "minLength": 1
              },
              "family": {
                "enum": [
                  "openai",
                  "anthropic",
                  "google"
                ]
              },
              "harness": {
                "type": "string",
                "minLength": 1
              },
              "date": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "candidates_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "result_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "author_model": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "task_id",
              "model",
              "family",
              "harness",
              "date",
              "candidates_sha256",
              "result_sha256",
              "author_model"
            ],
            "additionalProperties": false
          },
          "atom_index": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "word",
          "method",
          "table",
          "id",
          "row_sha256",
          "span_index",
          "span",
          "atom_index"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "method": {
                  "const": "a1_reference_meaning.v1"
                }
              }
            },
            "then": {
              "required": [
                "inventory",
                "locator",
                "commitment",
                "key_id"
              ],
              "not": {
                "required": [
                  "reviewer"
                ]
              }
            },
            "else": {
              "required": [
                "reviewer"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "inventory"
                    ]
                  },
                  {
                    "required": [
                      "locator"
                    ]
                  },
                  {
                    "required": [
                      "commitment"
                    ]
                  },
                  {
                    "required": [
                      "key_id"
                    ]
                  }
                ]
              }
            }
          }
        ]
      }
    }
  },
  "required": [
    "bindings_schema",
    "matcher",
    "level",
    "bindings"
  ],
  "additionalProperties": false
}
