{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence-sense-bindings-v1.schema.json",
  "type": "object",
  "properties": {
    "bindings_schema": {
      "const": 1
    },
    "matcher": {
      "const": "reference_sense_v1"
    },
    "level": {
      "type": "string",
      "minLength": 1
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "word": {
            "type": "string",
            "pattern": "^W-[0-9]*[1-9][0-9]*$"
          },
          "method": {
            "enum": [
              "a1_reference_meaning.v1",
              "reviewed.v1",
              "ohoiko_reference",
              "formula_row.v1"
            ]
          },
          "table": {
            "const": "dmklinger_uk_en"
          },
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "row_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "span_index": {
            "type": "integer",
            "minimum": 0
          },
          "span": {
            "type": "string",
            "minLength": 1,
            "description": "The binding certifies the displayed open-dictionary atom and matching restricting labels. A trailing definition is retained in the source signature but is not compared to the reference meaning. Multi-head references are never accepted under v1 because that signature includes the atom."
          },
          "gloss": {
            "type": "string",
            "minLength": 1,
            "description": "ohoiko_reference only: the English shown to the learner. With match dictionary it is an open-dictionary candidate's displayed gloss; with match book it is the A1 reference dictionary's own short gloss, the only private text a binding may carry."
          },
          "match": {
            "enum": [
              "dictionary",
              "book"
            ]
          },
          "inventory": {
            "const": "registry/lexicon/source-inventory/ohoiko-oho-a1-reference.yaml"
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "commitment": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "key_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+$"
          },
          "reviewer": {
            "type": "object",
            "properties": {
              "task_id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]+$"
              },
              "model": {
                "type": "string",
                "minLength": 1
              },
              "family": {
                "enum": [
                  "openai",
                  "anthropic",
                  "google"
                ]
              },
              "harness": {
                "type": "string",
                "minLength": 1
              },
              "date": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "candidates_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "result_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "author_model": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "task_id",
              "model",
              "family",
              "harness",
              "date",
              "candidates_sha256",
              "result_sha256",
              "author_model"
            ],
            "additionalProperties": false
          },
          "atom_index": {
            "type": "integer",
            "minimum": 0
          },
          "definition_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "candidates_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "word",
          "method"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "method": {
                  "const": "ohoiko_reference"
                }
              }
            },
            "then": {
              "required": [
                "gloss",
                "match",
                "inventory",
                "locator",
                "commitment",
                "key_id"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "table"
                    ]
                  },
                  {
                    "required": [
                      "id"
                    ]
                  },
                  {
                    "required": [
                      "row_sha256"
                    ]
                  },
                  {
                    "required": [
                      "span_index"
                    ]
                  },
                  {
                    "required": [
                      "span"
                    ]
                  },
                  {
                    "required": [
                      "atom_index"
                    ]
                  },
                  {
                    "required": [
                      "reviewer"
                    ]
                  }
                ]
              }
            },
            "else": {
              "required": [
                "table",
                "id",
                "row_sha256",
                "span_index",
                "span",
                "atom_index"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "gloss"
                    ]
                  },
                  {
                    "required": [
                      "match"
                    ]
                  }
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "method": {
                  "const": "a1_reference_meaning.v1"
                }
              }
            },
            "then": {
              "required": [
                "inventory",
                "locator",
                "commitment",
                "key_id"
              ],
              "not": {
                "required": [
                  "reviewer"
                ]
              }
            },
            "else": {
              "if": {
                "properties": {
                  "method": {
                    "const": "reviewed.v1"
                  }
                }
              },
              "then": {
                "required": [
                  "reviewer"
                ],
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "inventory"
                      ]
                    },
                    {
                      "required": [
                        "locator"
                      ]
                    },
                    {
                      "required": [
                        "commitment"
                      ]
                    },
                    {
                      "required": [
                        "key_id"
                      ]
                    }
                  ]
                }
              },
              "else": {
                "not": {
                  "required": [
                    "reviewer"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "method": {
                  "const": "formula_row.v1"
                }
              }
            },
            "then": {
              "required": [
                "definition_sha256",
                "candidates_sha256"
              ]
            },
            "else": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "definition_sha256"
                    ]
                  },
                  {
                    "required": [
                      "candidates_sha256"
                    ]
                  }
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "method": {
                  "const": "formula_row.v1"
                }
              }
            },
            "then": {
              "dependentRequired": {
                "locator": [
                  "inventory",
                  "commitment",
                  "key_id"
                ],
                "inventory": [
                  "locator",
                  "commitment",
                  "key_id"
                ],
                "commitment": [
                  "inventory",
                  "locator",
                  "key_id"
                ],
                "key_id": [
                  "inventory",
                  "locator",
                  "commitment"
                ]
              }
            }
          }
        ]
      }
    }
  },
  "required": [
    "bindings_schema",
    "matcher",
    "level",
    "bindings"
  ],
  "additionalProperties": false
}
