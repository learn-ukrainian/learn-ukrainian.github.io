{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fresh plan review attempt manifest",
  "type": "object", "additionalProperties": false,
  "required": ["manifest_schema", "kind", "level", "slug", "position", "inputs", "learner_state"],
  "properties": {
    "manifest_schema": {"const": 1}, "kind": {"const": "plan"},
    "level": {"type": "string", "minLength": 1}, "slug": {"type": "string", "minLength": 1},
    "position": {"type": "integer", "minimum": 1},
    "inputs": {"type": "object", "additionalProperties": false,
      "required": ["plan", "pack", "pack_lock", "words", "words_lock", "learner_state", "requirements", "arc", "arc_source", "decisions", "scope", "grammar", "validate_report", "pack_verify_report"],
      "properties": {
        "activity_rubric": {"$ref": "#/$defs/file"},
        "activity_rubric_approval": {"$ref": "#/$defs/file"},
        "plan": {"$ref": "#/$defs/file"}, "pack": {"$ref": "#/$defs/file"},
        "pack_lock": {"$ref": "#/$defs/file"}, "words": {"$ref": "#/$defs/file"},
        "words_lock": {"$ref": "#/$defs/file"}, "learner_state": {"$ref": "#/$defs/file"},
        "requirements": {"$ref": "#/$defs/file"}, "arc": {"$ref": "#/$defs/file"},
        "arc_source": {"$ref": "#/$defs/file"},
        "decisions": {"$ref": "#/$defs/file"}, "scope": {"$ref": "#/$defs/file"},
        "grammar": {"$ref": "#/$defs/file"}, "validate_report": {"$ref": "#/$defs/file"},
        "pack_verify_report": {"$ref": "#/$defs/file"},
        "v1_totals": {"$ref": "#/$defs/file",
          "$comment": "The mapped v1 module's activity totals (#9166). Not required: manifests written before it exist and stay valid; the engine always writes it."}
      }
    },
    "learner_state": {"type": "object", "additionalProperties": false,
      "required": ["sha256", "source"],
      "properties": {"sha256": {"$ref": "#/$defs/sha"}, "source": {"const": "planned_state"}}}
  },
  "allOf": [{
    "if": {"properties": {"level": {"pattern": "^a1(?:-|$)"}}, "required": ["level"]},
    "then": {"properties": {"inputs": {"required": ["activity_rubric", "activity_rubric_approval"]}}},
    "else": {"properties": {"inputs": {"not": {"anyOf": [
      {"required": ["activity_rubric"]}, {"required": ["activity_rubric_approval"]}
    ]}}}}
  }],
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha"}}}
  }
}
