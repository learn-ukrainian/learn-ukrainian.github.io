{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learn-ukrainian.github.io/schemas/word-card-suppression-v1.schema.json",
  "title": "Word-card suppression selectors v1 (#8978 / #8980)",
  "description": "Persistent suppression selectors (schema.md §12.1). A selector matches on a source, a durable source-record key or assertion content, never on a local row id or a content-addressed assertion id alone, so it keeps applying across reharvest, re-normalisation, remapping and rollback.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "card_id": {
      "type": "string",
      "pattern": "^wc_[0-9a-hjkmnp-tv-z]{12}$"
    },
    "sense_id": {
      "type": "string",
      "pattern": "^ws_[0-9a-hjkmnp-tv-z]{12}$"
    },
    "assertion_id": {
      "type": "string",
      "pattern": "^wa_[0-9a-f]{24}$"
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "suppression_id",
        "issue",
        "date",
        "selector",
        "scope",
        "applies_to"
      ],
      "properties": {
        "suppression_id": {
          "type": "string",
          "pattern": "^sup-"
        },
        "issue": {
          "type": "string",
          "format": "uri",
          "description": "The GitHub issue that requested removal (operator decision d3)."
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "selector": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "source_id"
              ],
              "properties": {
                "kind": {
                  "const": "source"
                },
                "source_id": {
                  "type": "string"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "source_id",
                "source_record_key"
              ],
              "properties": {
                "kind": {
                  "const": "source_record"
                },
                "source_id": {
                  "type": "string"
                },
                "source_record_key": {
                  "type": "string"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "source_id",
                "field",
                "subject_spelling"
              ],
              "properties": {
                "kind": {
                  "const": "assertion_content"
                },
                "source_id": {
                  "type": "string"
                },
                "field": {
                  "type": "string"
                },
                "subject_spelling": {
                  "type": "string"
                },
                "value_norm": {
                  "type": "string"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "assertion_id",
                "fallback"
              ],
              "properties": {
                "kind": {
                  "const": "assertion_id"
                },
                "assertion_id": {
                  "$ref": "#/$defs/assertion_id"
                },
                "fallback": {
                  "type": "object",
                  "description": "An assertion_content selector applied when the id no longer exists after re-normalisation."
                }
              }
            }
          ]
        },
        "scope": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "site",
              "dataset",
              "internal"
            ]
          }
        },
        "applies_to": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reharvest",
            "rollback"
          ],
          "properties": {
            "reharvest": {
              "const": true
            },
            "rollback": {
              "const": true
            }
          }
        },
        "note": {
          "type": "string"
        }
      }
    }
  }
}
