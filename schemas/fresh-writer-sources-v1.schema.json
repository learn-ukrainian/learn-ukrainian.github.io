{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "lesson",
    "attempt",
    "task_id",
    "writer",
    "model",
    "effort",
    "inputs_sha256",
    "prompt_sha256",
    "draft_sha256",
    "sidecar_sha256",
    "credited_calls"
  ],
  "properties": {
    "contract_version": {
      "const": "fresh-writer-sources.v1"
    },
    "lesson": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module",
        "n"
      ],
      "properties": {
        "module": {
          "type": "string"
        },
        "n": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "writer": {
      "enum": [
        "claude",
        "codex",
        "agy"
      ]
    },
    "model": {
      "type": "string"
    },
    "effort": {
      "type": "string"
    },
    "inputs_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "prompt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "draft_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sidecar_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "credited_calls": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tool",
          "credited_keys",
          "result_sha256"
        ],
        "properties": {
          "tool": {
            "type": "string",
            "pattern": "^mcp__sources__"
          },
          "credited_keys": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "result_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
