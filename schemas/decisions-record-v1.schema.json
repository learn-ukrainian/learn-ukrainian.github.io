{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learn-ukrainian.github.io/schemas/decisions-record-v1.schema.json",
  "title": "Accepted-decisions record (per level)",
  "description": "Verbatim copy of the operator-accepted decision sections that apply to one level (lesson-plans/{level}/_decisions.yaml), generated by scripts/curriculum/arc/generate_decisions.py from the sources named in scripts/curriculum/arc/decision_sources.yaml. Never edited by hand.",
  "type": "object",
  "required": ["schema", "generator", "level", "sources"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": 1},
    "generator": {
      "type": "object",
      "required": ["path", "sha256"],
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "level": {"enum": ["a1", "a2", "b1", "b2"]},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["doc", "heading", "accepted", "accepted_evidence", "doc_sha256", "section_sha256", "text"],
        "additionalProperties": false,
        "properties": {
          "doc": {"type": "string", "minLength": 1},
          "heading": {"type": "string", "pattern": "^#{1,6} \\S"},
          "accepted": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
          "accepted_evidence": {
            "type": "object",
            "required": ["doc", "line"],
            "additionalProperties": false,
            "properties": {
              "doc": {"type": "string", "minLength": 1},
              "line": {"type": "string", "minLength": 1}
            }
          },
          "doc_sha256": {"$ref": "#/$defs/sha256"},
          "section_sha256": {"$ref": "#/$defs/sha256"},
          "text": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
